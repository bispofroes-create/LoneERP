<?xml version="1.0" encoding="utf-8" ?>
<!-- Usuários: lista à esquerda e ficha ao lado (no celular, uma de cada vez). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:seg="clr-namespace:Lone.Cliente.ViewModels.Seguranca;assembly=Lone.Cliente"
             xmlns:dto="clr-namespace:Lone.Contracts.Seguranca;assembly=Lone.Contracts"
             xmlns:col="clr-namespace:Lone.Contracts.Colaboradores;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.UsuariosPage"
             x:DataType="seg:UsuariosViewModel"
             Title="Usuários">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Usuários"
                         Subtitulo="Quem acessa o Lone: login, perfis (por empresa), a pessoa do cadastro ligada ao usuário e a senha inicial."
                         TextoNovo="+  Novo usuário"
                         DicaBusca="Pesquisar por nome ou login"
                         TituloVazio="Nenhum usuário encontrado" />

        <c:FichaCadastro IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Usuários" CaminhoSituacao="">
            <VerticalStackLayout Spacing="8">
                <!-- Dados -->
                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" />
                    <c:Campo Rotulo="Login" Texto="{Binding Formulario.Login}" />
                    <c:Campo Rotulo="E-mail (opcional)" Texto="{Binding Formulario.Email}" Mascara="Email" />
                </c:BlocoCampos>

                <c:CaixaMarcar Texto="Ativo (pode entrar no sistema)" Marcado="{Binding Formulario.Ativo}" Margin="0,8,0,0" />
                <c:CaixaMarcar Texto="Trocar a senha no próximo acesso" Marcado="{Binding Formulario.DeveTrocarSenha}" />

                <!-- Situação do acesso (usuário já cadastrado) -->
                <Border Style="{StaticResource Cartao}" Padding="14" Margin="0,8,0,0" IsVisible="{Binding Formulario.Existente}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Formulario.SituacaoAcesso}" Style="{StaticResource Secundario}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Desbloquear" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding DesbloquearCommand}" IsVisible="{Binding Formulario.Bloqueado}" />
                    </Grid>
                </Border>

                <!-- Pessoa no cadastro (Fase 2a): base de "Minha carteira" e "Minha equipe" -->
                <Label Text="Pessoa no cadastro" Style="{StaticResource Subtitulo}" Margin="0,16,0,0" />
                <Label Text="Quem é este usuário em Pessoas (o colaborador). Define a carteira e a equipe dele. Cada pessoa liga a um só usuário."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding Formulario.TextoPessoa}" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Button Grid.Column="1" Text="Tirar" Style="{StaticResource BotaoLink}" Command="{Binding Formulario.TirarPessoaCommand}"
                            IsVisible="{Binding Formulario.TemPessoa}" ToolTipProperties.Text="Desfaz a ligação (vale ao salvar)" />
                </Grid>
                <c:BlocoCampos>
                    <c:CampoPesquisa Rotulo="Buscar pessoa" Texto="{Binding Formulario.BuscaPessoa}" Dica="Nome, código, CPF ou CNPJ" Comando="{Binding BuscarPessoaCommand}" />
                </c:BlocoCampos>
                <CollectionView ItemsSource="{Binding Formulario.ResultadosPessoa}" SelectionMode="Single"
                                SelectedItem="{Binding Formulario.PessoaEscolhida}" MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="col:PessoaOpcaoDto">
                            <Label Text="{Binding Nome}" Padding="12,6" LineBreakMode="TailTruncation" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="Ligar à pessoa escolhida" Style="{StaticResource BotaoSecundario}" HorizontalOptions="Start"
                        Command="{Binding Formulario.LigarPessoaCommand}" />

                <!-- Perfis -->
                <Label Text="Perfis" Style="{StaticResource Subtitulo}" Margin="0,16,0,0" />
                <Label Text="Cada perfil vale para todas as empresas ou só para uma. O usuário soma as permissões de todos."
                       Style="{StaticResource Secundario}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Perfis}" Spacing="4">
                    <BindableLayout.EmptyView>
                        <Label Text="Nenhum perfil ainda." Style="{StaticResource Secundario}" Margin="0,4" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="seg:PerfilAtribuido">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,2">
                                <Label Text="{Binding Texto}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <Button Grid.Column="1" Text="Remover" Style="{StaticResource BotaoLink}"
                                        Clicked="RemoverPerfil_Clicked" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,4,0,0">
                    <Picker Title="Perfil" ItemsSource="{Binding PerfisDisponiveis}" SelectedItem="{Binding PerfilParaAdicionar}"
                            WidthRequest="{OnIdiom Phone=-1, Default=220}" Margin="0,0,8,8"
                            FlexLayout.Basis="{OnIdiom Phone='100%', Default='auto'}" />
                    <Picker Title="Empresa" ItemsSource="{Binding EmpresasDisponiveis}" SelectedItem="{Binding EmpresaParaAdicionar}"
                            WidthRequest="{OnIdiom Phone=-1, Default=240}" Margin="0,0,8,8"
                            FlexLayout.Basis="{OnIdiom Phone='100%', Default='auto'}" />
                    <Button Text="+ Adicionar perfil" Style="{StaticResource BotaoSecundario}" Margin="0,0,0,8"
                            Command="{Binding AdicionarPerfilCommand}" />
                </FlexLayout>

                <!-- Senha -->
                <Label Text="Senha" Style="{StaticResource Subtitulo}" Margin="0,16,0,0" />
                <Label Text="{Binding Formulario.RotuloSenha}" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Formulario.NovaSenha}" IsPassword="True" SemanticProperties.Description="Senha" />
                <Label Text="Confirme a senha" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Formulario.Confirmacao}" IsPassword="True" SemanticProperties.Description="Confirmação da senha" />
                <Label Text="Pelo menos 8 caracteres, com letras e números. Com a senha definida aqui, o usuário cria a dele no próximo acesso, e as sessões abertas dele são encerradas."
                       Style="{StaticResource Secundario}" />
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
