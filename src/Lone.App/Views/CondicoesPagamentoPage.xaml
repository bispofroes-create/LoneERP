<?xml version="1.0" encoding="utf-8" ?>
<!-- Condições de pagamento: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.CondicoesPagamentoPage"
             x:DataType="cad:CondicoesPagamentoViewModel"
             Title="Condições de pagamento">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Condições de pagamento"
                         Subtitulo="Condições de pagamento: parcelas em dias a partir da venda e acréscimo ou desconto sobre o total. Usadas na conta do cliente, nos perfis e nas exceções."
                         TextoNovo="+  Nova condição de pagamento"
                         DicaBusca="Pesquisar condições de pagamento"
                         TituloVazio="Nenhuma condição de pagamento cadastrada" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Condições de pagamento">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                                            <c:Campo Rotulo="Parcelas (dias)" Texto="{Binding Formulario.Parcelas}" Dica="Ex.: 30/60/90 (0 = à vista)" />
                    <c:Campo Rotulo="Acréscimo (+) ou desconto (-) %" Texto="{Binding Formulario.Acrescimo}" Dica="vazio = nenhum" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: 30/60/90 dias" />
                </c:BlocoCampos>
                <Label Text="{Binding Formulario.PrazoMedio}" Style="{StaticResource Secundario}" />
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
