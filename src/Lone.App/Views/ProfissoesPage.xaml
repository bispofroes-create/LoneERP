<?xml version="1.0" encoding="utf-8" ?>
<!-- Cadastro de profissões e tabela CBO: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Profissões não são excluídas: são desativadas ou mescladas. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.ProfissoesPage"
             x:DataType="cad:ProfissoesViewModel"
             Title="Profissões">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Profissões"
                         Subtitulo="As profissões são escolhidas na aba &quot;Dados pessoais&quot; do cadastro de pessoas. Cada uma pode ter a ocupação oficial da CBO."
                         TextoNovo="+  Nova profissão"
                         DicaBusca="Pesquisar profissões"
                         TituloVazio="Nenhuma profissão cadastrada">
            <c:ListaCadastro.Aviso>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding SituacaoCbo}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Importar CBO" Style="{StaticResource BotaoSecundario}" Command="{Binding ImportarCboCommand}"
                        IsVisible="{Binding PodeImportarCbo}" IsEnabled="{Binding Livre}"
                        ToolTipProperties.Text="Arquivo &quot;CBO2002 - Ocupacao.csv&quot; do site da CBO (Ministério do Trabalho)" />
                </Grid>
            </c:ListaCadastro.Aviso>
        </c:ListaCadastro>

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Profissões">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome da profissão" Texto="{Binding Formulario.Nome}" Dica="Ex.: Advogado" />
                    <c:Campo Rotulo="Descrição (opcional)" Texto="{Binding Formulario.Descricao}"
                             Dica="Quando usar esta profissão" FlexLayout.Basis="100%" />
                </c:BlocoCampos>
                <c:CampoLista Rotulo="Ocupação CBO (opcional)" BindingContext="{Binding Formulario.Cbo}" MaximumWidthRequest="640"
                              HorizontalOptions="Start" />
                <Label Text="Maiúsculas e acentos não contam: &quot;Advogado&quot;, &quot;ADVOGADO&quot; e &quot;advogádo&quot; são a mesma profissão."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar profissão" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar profissão" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>

                <!-- Mesclar -->
                <VerticalStackLayout Spacing="6" Margin="0,16,0,0" IsVisible="{Binding PodeMesclar}">
                    <Label Text="Mesclar com outra profissão" Style="{StaticResource Subtitulo}" />
                    <Label Text="Para juntar profissões repetidas (ex.: &quot;Adv.&quot; e &quot;Advogado&quot;): os cadastros desta passam para a escolhida e esta é desativada. A mudança fica no histórico de cada cadastro."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    <c:BlocoCampos AlignItems="End">
                        <c:CampoEscolha Rotulo="Passar os cadastros para" Itens="{Binding DestinosMesclagem}"
                                        Selecionado="{Binding DestinoMesclagem}" />
                        <Button Text="Mesclar" Style="{StaticResource BotaoSecundario}" Command="{Binding MesclarCommand}"
                                IsEnabled="{Binding Livre}" Margin="0,0,0,4" />
                    </c:BlocoCampos>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
