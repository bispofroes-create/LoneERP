<?xml version="1.0" encoding="utf-8" ?>
<!-- Cargos: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.CargosPage"
             x:DataType="cad:CargosViewModel"
             Title="Cargos">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Cargos"
                         Subtitulo="Os cargos são escolhidos nas lotações da aba &quot;Colaborador&quot; do cadastro de pessoas. O código CBO (opcional) liga o cargo à tabela oficial."
                         TextoNovo="+  Novo cargo"
                         DicaBusca="Pesquisar cargos"
                         TituloVazio="Nenhum cargo cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Cargos">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                                            <c:Campo Rotulo="Código CBO (opcional)" Texto="{Binding Formulario.CodigoCbo}" Dica="Ex.: 4211-25" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Vendedor interno" />
                </c:BlocoCampos>
                <Label Text="{Binding Formulario.Ocupacao}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
