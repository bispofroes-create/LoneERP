<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lone.Cliente.ViewModels;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Entrar">
    <ScrollView>
        <Border Style="{StaticResource CartaoEntrada}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Lone ERP" Style="{StaticResource Titulo}" />
                <Label Text="Entre com o seu usuário." Style="{StaticResource Secundario}" Margin="0,0,0,8" />

                <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />

                <Label Text="Login" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Login}" Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                       ReturnType="Next" SemanticProperties.Description="Login" />

                <Label Text="Senha" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Senha}" IsPassword="True" ReturnType="Go"
                       ReturnCommand="{Binding EntrarCommand}" SemanticProperties.Description="Senha" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                    <Button Text="Entrar" Command="{Binding EntrarCommand}" IsEnabled="{Binding Livre}" />
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
                </Grid>

                <BoxView HeightRequest="1" Margin="0,12,0,4" Opacity="0.3"
                         Color="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />

                <Button Text="Servidor" Style="{StaticResource BotaoLink}" Command="{Binding AlternarServidorCommand}"
                        SemanticProperties.Hint="Mostra o endereço do servidor da empresa" />
                <VerticalStackLayout IsVisible="{Binding MostrarServidor}" Spacing="6">
                    <Label Text="Endereço do servidor" Style="{StaticResource Rotulo}" />
                    <Entry Text="{Binding EnderecoServidor}" Keyboard="Url" IsSpellCheckEnabled="False"
                           Placeholder="https://servidor:porta" SemanticProperties.Description="Endereço do servidor" />
                    <Label Text="Informado pelo responsável pela instalação do Lone na sua empresa." Style="{StaticResource Secundario}" />
                    <Button Text="Servidor novo? Criar o primeiro acesso" Style="{StaticResource BotaoLink}"
                            Command="{Binding VerificarPrimeiroAcessoCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
