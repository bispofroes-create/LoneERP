<?xml version="1.0" encoding="utf-8" ?>
<!-- Campos personalizados das pessoas e dos documentos: tabela à esquerda (com a ordem), ficha ao lado. Campos não são excluídos: são desativados. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.CamposPersonalizadosPage"
             x:DataType="cad:CamposPersonalizadosViewModel"
             Title="Campos personalizados">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Campos personalizados"
                         Subtitulo="Campos de pessoas aparecem na aba &quot;Informações adicionais&quot;; campos de documentos aparecem em cada documento do tipo escolhido. Nesta ordem."
                         TextoNovo="+  Novo campo personalizado"
                         DicaBusca="Pesquisar campos personalizados"
                         TituloVazio="Nenhum campo personalizado cadastrado">
            <c:ListaCadastro.Filtros>
                <c:CampoEscolha Rotulo="Campos de" Itens="{Binding ListaEscopos}" Selecionado="{Binding Escopo}" WidthRequest="260" />
            </c:ListaCadastro.Filtros>
        </c:ListaCadastro>

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Campos personalizados">
            <VerticalStackLayout Spacing="10">
                <c:BlocoCampos>
                    <c:CampoEscolha Rotulo="Tipo de documento" Itens="{Binding Formulario.TiposDocumento}" Selecionado="{Binding Formulario.TipoDocumento}"
                                    IsVisible="{Binding Formulario.DeDocumento}" IsEnabled="{Binding Formulario.PodeMudarTipoDocumento}" />
                    <c:Campo Rotulo="Nome do campo" Texto="{Binding Formulario.Nome}" Dica="Ex.: Quantidade de filhos" />
                    <c:CampoEscolha Rotulo="Tipo" Itens="{Binding Formulario.ListaTipos}" Selecionado="{Binding Formulario.Tipo}"
                                    IsEnabled="{Binding Formulario.PodeMudarTipo}" />
                    <c:Campo Rotulo="Dica (opcional)" Texto="{Binding Formulario.Dica}" Dica="Texto de ajuda mostrado dentro do campo"
                             FlexLayout.Basis="100%" />
                    <c:CaixaMarcar Texto="Obrigatório (o cadastro não salva sem este campo)" Marcado="{Binding Formulario.Obrigatorio}" />
                    <c:CaixaMarcar Texto="Visível na ficha (oculto = guardado para importações e integrações)" Marcado="{Binding Formulario.Visivel}" />
                    <c:CaixaMarcar Texto="Pesquisável (entra na busca da lista de pessoas)" Marcado="{Binding Formulario.Pesquisavel}"
                                   IsVisible="{Binding Formulario.PodeSerPesquisavel}" />
                </c:BlocoCampos>
                <Label Text="O tipo não pode mais ser mudado: este campo já tem valores gravados. Para outro tipo, desative-o e crie outro campo."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" IsVisible="{Binding Formulario.TemValores}" />

                <!-- Números: limites e casas decimais -->
                <c:BlocoCampos IsVisible="{Binding Formulario.UsaLimites}">
                    <c:Campo Rotulo="Valor mínimo (opcional)" Texto="{Binding Formulario.Minimo}" Mascara="Numero" />
                    <c:Campo Rotulo="Valor máximo (opcional)" Texto="{Binding Formulario.Maximo}" Mascara="Numero" />
                    <c:Campo Rotulo="Casas decimais" Texto="{Binding Formulario.CasasDecimais}" Mascara="Numero"
                             IsVisible="{Binding Formulario.UsaCasas}" />
                </c:BlocoCampos>

                <!-- Lista de opções -->
                <VerticalStackLayout IsVisible="{Binding Formulario.UsaOpcoes}" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Opções" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Adicionar opção" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding Formulario.AdicionarOpcaoCommand}" />
                    </Grid>
                    <Label Text="Opções já gravadas não são excluídas (podem estar em uso): são desativadas e continuam legíveis nos cadastros antigos."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Opcoes}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cad:OpcaoEdicao">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding Texto}" Placeholder="Ex.: Casado" IsEnabled="{Binding Ativa}" />
                                    <Button Grid.Column="1" Text="{Binding TextoBotao}" Style="{StaticResource BotaoLink}"
                                            Command="{Binding RemoverCommand}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Ordem dos campos na ficha (antes eram as setas ▲▼ em cada linha da lista; 03/10/2026). -->
                <Label Text="Ordem na ficha" Style="{StaticResource Subtitulo}" Margin="0,8,0,0" />
                <Label Text="Os campos aparecem na ficha na ordem da lista (sem pesquisa). Subir e descer gravam na hora."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="12">
                    <Button Text="▲  Subir" Style="{StaticResource BotaoSecundario}" Command="{Binding SubirCommand}"
                            CommandParameter="{Binding Selecionado}" IsEnabled="{Binding Livre}" />
                    <Button Text="▼  Descer" Style="{StaticResource BotaoSecundario}" Command="{Binding DescerCommand}"
                            CommandParameter="{Binding Selecionado}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar campo" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar campo" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
