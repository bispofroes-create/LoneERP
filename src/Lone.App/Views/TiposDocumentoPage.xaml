<?xml version="1.0" encoding="utf-8" ?>
<!-- Tipos de documento: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Tipos não são excluídos: são desativados. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.TiposDocumentoPage"
             x:DataType="cad:TiposDocumentoViewModel"
             Title="Tipos de documento">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Tipos de documento"
                         Subtitulo="Os tipos são escolhidos na aba &quot;Documentos&quot; do cadastro de pessoas (ex.: RG, CNH, Alvará, Certificado digital). Cada tipo diz se a validade é obrigatória e com quantos dias de antecedência avisar o vencimento."
                         TextoNovo="+  Novo tipo de documento"
                         DicaBusca="Pesquisar tipos de documento"
                         TituloVazio="Nenhum tipo de documento cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Tipos de documento">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome do tipo" Texto="{Binding Formulario.Nome}" Dica="Ex.: Alvará de funcionamento" />
                    <c:Campo Rotulo="Ordem" Texto="{Binding Formulario.Ordem}" Mascara="Numero" Dica="Vazio = no fim" />
                </c:BlocoCampos>
                <c:BlocoCampos>
                    <c:CaixaMarcar Texto="Exige validade (documento ativo precisa de &quot;válido até&quot;)" Marcado="{Binding Formulario.ExigeValidade}" />
                    <c:Campo Rotulo="Avisar vencimento com (dias)" Texto="{Binding Formulario.DiasAvisoVencimento}" Mascara="Numero"
                             Dica="0 = só quando vencer" />
                </c:BlocoCampos>
                <Label Text="Tipo do sistema (RG, CNH, Passaporte...): usado por regras e integrações; pode ser renomeado e desativado."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" IsVisible="{Binding Formulario.DoSistema}" />
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar tipo" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar tipo" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
