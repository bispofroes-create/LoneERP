<?xml version="1.0" encoding="utf-8" ?>
<!-- Indicadores das metas: tabela à esquerda, ficha ao lado. Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Lone.Cliente.ViewModels.Metas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.IndicadoresPage"
             x:DataType="m:IndicadoresViewModel"
             Title="Indicadores">

    <Grid x:Name="Grade" ColumnDefinitions="340,*">

        <!-- ===== Tabela ===== -->
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="10" IsVisible="{Binding MostrarLista}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Text="{Binding Busca}" Placeholder="Buscar" />
                <Button Grid.Column="1" Text="Novo" Command="{Binding NovoCommand}" IsEnabled="{Binding Livre}" />
            </Grid>

            <ContentView Grid.Row="1" IsVisible="{Binding SemFicha}">
                <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />
            </ContentView>

            <Grid Grid.Row="2" ColumnDefinitions="*,72,40" Padding="12,0">
                <Label Text="Indicador" Style="{StaticResource Rotulo}" />
                <Label Grid.Column="1" Text="" Style="{StaticResource Rotulo}" HorizontalOptions="End" />
                <Label Grid.Column="2" Text="Ativo" Style="{StaticResource Rotulo}" HorizontalOptions="End" />
            </Grid>

            <CollectionView Grid.Row="3" ItemsSource="{Binding Itens}" SelectionMode="Single" SelectedItem="{Binding Selecionado}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum cadastro. Clique em Novo." Style="{StaticResource Secundario}" Margin="8,16" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:LinhaIndicador">
                        <Grid ColumnDefinitions="*,72,40" Padding="12,8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" IsVisible="False" />
                            <Label Grid.Column="2" Text="{Binding Ativo}" Style="{StaticResource Secundario}" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator Grid.Row="3" IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                               VerticalOptions="Start" HorizontalOptions="Center" Margin="0,24" />
        </Grid>

        <!-- ===== Nenhuma ficha aberta (só no computador) ===== -->
        <VerticalStackLayout Grid.Column="1" IsVisible="{Binding MostrarVazio}" VerticalOptions="Center"
                             HorizontalOptions="Center" Spacing="6" Padding="24">
            <Label Text="Nenhum cadastro aberto" Style="{StaticResource Subtitulo}" HorizontalOptions="Center" />
            <Label Text="Indicadores medem as metas. Os do sistema (novos clientes, clientes ativos, reativados, interações) são contados no cadastro; os informados são lançados na meta ou importados de planilha. Vendas e faturamento entram quando o módulo de vendas existir."
                   Style="{StaticResource Secundario}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ===== Ficha ===== -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" IsVisible="{Binding MostrarFicha}">
            <ScrollView>
                <VerticalStackLayout Padding="{OnIdiom Phone='16,16', Default='32,24'}" Spacing="10" MaximumWidthRequest="760"
                                     HorizontalOptions="Fill">
                    <Button Text="‹ Indicadores" Style="{StaticResource BotaoLink}" Command="{Binding FecharFichaCommand}"
                            IsVisible="{Binding ModoCompacto}" />
                    <Label Text="{Binding Formulario.Titulo}" Style="{StaticResource Titulo}" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Formulario.SituacaoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />

                    <FlexLayout Wrap="Wrap">
                        <c:Campo Rotulo="Código" Texto="{Binding Formulario.Codigo}" Dica="Ex.: FATURAMENTO" IsEnabled="{Binding Formulario.PodeMudarCodigo}" />
                        <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Faturamento" />
                        <c:CampoEscolha Rotulo="Fonte do realizado" Itens="{Binding Formulario.ListaFontes}" Selecionado="{Binding Formulario.Fonte}" IsEnabled="False" />
                        <c:CampoEscolha Rotulo="Unidade" Itens="{Binding Formulario.ListaUnidades}" Selecionado="{Binding Formulario.Unidade}" />
                        <c:CampoEscolha Rotulo="Sentido" Itens="{Binding Formulario.ListaSentidos}" Selecionado="{Binding Formulario.Sentido}"
                                        IsEnabled="{Binding Formulario.PodeMudarSentido}" />
                    </FlexLayout>
                    <Label Text="O código e a fonte não mudam depois de gravados (as metas e as integrações apontam para eles)."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                        <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                                IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                        <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                                IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="1" StrokeThickness="0" Padding="{OnIdiom Phone='16,10', Default='32,12'}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Salvar" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeSalvarAgora}" />
                    <Button Text="Descartar" Style="{StaticResource BotaoSecundario}" Command="{Binding DescartarCommand}"
                            IsEnabled="{Binding Livre}" ToolTipProperties.Text="Desfaz as alterações não salvas (não exclui nada)" />
                    <Button Text="Fechar" Style="{StaticResource BotaoLink}" Command="{Binding FecharFichaCommand}" />
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" VerticalOptions="Center" />
                    <!-- Estado da ficha: "Sem alterações" / "Alterações não salvas" (o Salvar só habilita com o que gravar). -->
                    <Label Text="{Binding EstadoFicha}" Style="{StaticResource Secundario}" VerticalOptions="Center" SemanticProperties.Description="{Binding EstadoFicha}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
