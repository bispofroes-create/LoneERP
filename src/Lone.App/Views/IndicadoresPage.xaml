<?xml version="1.0" encoding="utf-8" ?>
<!-- Indicadores das metas: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Lone.Cliente.ViewModels.Metas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.IndicadoresPage"
             x:DataType="m:IndicadoresViewModel"
             Title="Indicadores">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Indicadores"
                         Subtitulo="Indicadores medem as metas. Os do sistema (novos clientes, clientes ativos, reativados, interações) são contados no cadastro; os informados são lançados na meta ou importados de planilha. Vendas e faturamento entram quando o módulo de vendas existir."
                         TextoNovo="+  Novo indicador"
                         DicaBusca="Pesquisar indicadores"
                         TituloVazio="Nenhum indicador cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Indicadores">
            <VerticalStackLayout Spacing="10">
                <c:BlocoCampos>
                    <c:Campo Rotulo="Código" Texto="{Binding Formulario.Codigo}" Dica="Ex.: FATURAMENTO" IsEnabled="{Binding Formulario.PodeMudarCodigo}" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Faturamento" />
                    <c:CampoEscolha Rotulo="Fonte do realizado" Itens="{Binding Formulario.ListaFontes}" Selecionado="{Binding Formulario.Fonte}" IsEnabled="False" />
                    <c:CampoEscolha Rotulo="Unidade" Itens="{Binding Formulario.ListaUnidades}" Selecionado="{Binding Formulario.Unidade}" />
                    <c:CampoEscolha Rotulo="Sentido" Itens="{Binding Formulario.ListaSentidos}" Selecionado="{Binding Formulario.Sentido}"
                                    IsEnabled="{Binding Formulario.PodeMudarSentido}" />
                </c:BlocoCampos>
                <Label Text="O código e a fonte não mudam depois de gravados (as metas e as integrações apontam para eles)."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
