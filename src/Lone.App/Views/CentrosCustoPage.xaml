<?xml version="1.0" encoding="utf-8" ?>
<!-- Centros de custo: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.CentrosCustoPage"
             x:DataType="cad:CentrosCustoViewModel"
             Title="Centros de custo">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Centros de custo"
                         Subtitulo="Centros de custo em árvore: os sintéticos agrupam, os analíticos recebem colaboradores nas lotações. O código é único (ex.: 1, 1.01, 1.02)."
                         TextoNovo="+  Novo centro de custo"
                         DicaBusca="Pesquisar centros de custo"
                         TituloVazio="Nenhum centro de custo cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Centros de custo">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                                            <c:Campo Rotulo="Código" Texto="{Binding Formulario.Codigo}" Dica="Ex.: 1.01" />
                    <c:CampoEscolha Rotulo="Abaixo de" Itens="{Binding Formulario.Pais}" Selecionado="{Binding Formulario.Pai}" />
                    <c:CaixaMarcar Texto="Analítico (recebe colaboradores; sintético só agrupa outros centros)" Marcado="{Binding Formulario.Analitico}" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Vendas" />
                </c:BlocoCampos>
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
