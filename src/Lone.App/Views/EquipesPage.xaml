<?xml version="1.0" encoding="utf-8" ?>
<!-- Equipes das metas: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativada. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Lone.Cliente.ViewModels.Metas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.EquipesPage"
             x:DataType="m:EquipesViewModel"
             Title="Equipes">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Equipes"
                         Subtitulo="Equipes agrupam colaboradores (ex.: Televendas Sul) e podem ser participantes das metas. Membros têm entrada e saída: quem sai continua no histórico. Uma equipe pode ficar abaixo de outra (ex.: Televendas Sul abaixo de Comercial)."
                         TextoNovo="+  Nova equipe"
                         DicaBusca="Pesquisar equipes"
                         TituloVazio="Nenhuma equipe cadastrada" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Equipes">
            <VerticalStackLayout Spacing="10">
                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Televendas Sul" />
                    <c:CampoEscolha Rotulo="Departamento" Itens="{Binding Formulario.Departamentos}" Selecionado="{Binding Formulario.Departamento}" />
                    <c:CampoEscolha Rotulo="Equipe acima" Itens="{Binding Formulario.EquipesAcima}" Selecionado="{Binding Formulario.EquipeAcima}" />
                </c:BlocoCampos>
                <Label Style="{StaticResource Secundario}" LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Líder hoje: " />
                            <Span Text="{Binding Formulario.LiderHoje}" FontAttributes="Bold" />
                            <Span Text=". O líder é o membro com papel Líder (um por vez). Para trocar, informe a saída do líder atual e inclua o novo como Líder a partir do dia seguinte. Quem lidera enxerga a carteira da equipe e das equipes abaixo." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                    <Label Text="Membros" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="+ Adicionar membro" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarMembroCommand}" />
                </Grid>
                <Label Text="Saiu da equipe? Informe a saída (o membro continua no histórico e nas metas do período em que participou)."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Membros}" Spacing="6">
                    <BindableLayout.EmptyView>
                        <Label Text="Nenhum membro." Style="{StaticResource Secundario}" Margin="0,8" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:MembroEquipeFormulario">
                            <Border Style="{StaticResource CartaoItem}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <c:BlocoCampos>
                                        <c:CampoEscolha Rotulo="Pessoa" Itens="{Binding Pessoas}" Selecionado="{Binding Pessoa}" IsEnabled="{Binding PodeTrocarPessoa}" />
                                        <c:CampoEscolha Rotulo="Papel" Itens="{Binding ListaPapeis}" Selecionado="{Binding Papel}" IsEnabled="{Binding PodeTrocarPapel}" />
                                        <c:Campo Rotulo="Entrada" Texto="{Binding InicioEm}" Dica="dd/mm/aaaa" Mascara="Data" />
                                        <c:Campo Rotulo="Saída" Texto="{Binding FimEm}" Dica="vazio = atual" Mascara="Data" />
                                    </c:BlocoCampos>
                                    <Button Grid.Column="1" Text="Remover" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}"
                                            IsVisible="{Binding PodeRemover}" VerticalOptions="Start" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
