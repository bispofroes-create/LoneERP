<?xml version="1.0" encoding="utf-8" ?>
<!-- Finalidades de tratamento (LGPD): lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Não são excluídas: são desativadas. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.FinalidadesTratamentoPage"
             x:DataType="cad:FinalidadesTratamentoViewModel"
             Title="Finalidades de tratamento">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Finalidades de tratamento"
                         Subtitulo="Para quê a pessoa pode ser contatada (ex.: Marketing). O consentimento é dado por finalidade, na aba &quot;Privacidade&quot; da pessoa."
                         TextoNovo="+  Nova finalidade"
                         DicaBusca="Pesquisar finalidades de tratamento"
                         TituloVazio="Nenhuma finalidade cadastrada" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Finalidades de tratamento">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Código" Texto="{Binding Formulario.Codigo}" Dica="Ex.: PESQUISA_SATISFACAO"
                             SomenteLeitura="{Binding Formulario.CodigoSomenteLeitura}" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Pesquisa de satisfação" />
                    <c:Campo Rotulo="Ordem" Texto="{Binding Formulario.Ordem}" Mascara="Numero" Dica="Vazio = no fim" />
                    <c:CampoEscolha Rotulo="Base legal" Itens="{Binding Formulario.BasesLegais}" Selecionado="{Binding Formulario.BaseLegal}"
                                    IsEnabled="{Binding Formulario.PodeMudarRegras}" />
                    <c:CampoEscolha Rotulo="Classificação exigida do canal" Itens="{Binding Formulario.Classificacoes}"
                                    Selecionado="{Binding Formulario.Classificacao}" IsEnabled="{Binding Formulario.PodeMudarRegras}" />
                    <c:Campo Rotulo="Descrição (opcional)" Texto="{Binding Formulario.Descricao}" FlexLayout.Basis="100%" />
                </c:BlocoCampos>
                <Label Text="O código não muda depois de criado. Base legal: nesta versão só Consentimento tem regra no Lone. A classificação exigida diz que marca o canal precisa ter (ex.: Marketing exige o e-mail marcado &quot;Uso para marketing&quot;); ela não substitui o consentimento."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar finalidade" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar finalidade" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
