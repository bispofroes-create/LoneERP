<?xml version="1.0" encoding="utf-8" ?>
<!-- Papéis comerciais (tipos de carteira): tabela à esquerda, ficha ao lado, com a política de cada papel. Nada é
     excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.TiposCarteiraPage"
             x:DataType="cad:TiposCarteiraViewModel"
             Title="Papéis comerciais">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Papéis comerciais"
                         Subtitulo="Papéis de quem atende o cliente na carteira (vendedor, representante, supervisor...), cada um com a sua política: quantos ao mesmo tempo, crédito da venda e metas. Um só papel é o responsável da conta: o vendedor vigente dele é o vendedor padrão do cliente."
                         TextoNovo="+  Novo papel comercial"
                         DicaBusca="Pesquisar papéis comerciais"
                         TituloVazio="Nenhum papel comercial cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Papéis comerciais">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Televendas" />
                    <c:Campo Rotulo="Ordem" Texto="{Binding Formulario.Ordem}" Mascara="Numero" />
                </c:BlocoCampos>
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Política do papel (Motor Comercial, Fase 1) -->
                <Label Text="Política do papel" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                <c:BlocoCampos>
                    <c:Campo Rotulo="Quantos ao mesmo tempo" Texto="{Binding Formulario.LimitePorVez}" Mascara="Numero"
                             Dica="vazio = sem limite" />
                    <c:CampoEscolha Rotulo="Crédito da venda" Itens="{Binding Formulario.Creditos}" Selecionado="{Binding Formulario.Credito}" />
                    <c:Campo Rotulo="Percentual padrão (%)" Texto="{Binding Formulario.PercentualPadrao}" Teclado="Numeric"
                             Dica="vazio = sem padrão" IsVisible="{Binding Formulario.RecebeCredito}" />
                </c:BlocoCampos>
                <!-- Quem pode ser: classificações de pessoa aceitas (Motor Comercial, Fase 1b). -->
                <Label Text="Quem pode ser" Style="{StaticResource Rotulo}" Margin="0,8,0,0" />
                <Label Text="Só pessoas com uma destas classificações (ativa) aparecem para este papel na carteira do cliente. Ex.: Supervisor = Funcionário."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.Classificacoes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="cad:ClassificacaoMarcavel">
                            <c:CaixaMarcar Texto="{Binding Nome}" Marcado="{Binding Marcado}" Margin="0,0,16,0" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <c:CaixaMarcar Texto="Responsável da conta (o vendedor vigente deste papel vira o vendedor padrão do cliente; sempre um por vez)"
                               Marcado="{Binding Formulario.ResponsavelDaConta}" />
                <c:CaixaMarcar Texto="Conta para metas (os clientes deste papel entram no realizado das metas do vendedor)"
                               Marcado="{Binding Formulario.ContaParaMetas}" />
                <Label Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
                       Text="Um por vez: incluir outro vendedor deste papel no cliente encerra o anterior na véspera (com confirmação). Receita: os vínculos de receita vigentes dividem os 100% da venda (um só fica com 100%). Sobreposição: crédito extra, como o de um supervisor. Baixar o limite só é aceito se nenhum cliente ficar acima dele." />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
