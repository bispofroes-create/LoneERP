<?xml version="1.0" encoding="utf-8" ?>
<!-- Tipos de telefone/e-mail: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Tipos não são excluídos: são desativados. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.TiposMeioContatoPage"
             x:DataType="cad:TiposMeioContatoViewModel"
             Title="Tipos de telefone/e-mail">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Tipos de telefone/e-mail"
                         Subtitulo="Os tipos classificam os telefones e e-mails da aba &quot;Contatos&quot; do cadastro de pessoas (ex.: Comercial, Residencial)."
                         TextoNovo="+  Novo tipo de telefone/e-mail"
                         DicaBusca="Pesquisar tipos de telefone/e-mail"
                         TituloVazio="Nenhum tipo de telefone/e-mail cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Tipos de telefone/e-mail">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome do tipo" Texto="{Binding Formulario.Nome}" Dica="Ex.: Comercial" />
                    <c:CampoEscolha Rotulo="Categoria" Itens="{Binding Formulario.ListaCategorias}" Selecionado="{Binding Formulario.Categoria}"
                                    IsEnabled="{Binding Formulario.PodeMudarCategoria}" />
                    <c:Campo Rotulo="Ordem" Texto="{Binding Formulario.Ordem}" Mascara="Numero" Dica="Vazio = no fim" />
                </c:BlocoCampos>
                <Label Text="A categoria (telefone ou e-mail) não muda depois de criado. Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar tipo" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar tipo" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
