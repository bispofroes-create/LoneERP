<?xml version="1.0" encoding="utf-8" ?>
<!-- Comercial › Divergências territoriais (Fase 2b-1b, DN-14): quem o motor colocaria diferente hoje, e por quê; "Criar operação com estas" abre um rascunho TE- sem mudanças que as corrige. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Lone.Cliente.ViewModels.Territorios;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.DivergenciasTerritoriaisPage"
             x:DataType="t:DivergenciasTerritoriaisViewModel"
             Title="Divergências territoriais">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,16', Default='32,24'}" Spacing="10">
            <Label Text="Divergências territoriais" Style="{StaticResource TituloPagina}" />
            <Label Text="O cadastro de clientes muda (endereço, etiquetas, CNAE...) sem passar pelas operações. Aqui aparece, por mapa, quem as regras e exceções de hoje colocariam num território diferente do gravado, e por quê. Para corrigir, crie uma operação com estas divergências: ela é simulada e aplicada como qualquer outra."
                   Style="{StaticResource SubtituloPagina}" LineBreakMode="WordWrap" />
            <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />
            <!-- Campo + botão = 1 coluna da grade, com o botão alinhado à caixa (mesmo padrão do CNPJ + Consultar). -->
            <c:BlocoCampos>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Padding="0,0,12,8">
                    <c:CampoEscolha Rotulo="Mapa territorial" Itens="{Binding Mapas}" Selecionado="{Binding Mapa}" Padding="0" />
                    <Button Grid.Column="1" Text="Conferir" Command="{Binding ConferirCommand}" IsEnabled="{Binding Livre}" VerticalOptions="End" />
                </Grid>
            </c:BlocoCampos>
            <Label Text="{Binding Resumo}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            <Button Text="Criar operação com estas" Command="{Binding CriarOperacaoCommand}" IsVisible="{Binding PodeCriarOperacao}"
                    IsEnabled="{Binding Livre}" HorizontalOptions="Start" />
            <!-- Lista num painel com a largura da página; o "Por quê?" do cliente escolhido fica ao lado (03/10/2026). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding TemItens}">
                <Border Style="{StaticResource PainelConteudo}" Padding="8">
                    <VerticalStackLayout Spacing="4">
                        <CollectionView ItemsSource="{Binding Itens}" SelectionMode="Single" SelectedItem="{Binding Selecionado}" MaximumHeightRequest="520">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="t:LinhaItemTerritorial">
                                    <VerticalStackLayout Padding="8,6">
                                        <Label Text="{Binding Titulo}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Mudanca}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="Mostrar mais" Style="{StaticResource BotaoLink}" Command="{Binding MaisCommand}" IsVisible="{Binding TemMais}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PainelConteudo}" WidthRequest="{StaticResource LarguraPainel}" VerticalOptions="Start"
                        IsVisible="{Binding TemSelecionado}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Por quê?" Style="{StaticResource SecaoTitulo}" />
                        <Label Text="{Binding Selecionado.Titulo}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Selecionado.PorQue}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
