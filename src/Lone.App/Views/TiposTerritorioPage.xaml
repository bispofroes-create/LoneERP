<?xml version="1.0" encoding="utf-8" ?>
<!-- Tipos de território (Fase 2b-1a): lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Lone.Cliente.ViewModels.Territorios;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.TiposTerritorioPage"
             x:DataType="t:TiposTerritorioViewModel"
             Title="Tipos de território">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Tipos de território"
                         Subtitulo="O tipo só classifica o território (Geográfico, Segmento, Estratégico...) para filtrar e agrupar. Quem decide se territórios disputam o mesmo cliente é o mapa territorial."
                         TextoNovo="+  Novo tipo de território"
                         DicaBusca="Pesquisar tipos de território"
                         TituloVazio="Nenhum tipo de território cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Tipos de território">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Código" Texto="{Binding Formulario.Codigo}" Dica="Ex.: GEOGRAFICO"
                             SomenteLeitura="{Binding Formulario.CodigoSomenteLeitura}" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Geográfico" />
                    <c:Campo Rotulo="Ordem" Texto="{Binding Formulario.Ordem}" Mascara="Numero" Dica="Vazio = no fim" />
                    <c:Campo Rotulo="Descrição" Texto="{Binding Formulario.Descricao}" Dica="Ex.: país, região, estado, cidade..." />
                </c:BlocoCampos>
                <Label Text="O código é digitado só ao criar (relatórios e integrações dependem dele). Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar tipo" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar tipo" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
