<?xml version="1.0" encoding="utf-8" ?>
<!-- Central de Pessoas: lista com busca e filtro à esquerda, ficha com abas ao lado (no celular, uma de cada vez). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:dto="clr-namespace:Lone.Contracts.Pessoas;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             xmlns:pv="clr-namespace:Lone.App.Views.Pessoas"
             x:Class="Lone.App.Views.PessoasPage"
             x:DataType="pes:PessoasViewModel"
             Title="Pessoas">

    <Grid x:Name="Grade" ColumnDefinitions="340,*">

        <!-- ===== Lista ===== -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="10" IsVisible="{Binding MostrarLista}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Text="{Binding Busca}" Placeholder="Nome, código, CPF/CNPJ, telefone..." />
                <Button Grid.Column="1" Text="Nova" Command="{Binding NovoCommand}" IsEnabled="{Binding Livre}"
                        IsVisible="{Binding PodeCriar}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker ItemsSource="{Binding FiltrosPapel}" SelectedItem="{Binding FiltroPapel}" Title="Papel"
                        SemanticProperties.Description="Filtrar por papel" />
                <c:CaixaMarcar Grid.Column="1" Texto="Inativos" Marcado="{Binding MostrarInativos}" VerticalOptions="Center" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker ItemsSource="{Binding FiltrosEtiqueta}" SelectedItem="{Binding FiltroEtiqueta}" Title="Etiqueta"
                        SemanticProperties.Description="Filtrar por etiqueta" />
                <c:CaixaMarcar Grid.Column="1" Texto="Município a corrigir" Marcado="{Binding SomenteMunicipioACorrigir}"
                               VerticalOptions="Center" />
            </Grid>

            <ContentView Grid.Row="3" IsVisible="{Binding SemFicha}">
                <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />
            </ContentView>

            <CollectionView Grid.Row="4" ItemsSource="{Binding Itens}" SelectionMode="Single" SelectedItem="{Binding Selecionado}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma pessoa encontrada." Style="{StaticResource Secundario}" Margin="8,16" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PessoaResumo">
                        <VerticalStackLayout Padding="12,10" Spacing="2">
                            <Label Text="{Binding Nome}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator Grid.Row="4" IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                               VerticalOptions="Start" HorizontalOptions="Center" Margin="0,24" />
        </Grid>

        <!-- ===== Nenhuma ficha aberta (só no computador) ===== -->
        <VerticalStackLayout Grid.Column="1" IsVisible="{Binding MostrarVazio}" VerticalOptions="Center"
                             HorizontalOptions="Center" Spacing="6" Padding="24">
            <Label Text="Nenhum cadastro aberto" Style="{StaticResource Subtitulo}" HorizontalOptions="Center" />
            <Label Text="Escolha uma pessoa na lista ou clique em Nova." Style="{StaticResource Secundario}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ===== Ficha: conteúdo rolável e barra de ações fixa embaixo ===== -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" IsVisible="{Binding MostrarFicha}">
            <ScrollView>
                <VerticalStackLayout Padding="{OnIdiom Phone='16,16', Default='32,24'}" Spacing="10" MaximumWidthRequest="960"
                                     HorizontalOptions="Fill">
                    <Button Text="‹ Pessoas" Style="{StaticResource BotaoLink}" Command="{Binding FecharFichaCommand}"
                            IsVisible="{Binding ModoCompacto}" />
                    <!-- Cabeçalho: quem é, sem abrir abas. Nome para exibir (PJ: exibição → nome fantasia → razão social),
                         razão social/nome civil quando diferente, tipo e papéis, documento, código e situação, grupo
                         empresarial e estabelecimentos (PJ) e etiquetas. Só leitura: tudo vem da própria ficha. -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Formulario.Titulo}" Style="{StaticResource Titulo}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Formulario.NomeCompletoCabecalho}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation"
                               IsVisible="{Binding Formulario.TemNomeCompletoCabecalho}" />
                        <Label Text="{Binding Formulario.TipoEPapeisCabecalho}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Formulario.DocumentoCabecalho}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Formulario.EstruturaCabecalho}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
                               IsVisible="{Binding Formulario.TemEstruturaCabecalho}" />
                        <Label Text="{Binding Formulario.EtiquetasCabecalho}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />

                    <Border Style="{StaticResource Cartao}" Padding="14" IsVisible="{Binding Formulario.TemBloqueios}"
                            Stroke="{StaticResource Aviso}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Bloqueios ativos" FontAttributes="Bold" />
                            <Label Text="{Binding Formulario.TextoBloqueios}" Style="{StaticResource Secundario}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Abas -->
                    <CollectionView ItemsSource="{Binding Secoes}" SelectionMode="Single" SelectedItem="{Binding SecaoSelecionada}"
                                    ItemsLayout="HorizontalList" HeightRequest="48">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pes:SecaoOpcao">
                                <Label Text="{Binding Texto}" Padding="14,12" FontAttributes="Bold" VerticalOptions="Center" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <BoxView HeightRequest="1" Opacity="0.4" Margin="0,0,0,8"
                             Color="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />

                    <pv:SecaoGeralView IsVisible="{Binding NaGeral}" />
                    <pv:SecaoPessoaisView IsVisible="{Binding NosPessoais}" />
                    <pv:SecaoEstabelecimentosView IsVisible="{Binding NosEstabelecimentos}" />
                    <pv:SecaoEnderecosView IsVisible="{Binding NosEnderecos}" />
                    <pv:SecaoContatosView IsVisible="{Binding NosContatos}" />
                    <pv:SecaoDocumentosView IsVisible="{Binding NosDocumentos}" />
                    <!-- Comercial: Cliente e Fornecedor na mesma aba, um bloco por papel ativo (a mesma pessoa pode ter os dois). -->
                    <pv:SecaoClienteView IsVisible="{Binding NoCliente}" />
                    <pv:SecaoFornecedorView IsVisible="{Binding NoFornecedor}" />
                    <pv:SecaoColaboradorView IsVisible="{Binding NoColaborador}" />
                    <pv:SecaoRelacionamentosView IsVisible="{Binding NosRelacionamentosPessoas}" />
                    <pv:SecaoAdicionaisView IsVisible="{Binding NasAdicionais}" />
                    <pv:SecaoRelacionamentoView IsVisible="{Binding NoRelacionamento}" />
                    <pv:SecaoPrivacidadeView IsVisible="{Binding NaPrivacidade}" />
                    <pv:SecaoSituacaoView IsVisible="{Binding NaSituacao}" />
                    <pv:SecaoHistoricoView IsVisible="{Binding NoHistorico}" />
                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="1" StrokeThickness="0" Padding="{OnIdiom Phone='16,10', Default='32,12'}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Salvar" Command="{Binding SalvarCommand}" IsEnabled="{Binding Livre}" IsVisible="{Binding PodeSalvar}" />
                    <Button Text="Descartar" Style="{StaticResource BotaoSecundario}" Command="{Binding DescartarCommand}"
                            IsEnabled="{Binding Livre}" ToolTipProperties.Text="Desfaz as alterações não salvas (não exclui nada)" />
                    <Button Text="Fechar" Style="{StaticResource BotaoLink}" Command="{Binding FecharFichaCommand}" />
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <!-- Motivo (opcional): vai para o histórico junto com o que mudou nesta gravação. -->
                <Entry Grid.Column="1" Text="{Binding Formulario.MotivoAlteracao}" Placeholder="Motivo da alteração (opcional)"
                       MaxLength="250" IsVisible="{Binding PodeSalvar}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
