<?xml version="1.0" encoding="utf-8" ?>
<!--
    Comercial › Territórios (Fase 2b-1a): o mapa escolhido, a árvore (com busca) à esquerda e a ficha do território ao lado,
    com os responsáveis e o histórico da posição. Nada é excluído: território é encerrado.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Lone.Cliente.ViewModels.Territorios;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.TerritoriosPage"
             x:DataType="t:TerritoriosViewModel"
             Title="Territórios">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Territórios"
                         Subtitulo="A árvore mostra onde cada território fica (Brasil › Sudeste › MG › Curvelo) e serve para somar os de baixo. Quem entra em cada território é decidido pelas regras, planejadas e simuladas em Operações territoriais antes de aplicar."
                         TextoNovo="+  Novo território"
                         DicaBusca="Pesquisar territórios"
                         TituloVazio="Nenhum território cadastrado">
            <c:ListaCadastro.Filtros>
                <HorizontalStackLayout Spacing="16">
                    <c:CampoEscolha Rotulo="Mapa territorial" Itens="{Binding Mapas}" Selecionado="{Binding Mapa}" IsEnabled="{Binding Livre}" WidthRequest="260" />
                    <c:CaixaMarcar Texto="Mostrar encerrados" Marcado="{Binding MostrarEncerrados}" VerticalOptions="End" Margin="0,0,0,10" />
                </HorizontalStackLayout>
            </c:ListaCadastro.Filtros>
            <c:ListaCadastro.Aviso>
                <Label Text="{Binding TextoMapa}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            </c:ListaCadastro.Aviso>
        </c:ListaCadastro>

        <c:FichaCadastro IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Territórios">
            <VerticalStackLayout Spacing="10">
                <!-- Dados -->
                <Label Text="Dados" Style="{StaticResource Subtitulo}" Margin="0,8,0,0" />
                <c:BlocoCampos IsEnabled="{Binding Formulario.Editavel}">
                    <c:Campo Rotulo="Código" Texto="{Binding Formulario.Codigo}" Dica="Ex.: MG_NORTE"
                             SomenteLeitura="{Binding Formulario.CodigoSomenteLeitura}" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: MG Norte" />
                    <c:CampoEscolha Rotulo="Tipo" Itens="{Binding Formulario.Tipos}" Selecionado="{Binding Formulario.Tipo}" />
                    <c:CampoEscolha Rotulo="Território acima" Itens="{Binding Formulario.Pais}" Selecionado="{Binding Formulario.Pai}"
                                    IsEnabled="{Binding Formulario.PodeMover}" />
                    <c:Campo Rotulo="Existe desde" Texto="{Binding Formulario.InicioEm}" Dica="dd/mm/aaaa" Mascara="Data"
                             SomenteLeitura="{Binding Formulario.InicioSomenteLeitura}" />
                    <c:Campo Rotulo="Descrição" Texto="{Binding Formulario.Descricao}" Dica="Opcional" />
                </c:BlocoCampos>
                <Label Text="O território acima só organiza a árvore (e desempata regras: Curvelo abaixo de MG vence MG). Quem entra em cada território são as regras dele (abaixo), que mudam por operação territorial."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Responsáveis -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <Label Text="Responsáveis" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="+ Adicionar responsável" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding AdicionarResponsavelCommand}" IsVisible="{Binding Formulario.Editavel}" />
                </Grid>
                <Label Text="Uma pessoa ou uma equipe, numa função (o papel comercial). O território não muda a carteira dos clientes. Saiu? Informe o fim: quem já começou continua no histórico."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Responsaveis}" Spacing="6" IsEnabled="{Binding Formulario.Editavel}">
                    <BindableLayout.EmptyView>
                        <Label Text="Nenhum responsável." Style="{StaticResource Secundario}" Margin="0,8" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="t:ResponsavelTerritorioFormulario">
                            <Border Style="{StaticResource CartaoItem}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <c:BlocoCampos>
                                        <c:CampoEscolha Rotulo="Função" Itens="{Binding Funcoes}" Selecionado="{Binding Funcao}" IsEnabled="{Binding PodeEditarQuem}" />
                                        <c:CampoEscolha Rotulo="Quem" Itens="{Binding ListaTiposQuem}" Selecionado="{Binding TipoQuem}" IsEnabled="{Binding PodeEditarQuem}" />
                                        <c:CampoEscolha Rotulo="Pessoa" Itens="{Binding Pessoas}" Selecionado="{Binding Pessoa}"
                                                        IsVisible="{Binding EhPessoa}" IsEnabled="{Binding PodeEditarQuem}" />
                                        <c:CampoEscolha Rotulo="Equipe" Itens="{Binding Equipes}" Selecionado="{Binding Equipe}"
                                                        IsVisible="{Binding EhEquipe}" IsEnabled="{Binding PodeEditarQuem}" />
                                        <c:Campo Rotulo="Início" Texto="{Binding InicioEm}" Dica="dd/mm/aaaa" Mascara="Data"
                                                 SomenteLeitura="{Binding JaComecou}" />
                                        <c:Campo Rotulo="Fim" Texto="{Binding FimEm}" Dica="vazio = atual" Mascara="Data" />
                                        <c:Campo Rotulo="Observação" Texto="{Binding Observacao}" Dica="Opcional" />
                                    </c:BlocoCampos>
                                    <Button Grid.Column="1" Text="Remover" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}"
                                            IsVisible="{Binding PodeRemover}" VerticalOptions="Start"
                                            ToolTipProperties.Text="Só para quem ainda não começou (incluído por engano). Quem já começou: informe o fim." />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Regras, exceções e clientes (Fase 2b-1b; só leitura: mudam por operação territorial) -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding TemMotor}">
                    <Label Text="Regra" Style="{StaticResource Subtitulo}" Margin="0,16,0,0" />
                    <Label Text="Versões da regra deste território. Para mudar: Comercial › Operações territoriais (planejar, simular, aplicar)."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Regras}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="Sem regra: ninguém entra aqui por regra (só por fixação)." Style="{StaticResource Secundario}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource CartaoItem}">
                                    <Label Text="{Binding .}" LineBreakMode="WordWrap" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Exceções" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Excecoes}" Spacing="2">
                        <BindableLayout.EmptyView>
                            <Label Text="Nenhuma exceção (fixar ou retirar cliente)." Style="{StaticResource Secundario}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Clientes" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                    <Label Text="{Binding TextoClientes}" Style="{StaticResource Secundario}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Clientes}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Operações em aberto com este território" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OperacoesAbertas}" Spacing="2">
                        <BindableLayout.EmptyView>
                            <Label Text="Nenhuma." Style="{StaticResource Secundario}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Histórico da posição -->
                <Label Text="Histórico da posição na árvore" Style="{StaticResource Subtitulo}" Margin="0,16,0,0"
                       IsVisible="{Binding Formulario.TemPosicoes}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Posicoes}" Spacing="2"
                                     IsVisible="{Binding Formulario.TemPosicoes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" Style="{StaticResource Secundario}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="12" Margin="0,16,0,0">
                    <Button Text="+ Novo território abaixo deste" Style="{StaticResource BotaoSecundario}" Command="{Binding NovoAbaixoCommand}"
                            IsVisible="{Binding PodeCriarAbaixo}" IsEnabled="{Binding Livre}" />
                    <Button Text="Encerrar território" Style="{StaticResource BotaoSecundario}" Command="{Binding EncerrarCommand}"
                            IsVisible="{Binding PodeEncerrar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar território" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
