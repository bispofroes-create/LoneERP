<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             xmlns:cf="clr-namespace:Lone.Domain.Pessoas;assembly=Lone.Domain"
             x:Class="Lone.App.Views.Pessoas.SecaoEnderecosView"
             x:DataType="pes:PessoasViewModel">
    <VerticalStackLayout Spacing="8">
        <!-- Remover um endereço já gravado só desativa (fica no histórico; volta em "Mostrar inativos"). -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label Text="Cada endereço físico uma vez só, com as finalidades (entrega, cobrança...). Para cada finalidade, um endereço pode ser o principal."
                   Style="{StaticResource Secundario}" VerticalOptions="Center" LineBreakMode="WordWrap" />
            <c:CaixaMarcar Grid.Column="1" Texto="Mostrar inativos" Marcado="{Binding Formulario.MostrarEnderecosInativos}"
                           IsVisible="{Binding Formulario.TemEnderecosInativos}" VerticalOptions="Center" />
            <Button c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.AdicionarEndereco}" Grid.Column="2" Text="+ Adicionar endereço" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding AdicionarEnderecoCommand}" />
        </Grid>

        <!-- Revisão pedida pela migração: o motivo por finalidade. Some quando tudo estiver resolvido. -->
        <Border Style="{StaticResource CartaoItem}" Stroke="{StaticResource Aviso}" IsVisible="{Binding Formulario.TemPendenciasRevisao}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Revisão de endereços necessária" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.PendenciasRevisao}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Duplicados já gravados: consolidação assistida (nada é juntado sem confirmar; nada é apagado). -->
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.DuplicadosGravados}" Spacing="6"
                             IsVisible="{Binding Formulario.TemDuplicadosGravados}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:ParDeEnderecos">
                    <Border Style="{StaticResource CartaoItem}" Stroke="{StaticResource Aviso}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                            <Label Text="{Binding TextoA}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding TextoB}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                            <c:BlocoCampos>
                                <Button Text="Consolidar mantendo o 1º" Style="{StaticResource BotaoSecundario}" Command="{Binding ManterPrimeiroCommand}" Margin="0,0,8,4" />
                                <Button Text="Consolidar mantendo o 2º" Style="{StaticResource BotaoSecundario}" Command="{Binding ManterSegundoCommand}" Margin="0,0,8,4" />
                                <Button Text="Manter separados" Style="{StaticResource BotaoLink}" Command="{Binding ManterSeparadosCommand}" />
                            </c:BlocoCampos>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Enderecos}">
            <BindableLayout.EmptyView>
                <Label Text="Nenhum endereço." Style="{StaticResource Secundario}" Margin="0,8" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:EnderecoFormulario">
                    <Border Style="{StaticResource CartaoItem}" IsVisible="{Binding Visivel}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Resumo}" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Button Grid.Column="1" Text="Remover" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}"
                                        IsVisible="{Binding Ativo}" />
                                <Button Grid.Column="2" Text="Reativar" Style="{StaticResource BotaoLink}" Command="{Binding ReativarCommand}"
                                        IsVisible="{Binding PodeReativar}" />
                            </Grid>
                            <Label Text="Inativo (removido): continua gravado para o histórico. Ao reativar, volta sem principal." Style="{StaticResource Secundario}"
                                   TextColor="{StaticResource Aviso}" IsVisible="{Binding PodeReativar}" />
                            <Label Text="Consolidado em outro endereço: fica no histórico e não volta (use o endereço mantido)." Style="{StaticResource Secundario}"
                                   TextColor="{StaticResource Aviso}" IsVisible="{Binding Consolidado}" />

                            <!-- Revisão deixada pela migração: o usuário confere e marca como revisado (ação explícita). -->
                            <Button Text="Marcar este endereço como revisado" Style="{StaticResource BotaoLink}" HorizontalOptions="Start"
                                    Command="{Binding MarcarRevisadoCommand}" IsVisible="{Binding TemRevisao}" />

                            <!-- Endereço novo igual a um existente: não cria outro; oferece usar o existente. -->
                            <Border Style="{StaticResource CartaoItem}" Stroke="{StaticResource Aviso}" IsVisible="{Binding TemDuplicidade}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding TextoDuplicidade}" LineBreakMode="WordWrap" />
                                    <c:BlocoCampos>
                                        <Button Text="{Binding TextoBotaoUsarExistente}" Style="{StaticResource BotaoSecundario}" Command="{Binding UsarExistenteCommand}" Margin="0,0,8,4" />
                                        <Button Text="Continuar com outro endereço" Style="{StaticResource BotaoLink}" Command="{Binding ContinuarComOutroCommand}"
                                                IsVisible="{Binding DuplicidadeIncerta}" />
                                        <Button Text="Cancelar" Style="{StaticResource BotaoLink}" Command="{Binding CancelarNovoCommand}"
                                                IsVisible="{Binding IgualAInativo}" />
                                    </c:BlocoCampos>
                                </VerticalStackLayout>
                            </Border>

                            <c:BlocoCampos>
                                <c:CampoEscolha Rotulo="Tipo" Itens="{Binding Tipos}" Selecionado="{Binding Tipo}" />
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.DescricaoEndereco}" c:Validacao.Item="{Binding Id}" Rotulo="Descrição (opcional)" Texto="{Binding Descricao}" TamanhoMaximo="60" Dica="Ex.: Depósito da Rua 2" />
                                <!-- CEP com o botão ao lado da caixa (a mensagem de erro aparece embaixo sem desalinhar o botão) e, logo
                                     depois da consulta, o aviso de CEP inexistente (a gravação também recusa). -->
                                <VerticalStackLayout FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Spacing="0">
                                    <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Cep}" c:Validacao.Item="{Binding Id}" Rotulo="CEP" Texto="{Binding Cep}" Mascara="Cep">
                                        <c:Campo.AoLado>
                                            <HorizontalStackLayout Spacing="4">
                                                <Button Text="Buscar CEP" Style="{StaticResource BotaoSecundario}" Command="{Binding BuscarCepCommand}"
                                                        ToolTipProperties.Text="Preenche logradouro, bairro e município a partir do CEP digitado (nada é gravado)" />
                                                <!-- Conferência pelo motor (F2): só consulta e mostra; usar a sugestão não salva. -->
                                                <Button Text="Conferir CEP" Style="{StaticResource BotaoSecundario}" Command="{Binding ConferirCepCommand}"
                                                        ToolTipProperties.Text="Confere se o CEP corresponde ao endereço digitado (logradouro, número, bairro e município) sem alterar nenhum campo (nada é gravado)" />
                                            </HorizontalStackLayout>
                                        </c:Campo.AoLado>
                                    </c:Campo>
                                    <Label Text="{Binding AvisoCep}" IsVisible="{Binding TemAvisoCep}" TextColor="{StaticResource Erro}" FontSize="12"
                                           LineBreakMode="WordWrap" Margin="0,-6,12,8" />
                                    <!-- Conferência gravada (F3): discreta; some quando há resultado na tela ou o endereço mudou. -->
                                    <Label Text="{Binding TextoEstadoCepGravado}" IsVisible="{Binding TemEstadoCepGravado}" FontSize="12"
                                           LineBreakMode="WordWrap" Margin="0,-6,12,4"
                                           TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding EstadoCepGravadoOk}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding EstadoCepGravadoAtencao}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <!-- Busca pelo endereço quando não se sabe o CEP (Checkpoint D): só candidatos; nada é aplicado sem escolher. -->
                                    <Button Text="Não sabe o CEP? Encontrar pelo endereço" Style="{StaticResource BotaoLink}" FontSize="12" Padding="0"
                                            HorizontalOptions="Start" Margin="0,-6,12,4" Command="{Binding BuscarCepPorEnderecoCommand}"
                                            ToolTipProperties.Text="Procura possíveis CEPs usando o endereço informado (UF, município e logradouro). Nenhum CEP é aplicado sem você escolher." />
                                    <!-- Resultado da conferência e os CEPs sugeridos: o usuário escolhe; vira alteração não salva.
                                         Ícone e cor pela gravidade (✓ verde, ⚠ âmbar, ✗ vermelho), no padrão do resumo da pessoa. -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding TemConferenciaCep}" Margin="0,-6,12,4">
                                        <Label Text="{Binding IconeConferenciaCep}" FontSize="12" FontAttributes="Bold" VerticalOptions="Start"
                                               TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding ConferenciaCepAlerta}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Erro}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding ConferenciaCepAtencao}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding ConferenciaCepOk}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Grid.Column="1" Text="{Binding TextoConferenciaCep}" FontSize="12" LineBreakMode="WordWrap" />
                                    </Grid>
                                    <!-- Detalhes por componente (CEP, UF, município, logradouro, número), recolhidos: a mensagem principal fica em cima. -->
                                    <VerticalStackLayout IsVisible="{Binding TemComponentesCep}" Spacing="2" Margin="0,0,12,4">
                                        <Button Text="{Binding TextoBotaoDetalhesCep}" Style="{StaticResource BotaoLink}" FontSize="12" Padding="0"
                                                HorizontalOptions="Start" Command="{Binding AlternarDetalhesCepCommand}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ComponentesCep}" IsVisible="{Binding MostrarDetalhesCep}" Spacing="2">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="pes:LinhaComponenteCep">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                                        <Label Text="{Binding Icone}" FontSize="12" FontAttributes="Bold" VerticalOptions="Start"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding EhAlerta}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource Erro}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding EhAtencao}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding EhOk}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label Grid.Column="1" Text="{Binding Texto}" FontSize="12" LineBreakMode="WordWrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                    <!-- Segunda opinião (Checkpoint G): discreta, só por pedido; compara duas fontes; nada é escolhido nem alterado. -->
                                    <Button Text="Consultar outra fonte" Style="{StaticResource BotaoLink}" FontSize="12" Padding="0" Margin="0,0,12,4"
                                            HorizontalOptions="Start" Command="{Binding ConsultarOutraFonteCommand}" IsVisible="{Binding PodeConsultarOutraFonte}" />
                                    <VerticalStackLayout IsVisible="{Binding TemSegundaOpiniao}" Spacing="2" Margin="0,0,12,4">
                                        <Label Text="{Binding TextoSegundaOpiniao}" FontSize="12" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding SegundaOpiniaoDivergente}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding SegundaOpiniaoConcordante}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ComparacaoFontes}" IsVisible="{Binding MostrarDetalhesCep}" Spacing="2">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="pes:LinhaComparacaoFontes">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                                        <Label Text="{Binding Icone}" FontSize="12" FontAttributes="Bold" VerticalOptions="Start"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding EhAtencao}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding EhOk}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label Grid.Column="1" Text="{Binding Texto}" FontSize="12" LineBreakMode="WordWrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CandidatosCep}" IsVisible="{Binding TemCandidatosCep}"
                                                         Spacing="2" Margin="0,0,12,8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="pes:OpcaoCandidatoCep">
                                                <VerticalStackLayout Spacing="0">
                                                    <Button Text="{Binding Texto}" Style="{StaticResource BotaoLink}" Command="{Binding UsarCommand}"
                                                            HorizontalOptions="Start" />
                                                    <!-- Por que este CEP ficou na lista (componentes da mesma avaliação); não é nota nem recomendação. -->
                                                    <Label Text="{Binding Detalhe}" IsVisible="{Binding TemDetalhe}" FontSize="11" LineBreakMode="WordWrap"
                                                           Margin="0,-4,0,2"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Logradouro}" c:Validacao.Item="{Binding Id}" Rotulo="Logradouro" Texto="{Binding Logradouro}" TamanhoMaximo="150" FlexLayout.Basis="100%" />
                                <!-- "Sem número": marcada, o número fica "S/N" (travado), o texto que vai para a NF-e (o número é obrigatório nela).
                                     Texto que não parece número ("casa", "x", "0"): dica para marcar (não é erro). -->
                                <VerticalStackLayout FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Spacing="0">
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Numero}" c:Validacao.Item="{Binding Id}" Rotulo="Número" Texto="{Binding Numero}" TamanhoMaximo="10"
                                         SomenteLeitura="{Binding SemNumero}">
                                    <c:Campo.AoLado>
                                        <HorizontalStackLayout Spacing="0" ToolTipProperties.Text="Endereço sem número: fica &quot;S/N&quot; (é o que vai na nota fiscal)">
                                            <CheckBox IsChecked="{Binding SemNumero}" VerticalOptions="Center" SemanticProperties.Description="Sem número" />
                                            <Label Text="Sem número" VerticalOptions="Center" FontSize="13" Margin="0,0,4,0">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding AlternarSemNumeroCommand}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </c:Campo.AoLado>
                                </c:Campo>
                                <HorizontalStackLayout IsVisible="{Binding SugerirSemNumero}" Spacing="4" Margin="0,-6,12,8">
                                    <Label Text="Este endereço não tem número?" FontSize="12" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Informacao}, Dark={StaticResource PrimariaEscuro}}" />
                                    <Button Text="Marcar &quot;Sem número&quot;" Style="{StaticResource BotaoLink}" FontSize="12" Padding="0"
                                            VerticalOptions="Center" Command="{Binding MarcarSemNumeroCommand}" />
                                </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Complemento}" c:Validacao.Item="{Binding Id}" Rotulo="Complemento" Texto="{Binding Complemento}" TamanhoMaximo="60" />
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Bairro}" c:Validacao.Item="{Binding Id}" Rotulo="Bairro" Texto="{Binding Bairro}" TamanhoMaximo="80" />
                                <c:CaixaMarcar Texto="Endereço no exterior" Marcado="{Binding NoExterior}" VerticalOptions="Center" />
                            </c:BlocoCampos>

                            <!-- Brasil: UF e município da tabela do IBGE (o CEP já preenche). -->
                            <Border Style="{StaticResource CartaoItem}" IsVisible="{Binding TemMunicipioACorrigir}" Stroke="{StaticResource Aviso}">
                                <Label Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
                                       Text="{Binding MunicipioACorrigir, StringFormat='Cidade informada antes: {0}. Escolha a UF e o município na lista para corrigir.'}" />
                            </Border>
                            <ContentView IsVisible="{Binding NoBrasil}">
                                <!-- Mesma largura de um campo de meia linha do bloco (um terço com largura de sobra). -->
                                <c:BlocoCampos>
                                    <c:CampoMunicipio c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Municipio}" c:Validacao.Item="{Binding Id, Source={RelativeSource AncestorType={x:Type pes:EnderecoFormulario}}, x:DataType=pes:EnderecoFormulario}" Rotulo="Município" BindingContext="{Binding Municipio}"
                                                      FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Margin="0,0,12,8" />
                                </c:BlocoCampos>
                            </ContentView>

                            <!-- Exterior: cidade e país digitados (fora da tabela do IBGE). -->
                            <c:BlocoCampos IsVisible="{Binding NoExterior}">
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Cidade}" c:Validacao.Item="{Binding Id}" Rotulo="Cidade" Texto="{Binding Cidade}" TamanhoMaximo="80" />
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Pais}" c:Validacao.Item="{Binding Id}" Rotulo="País" Texto="{Binding Pais}" TamanhoMaximo="60" />
                                <c:Campo Rotulo="Código do país (Bacen)" Texto="{Binding CodigoPais}" TamanhoMaximo="4" Mascara="Numero" />
                            </c:BlocoCampos>

                            <!-- Finalidades: cada uma pode ser a principal da pessoa para aquele uso. -->
                            <Label Text="Finalidades" Style="{StaticResource Rotulo}" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Finalidades}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pes:FinalidadeNoEndereco">
                                        <Border IsVisible="{Binding Ativo}" Padding="10,4" Margin="0,0,8,6" StrokeShape="RoundRectangle 14"
                                                Stroke="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Texto}" VerticalOptions="Center" />
                                                <Button Text="{Binding TextoBotaoPrincipal}" Style="{StaticResource BotaoLink}" Padding="4,0"
                                                        Command="{Binding AlternarPrincipalCommand}" />
                                                <Button Text="×" Style="{StaticResource BotaoLink}" Padding="4,0" Command="{Binding RemoverCommand}"
                                                        SemanticProperties.Description="Retirar a finalidade" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Label Text="Sem finalidade: escolha para que este endereço serve." Style="{StaticResource Secundario}"
                                   IsVisible="{Binding SemFinalidades}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding PodeEditarFinalidades}" MaximumWidthRequest="520" HorizontalOptions="Start">
                                <c:CampoEscolha Rotulo="Adicionar finalidade" Itens="{Binding OpcoesFinalidade}" Selecionado="{Binding FinalidadeEscolhida}" Padding="0" />
                                <Button Grid.Column="1" Text="+ Adicionar" Style="{StaticResource BotaoSecundario}" VerticalOptions="End"
                                        Command="{Binding AdicionarFinalidadeCommand}" />
                            </Grid>
                            <Label Text="{Binding AvisoFinalidade}" IsVisible="{Binding TemAvisoFinalidade}" TextColor="{StaticResource Aviso}"
                                   LineBreakMode="WordWrap" />
                            <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.ObservacoesEndereco}" c:Validacao.Item="{Binding Id}" Rotulo="Observações (opcional)" Texto="{Binding Observacoes}" TamanhoMaximo="250" Dica="Ex.: entrega só pela manhã, portão lateral" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
