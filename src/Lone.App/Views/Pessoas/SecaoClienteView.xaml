<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.Pessoas.SecaoClienteView"
             x:DataType="pes:PessoasViewModel">
    <VerticalStackLayout Spacing="8">
        <Label Text="Cliente" Style="{StaticResource Subtitulo}" />
        <Label Text="Condições de venda que valem para todas as empresas do grupo. Mudar crédito exige a permissão &quot;Alterar limite de crédito&quot;."
               Style="{StaticResource Secundario}" />
        <c:BlocoCampos>
            <c:Campo Rotulo="Limite de crédito (R$)" Texto="{Binding Formulario.ContaCliente.LimiteCredito}" Dica="Vazio = sem limite" />
            <c:Campo Rotulo="Dias máximos de atraso" Texto="{Binding Formulario.ContaCliente.DiasMaximoAtraso}" Teclado="Numeric" />
            <c:Campo Rotulo="Desconto máximo (%)" Texto="{Binding Formulario.ContaCliente.DescontoMaximo}" />
            <c:CampoEscolha Rotulo="Perfil comercial" Itens="{Binding Formulario.ContaCliente.Perfis}" Selecionado="{Binding Formulario.ContaCliente.Perfil}"
                            IsEnabled="{Binding Formulario.OpcoesComercialCarregadas}" />
            <c:CampoEscolha Rotulo="Condição de pagamento" Itens="{Binding Formulario.ContaCliente.Condicoes}" Selecionado="{Binding Formulario.ContaCliente.Condicao}"
                            IsEnabled="{Binding Formulario.OpcoesComercialCarregadas}" />
            <c:CaixaMarcar Texto="Vender acima do limite só com aprovação" Marcado="{Binding Formulario.ContaCliente.ExigeAprovacaoAcimaLimite}"
                           FlexLayout.Basis="100%" />
            <c:Campo Rotulo="Observações" Texto="{Binding Formulario.ContaCliente.Observacoes}" FlexLayout.Basis="100%" />
        </c:BlocoCampos>
        <!-- Texto antigo da condição: guardado, só leitura (igual ao fornecedor). -->
        <Label Text="{Binding Formulario.ContaCliente.TextoCondicaoAnterior}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
               IsVisible="{Binding Formulario.ContaCliente.TemCondicaoAnterior}" />
        <Label Text="{Binding Formulario.ResumoComercial}" FontAttributes="Bold" LineBreakMode="WordWrap" />
        <Label Text="Os campos acima valem onde o perfil não define; uma exceção vigente vale acima do perfil."
               Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

        <!-- Exceções comerciais: sobrescrevem só o que for informado, durante o período. Gravadas não são apagadas. -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <Label Text="Exceções comerciais" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="+ Adicionar exceção" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarExcecaoCommand}" />
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Excecoes}" Spacing="6">
            <BindableLayout.EmptyView>
                <Label Text="Nenhuma exceção." Style="{StaticResource Secundario}" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:ExcecaoComercialFormulario">
                    <Border Style="{StaticResource CartaoItem}">
                        <VerticalStackLayout>
                            <c:BlocoCampos>
                                <c:CampoEscolha Rotulo="Empresa" Itens="{Binding Empresas}" Selecionado="{Binding Empresa}" />
                                <c:Campo Rotulo="Início" Texto="{Binding InicioEm}" Dica="dd/mm/aaaa" Mascara="Data" />
                                <c:Campo Rotulo="Fim" Texto="{Binding FimEm}" Dica="vazio = sem fim" Mascara="Data" />
                                <c:Campo Rotulo="Limite de crédito (R$)" Texto="{Binding LimiteCredito}" Dica="vazio = não muda" />
                                <c:Campo Rotulo="Desconto máximo (%)" Texto="{Binding DescontoMaximo}" Dica="vazio = não muda" />
                                <c:Campo Rotulo="Dias máximos de atraso" Texto="{Binding DiasMaximoAtraso}" Teclado="Numeric" Dica="vazio = não muda" />
                                <c:CampoEscolha Rotulo="Condição de pagamento" Itens="{Binding Condicoes}" Selecionado="{Binding Condicao}" />
                                <c:CampoEscolha Rotulo="Aprovação acima do limite" Itens="{Binding ListaSimNao}" Selecionado="{Binding ExigeAprovacao}" />
                                <c:Campo Rotulo="Motivo" Texto="{Binding Motivo}" FlexLayout.Basis="100%" Dica="Ex.: campanha de março" />
                            </c:BlocoCampos>
                            <Button Text="Remover" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}" IsVisible="{Binding PodeRemover}"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Territórios (Fase 2b-1b): o território de hoje em cada mapa, desde quando e por quê (regra e versão, ou exceção). Só leitura. -->
        <VerticalStackLayout Spacing="4" IsVisible="{Binding MostrarTerritorios}" Margin="0,8,0,0">
            <Label Text="Territórios" Style="{StaticResource Subtitulo}" />
            <Label Text="Definidos pelas regras e exceções de cada mapa; mudam só por operação territorial." Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TerritoriosDoCliente}" Spacing="2">
                <BindableLayout.EmptyView>
                    <Label Text="Em nenhum território hoje." Style="{StaticResource Secundario}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" LineBreakMode="WordWrap" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Carteira de clientes (Motor Comercial, Fase 1b): quem atende este cliente, por papel comercial, com vigência.
             O vendedor vigente do papel "responsável da conta" vira o vendedor padrão. Em cima, o que vale hoje (e o que
             começa depois, e os novos); embaixo, recolhido, o histórico. Vínculo que já começou não muda: "Trocar". -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Carteira (quem atende)" Style="{StaticResource Subtitulo}" />
                <Label Text="Um vínculo por papel comercial. Para mudar quem atende a partir de uma data, use &quot;Trocar&quot; no vínculo: o atual fica no histórico."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Adicionar papel" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarCarteiraCommand}"
                    VerticalOptions="Start" ToolTipProperties.Text="Inclui alguém em outro papel (ex.: Representante, Supervisor)" />
        </Grid>
        <Label Text="Ninguém atende este cliente hoje." Style="{StaticResource Secundario}" IsVisible="{Binding Formulario.SemCarteiraAtual}" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.CarteiraAtual}" Spacing="6">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:CarteiraFormulario">
                    <Border Style="{StaticResource CartaoItem}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource Rotulo}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Situacao}" />
                                        <Span Text="  ·  " />
                                        <Span Text="{Binding Prazo}" FontAttributes="None" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!-- Perto do fim (antecedência nas configurações do Comercial): destaque para o usuário agir. -->
                            <Border IsVisible="{Binding PertoDoFim}" StrokeThickness="0" Padding="10,6"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AvisoFundo}, Dark={StaticResource AvisoFundoEscuro}}">
                                <Label Text="{Binding AvisoFim}" TextColor="{StaticResource Aviso}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            </Border>
                            <!-- Ausência de quem atende (cobertura vigente ou agendada): a carteira não muda. -->
                            <Label Text="{Binding AvisoCobertura}" IsVisible="{Binding TemCobertura}" Style="{StaticResource Secundario}"
                                   FontAttributes="Italic" LineBreakMode="WordWrap" />
                            <Label Text="{Binding TextoTroca}" Style="{StaticResource Secundario}" IsVisible="{Binding EhTroca}" LineBreakMode="WordWrap" />
                            <c:BlocoCampos>
                                <c:CampoEscolha Rotulo="Papel" Itens="{Binding Tipos}" Selecionado="{Binding Tipo}" IsEnabled="{Binding Editavel}" />
                                <c:CampoEscolha Rotulo="{Binding RotuloPessoa}" Itens="{Binding Vendedores}" Selecionado="{Binding Vendedor}" IsEnabled="{Binding Editavel}" />
                                <c:CampoEscolha Rotulo="Empresa" Itens="{Binding Empresas}" Selecionado="{Binding Empresa}" IsEnabled="{Binding Editavel}" />
                                <c:Campo Rotulo="Início" Texto="{Binding InicioEm}" Dica="dd/mm/aaaa" Mascara="Data" SomenteLeitura="{Binding Travado}" />
                                <c:Campo Rotulo="Fim" Texto="{Binding FimEm}" Dica="vazio = sem fim" Mascara="Data" />
                                <Label Text="O início não muda depois que o vínculo começa (o histórico fica). Para outra data, encerre este vínculo e inclua um novo."
                                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" FlexLayout.Basis="100%" IsVisible="{Binding Travado}" />
                                <c:Campo Rotulo="Crédito (%)" Texto="{Binding PercentualCredito}" Dica="{Binding DicaCredito}"
                                         Teclado="Numeric" IsVisible="{Binding RecebeCredito}" SomenteLeitura="{Binding Travado}" />
                                <c:CaixaMarcar Texto="Exclusivo (ninguém mais do mesmo papel no período)" Marcado="{Binding Exclusivo}" IsEnabled="{Binding Editavel}" />
                                <c:Campo Rotulo="Observação" Texto="{Binding Observacao}" FlexLayout.Basis="100%" />
                            </c:BlocoCampos>
                            <HorizontalStackLayout Spacing="16">
                                <Button Text="Trocar" Style="{StaticResource BotaoLink}" Command="{Binding TrocarCommand}" IsVisible="{Binding PodeTrocar}"
                                        ToolTipProperties.Text="Outra pessoa (ou outro crédito) a partir de uma data: este fica até a véspera, no histórico" />
                                <Button Text="{Binding TextoRemover}" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}" IsVisible="{Binding Ativo}" />
                                <Button Text="Reativar" Style="{StaticResource BotaoLink}" Command="{Binding ReativarCommand}" IsVisible="{Binding Inativo}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Histórico: encerrados e lançados por engano (só fim, observação e "ativo" mudam). -->
        <Button Text="{Binding Formulario.TextoHistoricoCarteira}" Style="{StaticResource BotaoLink}" HorizontalOptions="Start"
                Command="{Binding Formulario.AlternarHistoricoCarteiraCommand}" IsVisible="{Binding Formulario.TemHistoricoCarteira}" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.CarteiraHistorico}" Spacing="6"
                             IsVisible="{Binding Formulario.MostrarHistoricoCarteira}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:CarteiraFormulario">
                    <Border Style="{StaticResource CartaoItem}" Opacity="0.85">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Situacao}" Style="{StaticResource Rotulo}" />
                            <c:BlocoCampos>
                                <c:CampoEscolha Rotulo="Papel" Itens="{Binding Tipos}" Selecionado="{Binding Tipo}" IsEnabled="{Binding Editavel}" />
                                <c:CampoEscolha Rotulo="{Binding RotuloPessoa}" Itens="{Binding Vendedores}" Selecionado="{Binding Vendedor}" IsEnabled="{Binding Editavel}" />
                                <c:CampoEscolha Rotulo="Empresa" Itens="{Binding Empresas}" Selecionado="{Binding Empresa}" IsEnabled="{Binding Editavel}" />
                                <c:Campo Rotulo="Início" Texto="{Binding InicioEm}" Mascara="Data" SomenteLeitura="{Binding Travado}" />
                                <c:Campo Rotulo="Fim" Texto="{Binding FimEm}" Dica="vazio = sem fim" Mascara="Data" />
                                <Label Text="O início não muda depois que o vínculo começa (o histórico fica). Para outra data, encerre este vínculo e inclua um novo."
                                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" FlexLayout.Basis="100%" IsVisible="{Binding Travado}" />
                                <c:Campo Rotulo="Crédito (%)" Texto="{Binding PercentualCredito}" IsVisible="{Binding RecebeCredito}" SomenteLeitura="{Binding Travado}" />
                                <c:CaixaMarcar Texto="Ativo (desmarcado = lançado por engano)" Marcado="{Binding Ativo}" />
                                <c:Campo Rotulo="Observação" Texto="{Binding Observacao}" FlexLayout.Basis="100%" />
                            </c:BlocoCampos>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
