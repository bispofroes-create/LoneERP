<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             xmlns:cf="clr-namespace:Lone.Domain.Pessoas;assembly=Lone.Domain"
             x:Class="Lone.App.Views.Pessoas.SecaoEstabelecimentosView"
             x:DataType="pes:PessoasViewModel">
    <VerticalStackLayout Spacing="8">
        <!-- Dados fiscais por CNPJ. Identidade da empresa (dados, grupo, sócios) fica na Identificação. -->
        <!-- PF e estrangeiro: só o que se aplica (regime, CNAE e SUFRAMA são de empresa). -->
        <Label Text="Dados fiscais desta pessoa. Marque &quot;Produtor rural&quot; quando ela tiver inscrição estadual de produtor."
               Style="{StaticResource Secundario}" LineBreakMode="WordWrap" IsVisible="{Binding Formulario.EhFisica}" />
        <Label Text="Dados fiscais desta pessoa no exterior." Style="{StaticResource Secundario}"
               IsVisible="{Binding Formulario.EhEstrangeiro}" />
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Formulario.EhJuridica}">
            <Label Text="Matriz e filiais desta empresa (mesma raiz de CNPJ). Cada CNPJ tem os seus dados fiscais; a filial pode ter endereço próprio. Filial gravada não é excluída: é desativada."
                   Style="{StaticResource Secundario}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="+ Adicionar filial" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding AdicionarEstabelecimentoCommand}" />
        </Grid>

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Estabelecimentos}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:EstabelecimentoFormulario">
                    <Border Style="{StaticResource CartaoItem}" IsVisible="{Binding MostrarNaFicha}">
                        <VerticalStackLayout Spacing="4">
                            <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" IsVisible="{Binding DaPessoaJuridica}" />
                                <HorizontalStackLayout Spacing="16" IsVisible="{Binding FilialDaPJ}">
                                    <Button Text="Tornar principal" Style="{StaticResource BotaoLink}" Command="{Binding TornarPrincipalCommand}"
                                            IsVisible="{Binding PodeTornarPrincipal}" />
                                    <Button Text="{Binding TextoRemover}" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}"
                                            IsVisible="{Binding PodeDesativar}" />
                                    <Button Text="Reativar" Style="{StaticResource BotaoLink}" Command="{Binding ReativarCommand}"
                                            IsVisible="{Binding PodeReativar}" />
                                </HorizontalStackLayout>
                            </FlexLayout>
                            <Label Text="{Binding TextoInativo}" Style="{StaticResource Secundario}" TextColor="{StaticResource Aviso}"
                                   LineBreakMode="WordWrap" IsVisible="{Binding PodeReativar}" />
                            <Label Text="{Binding TextoReceita}" Style="{StaticResource Secundario}" />

                            <c:BlocoCampos>
                                <!-- Filial: edita o próprio CNPJ, nome fantasia e natureza jurídica. -->
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Cnpj}" c:Validacao.Item="{Binding Id}" Rotulo="CNPJ" Texto="{Binding Cnpj}" Mascara="Cnpj"
                                         IsVisible="{Binding FilialDaPJ}" FlexLayout.Basis="100%">
                                    <!-- Ao lado da caixa: a mensagem de erro aparece embaixo sem desalinhar o botão. -->
                                    <c:Campo.AoLado>
                                        <Button Text="Consultar CNPJ" Style="{StaticResource BotaoSecundario}" Command="{Binding ConsultarCnpjCommand}" />
                                    </c:Campo.AoLado>
                                </c:Campo>
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.NomeFantasia}" c:Validacao.Item="{Binding Id}" Rotulo="Nome fantasia" Texto="{Binding NomeFantasia}" IsVisible="{Binding FilialDaPJ}" />
                                <!-- Filial: natureza jurídica da tabela (o contêiner mostra/esconde; a lista tem o próprio contexto). -->
                                <ContentView IsVisible="{Binding FilialDaPJ}" FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}"
                                             Padding="0,0,12,8">
                                    <c:CampoLista c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.NaturezaJuridica}" c:Validacao.Item="{Binding Id, Source={RelativeSource AncestorType={x:Type pes:EstabelecimentoFormulario}}, x:DataType=pes:EstabelecimentoFormulario}" Rotulo="Natureza jurídica" BindingContext="{Binding NaturezaJuridicaLista}" />
                                </ContentView>
                                <!-- Principal: um só ponto de edição (Identificação); aqui só leitura. -->
                                <c:Campo Rotulo="Nome fantasia" Texto="{Binding NomeFantasia, Mode=OneWay}" SomenteLeitura="True"
                                         IsVisible="{Binding PrincipalDaPJ}" />
                                <c:Campo Rotulo="Natureza jurídica" Texto="{Binding NaturezaJuridicaTexto, Mode=OneWay}" SomenteLeitura="True"
                                         IsVisible="{Binding PrincipalDaPJ}" />
                                <Label Text="CNPJ, nome fantasia e natureza jurídica do principal são alterados na aba &quot;Identificação&quot;."
                                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" FlexLayout.Basis="100%"
                                       Margin="0,0,12,8" IsVisible="{Binding PrincipalDaPJ}" />
                                <!-- PF: produtor rural primeiro, porque decide o resto da aba. -->
                                <c:CaixaMarcar Texto="Produtor rural" Marcado="{Binding ProdutorRural}" IsVisible="{Binding DaPessoaFisica}"
                                               FlexLayout.Basis="100%" />
                                <Label Text="{Binding ResumoFiscal}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
                                       FlexLayout.Basis="100%" Margin="0,0,12,8" IsVisible="{Binding MostrarResumoFiscal}" />
                                <c:CampoEscolha c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.IndicadorIE}" c:Validacao.Item="{Binding Id}" Rotulo="Indicador de IE" Itens="{Binding IndicadoresIE}" Selecionado="{Binding IndicadorIE}"
                                                IsVisible="{Binding MostrarDadosIE}" />
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.InscricaoEstadual}" c:Validacao.Item="{Binding Id}" Rotulo="Inscrição estadual" Texto="{Binding InscricaoEstadual}" IsVisible="{Binding MostrarDadosIE}" />
                                <c:Campo Rotulo="Inscrição municipal" Texto="{Binding InscricaoMunicipal}" IsVisible="{Binding MostrarInscricaoMunicipal}" />
                                <!-- Só pessoa jurídica: SUFRAMA, regime e CNAE. -->
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Suframa}" c:Validacao.Item="{Binding Id}" Rotulo="Inscrição Suframa" Texto="{Binding InscricaoSuframa}" Teclado="Numeric"
                                         IsVisible="{Binding DaPessoaJuridica}" />
                                <c:CampoEscolha c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Regime}" c:Validacao.Item="{Binding Id}" Rotulo="Regime tributário" Itens="{Binding Regimes}" Selecionado="{Binding Regime}"
                                                IsVisible="{Binding DaPessoaJuridica}" />
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.Cnae}" c:Validacao.Item="{Binding Id}" Rotulo="CNAE principal" Texto="{Binding CnaePrincipal}" Teclado="Numeric" IsVisible="{Binding DaPessoaJuridica}" />
                                <Label Text="{Binding CnaePrincipalDescricao}" Style="{StaticResource Secundario}" VerticalOptions="Center"
                                       IsVisible="{Binding DaPessoaJuridica}" />
                                <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.CnaesSecundarios}" c:Validacao.Item="{Binding Id}" Rotulo="CNAEs secundários" Texto="{Binding CnaesSecundarios}" IsVisible="{Binding DaPessoaJuridica}"
                                         Dica="Códigos separados por vírgula" FlexLayout.Basis="100%" />
                                <c:CaixaMarcar Texto="Estabelecimento ativo" Marcado="{Binding Ativo}" IsVisible="{Binding DaPessoaJuridica}" />
                                <c:CaixaMarcar Texto="Produtor rural" Marcado="{Binding ProdutorRural}" IsVisible="{Binding DaPessoaJuridica}" />
                            </c:BlocoCampos>
                            <Button Text="+ Adicionar inscrição municipal" Style="{StaticResource BotaoLink}" HorizontalOptions="Start"
                                    Command="{Binding AdicionarInscricaoMunicipalCommand}" IsVisible="{Binding PodeAdicionarInscricaoMunicipal}" />

                            <!-- PF/estrangeiro com regime, CNAE ou SUFRAMA gravados: leitura até o usuário remover (vale ao salvar). -->
                            <VerticalStackLayout IsVisible="{Binding TemDadosDeEmpresa}" Spacing="2">
                                <Label Text="{Binding TituloDadosDeEmpresa}" Style="{StaticResource Rotulo}" />
                                <Label Text="São dados de empresa gravados neste cadastro. Continuam gravados até você removê-los."
                                       Style="{StaticResource Secundario}" TextColor="{StaticResource Aviso}" LineBreakMode="WordWrap" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DadosDeEmpresa}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="Remover estes dados" Style="{StaticResource BotaoLink}" HorizontalOptions="Start"
                                        Command="{Binding RemoverDadosDeEmpresaCommand}" />
                            </VerticalStackLayout>

                            <!-- Histórico fiscal (mantido pelo servidor): regime, IE e situação por período. -->
                            <VerticalStackLayout IsVisible="{Binding TemHistoricoFiscal}" Spacing="2">
                                <Label Text="Histórico fiscal" Style="{StaticResource Rotulo}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding HistoricoFiscal}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Filial: endereço fiscal próprio ou o principal da pessoa. -->
                            <VerticalStackLayout IsVisible="{Binding FilialDaPJ}" Spacing="2">
                                <c:CampoEscolha c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.EnderecoFiscal}" c:Validacao.Item="{Binding Id}" Rotulo="Endereço fiscal da filial" Itens="{Binding EnderecosDisponiveis}"
                                                Selecionado="{Binding EnderecoFiscal}" Dica="Endereço principal da pessoa" />
                                <Button Text="Usar o endereço principal da pessoa" Style="{StaticResource BotaoLink}"
                                        Command="{Binding UsarEnderecoPrincipalCommand}" IsVisible="{Binding TemEnderecoProprio}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
