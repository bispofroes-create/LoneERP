<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             xmlns:pv="clr-namespace:Lone.App.Views.Pessoas"
             x:Class="Lone.App.Views.Pessoas.SecaoDocumentosView"
             x:DataType="pes:PessoasViewModel">
    <!-- Campos personalizados do tipo de documento: os mesmos controles da aba "Informações adicionais". -->
    <ContentView.Resources>
        <DataTemplate x:Key="ModeloTexto" x:DataType="cad:CampoPersonalizadoFormulario">
            <c:Campo Rotulo="{Binding Rotulo}" Texto="{Binding Texto}" Dica="{Binding Dica}" Mascara="{Binding Mascara}" />
        </DataTemplate>
        <DataTemplate x:Key="ModeloTextoLongo" x:DataType="cad:CampoPersonalizadoFormulario">
            <VerticalStackLayout Spacing="2" FlexLayout.Basis="100%" Padding="0,0,12,8">
                <Label Text="{Binding Rotulo}" Style="{StaticResource Rotulo}" />
                <Editor Text="{Binding Texto}" Placeholder="{Binding Dica}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="ModeloEscolha" x:DataType="cad:CampoPersonalizadoFormulario">
            <c:CampoEscolha Rotulo="{Binding Rotulo}" Itens="{Binding Opcoes}" Selecionado="{Binding Escolha}" />
        </DataTemplate>
        <pv:SeletorModeloCampo x:Key="SeletorModelo"
                               Texto="{StaticResource ModeloTexto}"
                               TextoLongo="{StaticResource ModeloTextoLongo}"
                               Escolha="{StaticResource ModeloEscolha}" />
    </ContentView.Resources>
    <VerticalStackLayout Spacing="8">
        <!-- Documento principal (CPF/CNPJ/identificação estrangeira): uma linha; um só ponto de edição, na Identificação. -->
        <Label Text="{Binding Formulario.DocumentoPrincipalResumo}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

        <!-- Remover um documento já gravado só desativa (fica no histórico; volta em "Mostrar inativos"). -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label Text="Outros documentos: RG, CNH, passaporte, alvará, contrato social... Os tipos ficam em Configurações, &quot;Tipos de documento&quot;."
                   Style="{StaticResource Secundario}" VerticalOptions="Center" />
            <c:CaixaMarcar Grid.Column="1" Texto="Mostrar inativos" Marcado="{Binding Formulario.MostrarDocumentosInativos}"
                           IsVisible="{Binding Formulario.TemDocumentosInativos}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="+ Adicionar documento" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding AdicionarDocumentoCommand}" />
        </Grid>
        <Label Text="{Binding Formulario.AvisoDocumentos}" TextColor="{StaticResource Aviso}" FontAttributes="Bold"
               IsVisible="{Binding Formulario.TemAvisoDocumentos}" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Documentos}">
            <BindableLayout.EmptyView>
                <Label Text="Nenhum documento." Style="{StaticResource Secundario}" Margin="0,8" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:DocumentoFormulario">
                    <Border Style="{StaticResource CartaoItem}" IsVisible="{Binding Visivel}">
                        <VerticalStackLayout>
                            <Label Text="Inativo (removido): continua gravado para o histórico." Style="{StaticResource Secundario}"
                                   TextColor="{StaticResource Aviso}" IsVisible="{Binding Inativo}" />
                            <Label Text="{Binding AvisoValidade}" TextColor="{StaticResource Aviso}" FontAttributes="Bold"
                                   IsVisible="{Binding TemAvisoValidade}" />
                            <c:BlocoCampos>
                                <c:CampoEscolha Rotulo="Tipo" Itens="{Binding Tipos}" Selecionado="{Binding Tipo}" />
                                <c:Campo Rotulo="Número" Texto="{Binding Numero}" />
                                <!-- Só nos documentos pessoais (RG, CNH, passaporte...) ou quando já preenchidos. -->
                                <c:Campo Rotulo="Órgão emissor" Texto="{Binding OrgaoEmissor}" IsVisible="{Binding MostrarOrgaoEmissor}" />
                                <c:Campo Rotulo="UF" Texto="{Binding Uf}" IsVisible="{Binding MostrarUf}" />
                                <c:Campo Rotulo="Emitido em" Texto="{Binding EmitidoEm}" Dica="dd/mm/aaaa" Mascara="Data" />
                                <c:Campo Rotulo="{Binding RotuloValidade}" Texto="{Binding ValidoAte}" Dica="dd/mm/aaaa" Mascara="Data" />
                                <c:Campo Rotulo="Observações" Texto="{Binding Observacoes}" FlexLayout.Basis="100%" />
                            </c:BlocoCampos>
                            <c:BlocoCampos IsVisible="{Binding TemCamposPersonalizados}"
                                        BindableLayout.ItemsSource="{Binding CamposPersonalizados}"
                                        BindableLayout.ItemTemplateSelector="{StaticResource SeletorModelo}" />
                            <!-- Anexos: enviados e removidos na hora (não dependem do Salvar da ficha). -->
                            <Label Text="Anexos" Style="{StaticResource Rotulo}" Margin="0,6,0,0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Anexos}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pes:AnexoFormulario">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding Visivel}">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding NomeArquivo}" LineBreakMode="MiddleTruncation" />
                                                <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Abrir" Style="{StaticResource BotaoLink}" Command="{Binding AbrirCommand}" />
                                            <Button Grid.Column="2" Text="Remover" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}"
                                                    IsVisible="{Binding Ativo}" />
                                            <Button Grid.Column="3" Text="Reativar" Style="{StaticResource BotaoLink}" Command="{Binding ReativarCommand}"
                                                    IsVisible="{Binding Inativo}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding DicaAnexos}" Style="{StaticResource Secundario}" />
                            <HorizontalStackLayout Spacing="12">
                                <Button Text="Anexar arquivo" Style="{StaticResource BotaoLink}" Command="{Binding AnexarCommand}"
                                        IsVisible="{Binding PodeAnexar}" />
                                <Button Text="Remover" Style="{StaticResource BotaoLink}" Command="{Binding RemoverCommand}"
                                        IsVisible="{Binding Ativo}" />
                                <Button Text="Reativar" Style="{StaticResource BotaoLink}" Command="{Binding ReativarCommand}"
                                        IsVisible="{Binding Inativo}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
