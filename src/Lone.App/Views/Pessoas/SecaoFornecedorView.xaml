<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             xmlns:cf="clr-namespace:Lone.Domain.Pessoas;assembly=Lone.Domain"
             x:Class="Lone.App.Views.Pessoas.SecaoFornecedorView"
             x:DataType="pes:PessoasViewModel">
    <!-- Bloco próprio, abaixo do Cliente: a mesma pessoa pode ser cliente e fornecedor (um cadastro só). -->
    <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
        <Label Text="Fornecedor" Style="{StaticResource Subtitulo}" />
        <Label Text="Condições de compra que valem para todas as empresas do grupo." Style="{StaticResource Secundario}" />
        <c:BlocoCampos>
            <!-- Condição do cadastro de condições de pagamento (o texto antigo fica guardado, só leitura). -->
            <c:CampoEscolha Rotulo="Condição de pagamento" Itens="{Binding Formulario.ContaFornecedor.Condicoes}"
                            Selecionado="{Binding Formulario.ContaFornecedor.Condicao}" IsEnabled="{Binding Formulario.OpcoesComercialCarregadas}" />
            <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.PrazosFornecedor}" Rotulo="Prazo médio de pagamento (dias)" Texto="{Binding Formulario.ContaFornecedor.PrazoMedioDias}" Teclado="Numeric" />
            <c:Campo Rotulo="Prazo de entrega (dias)" Texto="{Binding Formulario.ContaFornecedor.LeadTimeDias}" Teclado="Numeric" />
            <c:Campo c:Validacao.Campo="{x:Static cf:CamposFichaPessoa.AvaliacaoFornecedor}" Rotulo="Avaliação (1 a 5)" Texto="{Binding Formulario.ContaFornecedor.Avaliacao}" Teclado="Numeric" Dica="Vazio = sem avaliação" />
            <c:Campo Rotulo="Observações" Texto="{Binding Formulario.ContaFornecedor.Observacoes}" FlexLayout.Basis="100%" />
        </c:BlocoCampos>
        <Label Text="{Binding Formulario.ContaFornecedor.TextoCondicaoAnterior}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
               IsVisible="{Binding Formulario.ContaFornecedor.TemCondicaoAnterior}" />
    </VerticalStackLayout>
</ContentView>
