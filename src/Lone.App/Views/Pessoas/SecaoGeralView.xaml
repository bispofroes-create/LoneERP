<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:dto="clr-namespace:Lone.Contracts.Pessoas;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.Pessoas.SecaoGeralView"
             x:DataType="pes:PessoasViewModel">
    <!-- Identificação em grupos (dados principais · empresa · papéis · etiquetas · observações), separados por título e
         traço fino dentro da mesma superfície. Papéis e etiquetas: a ficha mostra só o que a pessoa tem (padrão do Lone:
         o cadastro auxiliar oferece as opções; a ficha mostra as utilizadas). -->
    <VerticalStackLayout Spacing="8">
        <Label Text="Dados principais" Style="{StaticResource SecaoTitulo}" />
        <FlexLayout Wrap="Wrap">
            <c:CampoEscolha Rotulo="Natureza" Itens="{Binding Formulario.Naturezas}" Selecionado="{Binding Formulario.Natureza}" />
            <c:Campo Rotulo="{Binding Formulario.RotuloNome}" Texto="{Binding Formulario.Nome}" FlexLayout.Basis="100%" />
            <!-- Razão social = identificação jurídica; nome fantasia = nome comercial; nome de exibição = o que o Lone mostra.
                 O nome fantasia é o do estabelecimento principal e só é editado aqui (o cartão do principal mostra como leitura). -->
            <c:Campo Rotulo="Nome fantasia (opcional)" Texto="{Binding Formulario.Principal.NomeFantasia}" FlexLayout.Basis="100%"
                     IsVisible="{Binding Formulario.EhJuridica}" Dica="Nome comercial" />
            <c:Campo Rotulo="{Binding Formulario.RotuloDocumento}" Texto="{Binding Formulario.Documento}"
                     Mascara="{Binding Formulario.MascaraDocumento}" IsVisible="{Binding Formulario.NaoEhJuridica}" />
            <!-- Data e idade lado a lado: a idade é calculada ao digitar. -->
            <Grid ColumnDefinitions="*,110" ColumnSpacing="8" IsVisible="{Binding Formulario.EhFisica}"
                  FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Padding="0,0,12,8">
                <c:Campo Rotulo="Data de nascimento" Dica="dd/mm/aaaa" Mascara="Data" Padding="0"
                         Texto="{Binding Formulario.DataNascimento}" />
                <c:Campo Grid.Column="1" Rotulo="Idade" SomenteLeitura="True" Padding="0"
                         Texto="{Binding Formulario.Idade, Mode=OneWay}" />
            </Grid>
            <c:Campo Rotulo="Nome social" Texto="{Binding Formulario.NomeSocial}" IsVisible="{Binding Formulario.EhFisica}"
                     Dica="Como a pessoa quer ser chamada; aparece nas listas no lugar do nome civil" />
            <c:Campo Rotulo="Apelido" Texto="{Binding Formulario.Apelido}" IsVisible="{Binding Formulario.EhFisica}" />
            <c:Campo Rotulo="Nome de exibição (opcional)" Texto="{Binding Formulario.NomeExibicao}" FlexLayout.Basis="100%" Padding="0,0,12,0" />
            <!-- Ajuda fixa (a dica do campo some ao digitar). A regra é a de NomePessoa.ParaExibir. -->
            <Label Text="{Binding Formulario.AjudaNomeExibicao}" Style="{StaticResource Secundario}"
                   FlexLayout.Basis="100%" Margin="0,2,12,8" />
        </FlexLayout>

        <!-- Pessoa jurídica: o CNPJ do estabelecimento principal, com a consulta à Receita (único ponto de edição dele). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Formulario.EhJuridica}">
            <!-- Sem teclado numérico: o CNPJ pode ter letras (CNPJ alfanumérico). -->
            <c:Campo Rotulo="CNPJ do estabelecimento principal" Texto="{Binding Formulario.Principal.Cnpj}" Mascara="Cnpj" />
            <Button Grid.Column="1" Text="Consultar CNPJ" Style="{StaticResource BotaoSecundario}" VerticalOptions="End"
                    Margin="0,0,0,8" Command="{Binding Formulario.Principal.ConsultarCnpjCommand}" />
        </Grid>

        <!-- Pessoa jurídica: identidade da empresa (raiz do CNPJ), preenchida pela consulta à Receita. -->
        <VerticalStackLayout IsVisible="{Binding Formulario.EhJuridica}" Spacing="6">
            <BoxView Style="{StaticResource Separador}" />
            <Label Text="Empresa" Style="{StaticResource SecaoTitulo}" />
            <FlexLayout Wrap="Wrap">
                <c:Campo Rotulo="Data de abertura" Dica="dd/mm/aaaa" Mascara="Data" Texto="{Binding Formulario.DataAbertura}" />
                <c:Campo Rotulo="Porte" Texto="{Binding Formulario.Porte}" />
                <c:Campo Rotulo="Capital social (R$)" Texto="{Binding Formulario.CapitalSocial}" />
                <c:Campo Rotulo="Natureza jurídica" Texto="{Binding Formulario.Principal.NaturezaJuridica}" />
            </FlexLayout>

            <!-- Grupo empresarial (opcional): reúne esta empresa com outras independentes (CNPJs de outra raiz).
                 Não é matriz/filial. Mudar exige a permissão de estrutura empresarial. As opções são lidas quando esta aba abre. -->
            <c:CampoEscolha Rotulo="Grupo empresarial (opcional)" Itens="{Binding Formulario.GruposEmpresariais}"
                            Selecionado="{Binding Formulario.GrupoEmpresarial}" IsEnabled="{Binding PodeAlterarEstruturaEmpresarial}"
                            MaximumWidthRequest="520" HorizontalOptions="Start" />
            <Label Text="Empresas independentes (outro CNPJ) nunca são filiais: cada uma é um cadastro próprio. Para vê-las juntas, use um grupo empresarial (menu &quot;Grupos empresariais&quot;). Matriz e filiais ficam na aba &quot;Fiscal e estabelecimentos&quot;; vínculos com sócios e administradores cadastrados no Lone, na aba &quot;Relacionamentos&quot;."
                   Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            <!-- Sócios da Receita (lidos na consulta do CNPJ; só leitura). -->
            <VerticalStackLayout IsVisible="{Binding Formulario.TemSocios}" Spacing="4">
                <Label Text="Sócios e administradores (Receita Federal)" Style="{StaticResource Rotulo}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Socios}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:SocioDto">
                            <Label LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Nome}" FontAttributes="Bold" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Qualificacao}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- ===== PAPÉIS: só os que a pessoa tem ou já teve (cartão com estado, período, interruptor e histórico).
             Os outros ficam em "Adicionar papel". O interruptor muda a ficha; o período é aberto/encerrado ao salvar. ===== -->
        <BoxView Style="{StaticResource Separador}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="0">
                <Label Text="Papéis" Style="{StaticResource SecaoTitulo}" />
                <Label Text="Como esta pessoa se relaciona com a empresa. Uma pessoa pode ter vários papéis ao mesmo tempo."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{Binding Formulario.PapeisFicha.TextoBotaoAdicionar}" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding Formulario.PapeisFicha.AlternarEscolhaCommand}" IsVisible="{Binding Formulario.PapeisFicha.PodeEditar}"
                    VerticalOptions="Start" />
        </Grid>

        <!-- Adicionar papel: mesmo padrão do painel "Filtros" da lista (abre na própria tela), com pesquisa. -->
        <Border Style="{StaticResource PainelConteudo}" Padding="16" IsVisible="{Binding Formulario.PapeisFicha.Escolhendo}">
            <VerticalStackLayout Spacing="8">
                <SearchBar Text="{Binding Formulario.PapeisFicha.Busca}" Placeholder="Pesquisar papel" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.PapeisFicha.Disponiveis}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pes:PapelOpcao">
                            <Grid ColumnDefinitions="*,Auto" Padding="12,8" SemanticProperties.Description="{Binding Nome}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Formulario.PapeisFicha.AdicionarCommand, Source={RelativeSource AncestorType={x:Type pes:PessoasViewModel}}, x:DataType=pes:PessoasViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor"
                                                            Value="{AppThemeBinding Light={StaticResource SuperficieRealce}, Dark={StaticResource SuperficieRealceEscuro}}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nome}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding Descricao}" IsVisible="{Binding TemDescricao}" Style="{StaticResource Secundario}" />
                                    <Label Text="{Binding Periodo}" Style="{StaticResource Secundario}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="+ Adicionar" FontSize="13" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding Formulario.PapeisFicha.TextoSemDisponiveis}" IsVisible="{Binding Formulario.PapeisFicha.SemDisponiveis}"
                       Style="{StaticResource Secundario}" Margin="12,4" />
            </VerticalStackLayout>
        </Border>

        <Label Text="Nenhum papel atribuído a esta pessoa." IsVisible="{Binding Formulario.PapeisFicha.Vazio}"
               Style="{StaticResource Secundario}" />

        <!-- Cartões: duas colunas no computador, uma no celular. Estado com texto e marca (● / ○), não só cor. -->
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.PapeisFicha.NaFicha}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:PapelOpcao">
                    <ContentView FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Padding="0,0,12,12">
                        <Border Style="{StaticResource CartaoPapel}">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Texto}" FontSize="15" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Descricao}" IsVisible="{Binding TemDescricao}" Style="{StaticResource Secundario}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Start">
                                        <Label Text="{Binding EstadoTexto}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Ativo}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Switch IsToggled="{Binding Ativo}" IsEnabled="{Binding Editavel}" VerticalOptions="Center"
                                                OnColor="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}"
                                                SemanticProperties.Description="{Binding DescricaoInterruptor}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Label Text="{Binding Periodo}" Style="{StaticResource Secundario}" />
                                <Button Text="{Binding TextoHistorico}" Style="{StaticResource BotaoLink}" FontSize="13"
                                        Command="{Binding AlternarHistoricoCommand}" IsVisible="{Binding TemHistorico}" />
                                <!-- Períodos reais gravados (início → fim). Quem alterou e o motivo: aba Histórico (auditoria). -->
                                <VerticalStackLayout IsVisible="{Binding MostrarHistorico}" Spacing="6" Margin="0,4,0,0">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historico}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="pes:PeriodoPapel">
                                                <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                                    <Label Text="{Binding Estado}" FontSize="13" />
                                                    <Label Grid.Column="1" Text="{Binding Intervalo}" FontSize="13" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Label Text="Quem alterou e o motivo ficam na aba Histórico." Style="{StaticResource Secundario}" FontSize="12" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <!-- ===== ETIQUETAS: classificação livre, sem período. Só as atribuídas, como chips; "×" tira ao salvar
             (a auditoria registra). As outras ficam em "Adicionar etiqueta". ===== -->
        <BoxView Style="{StaticResource Separador}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="0">
                <Label Text="Etiquetas" Style="{StaticResource SecaoTitulo}" />
                <Label Text="Classificações livres para agrupar e encontrar pessoas." Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{Binding Formulario.Etiquetas.TextoBotaoAdicionar}" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding Formulario.Etiquetas.AlternarEscolhaCommand}" IsVisible="{Binding Formulario.Etiquetas.PodeEditar}"
                    VerticalOptions="Start" />
        </Grid>

        <Border Style="{StaticResource PainelConteudo}" Padding="16" IsVisible="{Binding Formulario.Etiquetas.Escolhendo}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <SearchBar Text="{Binding Formulario.Etiquetas.Busca}" Placeholder="Pesquisar etiqueta" />
                    <Button Grid.Column="1" Text="Nova etiqueta" Style="{StaticResource BotaoTerciario}"
                            Command="{Binding NovaEtiquetaCommand}" IsVisible="{Binding PodeCriarEtiqueta}" IsEnabled="{Binding Livre}" />
                </Grid>
                <!-- Tocar numa etiqueta atribui; o painel fica aberto para escolher outras. -->
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.Etiquetas.Disponiveis}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pes:EtiquetaMarcavel">
                            <Border Style="{StaticResource Chip}" SemanticProperties.Description="{Binding Nome}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Formulario.Etiquetas.AdicionarCommand, Source={RelativeSource AncestorType={x:Type pes:PessoasViewModel}}, x:DataType=pes:PessoasViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Nome}" FontSize="13" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="{Binding Formulario.Etiquetas.TextoSemDisponiveis}" IsVisible="{Binding Formulario.Etiquetas.SemDisponiveis}"
                       Style="{StaticResource Secundario}" />
            </VerticalStackLayout>
        </Border>

        <Label Text="Nenhuma etiqueta atribuída." IsVisible="{Binding Formulario.Etiquetas.SemAtribuidas}" Style="{StaticResource Secundario}" />
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.Etiquetas.Atribuidas}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:EtiquetaMarcavel">
                    <Border Style="{StaticResource Chip}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Selecao}, Dark={StaticResource SelecaoEscuro}}">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Texto}" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
                            <Label Text="×" FontSize="15" VerticalOptions="Center" IsVisible="{Binding Removivel}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}"
                                   SemanticProperties.Description="{Binding DescricaoRemover}" ToolTipProperties.Text="{Binding DescricaoRemover}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Formulario.Etiquetas.RemoverCommand, Source={RelativeSource AncestorType={x:Type pes:PessoasViewModel}}, x:DataType=pes:PessoasViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <BoxView Style="{StaticResource Separador}" />
        <Label Text="Observações" Style="{StaticResource SecaoTitulo}" />
        <Editor Text="{Binding Formulario.Observacoes}" AutoSize="TextChanges" MinimumHeightRequest="80" />
    </VerticalStackLayout>
</ContentView>
