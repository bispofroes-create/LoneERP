<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:dto="clr-namespace:Lone.Contracts.Pessoas;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.Pessoas.SecaoGeralView"
             x:DataType="pes:PessoasViewModel">
    <VerticalStackLayout Spacing="8">
        <FlexLayout Wrap="Wrap">
            <c:CampoEscolha Rotulo="Natureza" Itens="{Binding Formulario.Naturezas}" Selecionado="{Binding Formulario.Natureza}" />
            <c:Campo Rotulo="{Binding Formulario.RotuloNome}" Texto="{Binding Formulario.Nome}" FlexLayout.Basis="100%" />
            <!-- Razão social = identificação jurídica; nome fantasia = nome comercial; nome de exibição = o que o Lone mostra.
                 O nome fantasia é o do estabelecimento principal e só é editado aqui (o cartão do principal mostra como leitura). -->
            <c:Campo Rotulo="Nome fantasia (opcional)" Texto="{Binding Formulario.Principal.NomeFantasia}" FlexLayout.Basis="100%"
                     IsVisible="{Binding Formulario.EhJuridica}" Dica="Nome comercial" />
            <c:Campo Rotulo="{Binding Formulario.RotuloDocumento}" Texto="{Binding Formulario.Documento}"
                     Mascara="{Binding Formulario.MascaraDocumento}" IsVisible="{Binding Formulario.NaoEhJuridica}" />
            <!-- Data e idade lado a lado: a idade é calculada ao digitar. -->
            <Grid ColumnDefinitions="*,110" ColumnSpacing="8" IsVisible="{Binding Formulario.EhFisica}"
                  FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}" Padding="0,0,12,8">
                <c:Campo Rotulo="Data de nascimento" Dica="dd/mm/aaaa" Mascara="Data" Padding="0"
                         Texto="{Binding Formulario.DataNascimento}" />
                <c:Campo Grid.Column="1" Rotulo="Idade" SomenteLeitura="True" Padding="0"
                         Texto="{Binding Formulario.Idade, Mode=OneWay}" />
            </Grid>
            <c:Campo Rotulo="Nome social" Texto="{Binding Formulario.NomeSocial}" IsVisible="{Binding Formulario.EhFisica}"
                     Dica="Como a pessoa quer ser chamada; aparece nas listas no lugar do nome civil" />
            <c:Campo Rotulo="Apelido" Texto="{Binding Formulario.Apelido}" IsVisible="{Binding Formulario.EhFisica}" />
            <c:Campo Rotulo="Nome de exibição (opcional)" Texto="{Binding Formulario.NomeExibicao}" FlexLayout.Basis="100%" Padding="0,0,12,0" />
            <!-- Ajuda fixa (a dica do campo some ao digitar). A regra é a de NomePessoa.ParaExibir. -->
            <Label Text="{Binding Formulario.AjudaNomeExibicao}" Style="{StaticResource Secundario}"
                   FlexLayout.Basis="100%" Margin="0,2,12,8" />
        </FlexLayout>

        <!-- Pessoa jurídica: o CNPJ do estabelecimento principal, com a consulta à Receita (único ponto de edição dele). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Formulario.EhJuridica}">
            <!-- Sem teclado numérico: o CNPJ pode ter letras (CNPJ alfanumérico). -->
            <c:Campo Rotulo="CNPJ do estabelecimento principal" Texto="{Binding Formulario.Principal.Cnpj}" Mascara="Cnpj" />
            <Button Grid.Column="1" Text="Consultar CNPJ" Style="{StaticResource BotaoSecundario}" VerticalOptions="End"
                    Margin="0,0,0,8" Command="{Binding Formulario.Principal.ConsultarCnpjCommand}" />
        </Grid>

        <!-- Pessoa jurídica: identidade da empresa (raiz do CNPJ), preenchida pela consulta à Receita. -->
        <VerticalStackLayout IsVisible="{Binding Formulario.EhJuridica}" Spacing="6" Margin="0,8,0,0">
            <Label Text="Dados da empresa" Style="{StaticResource Subtitulo}" />
            <FlexLayout Wrap="Wrap">
                <c:Campo Rotulo="Data de abertura" Dica="dd/mm/aaaa" Mascara="Data" Texto="{Binding Formulario.DataAbertura}" />
                <c:Campo Rotulo="Porte" Texto="{Binding Formulario.Porte}" />
                <c:Campo Rotulo="Capital social (R$)" Texto="{Binding Formulario.CapitalSocial}" />
                <c:Campo Rotulo="Natureza jurídica" Texto="{Binding Formulario.Principal.NaturezaJuridica}" />
            </FlexLayout>

            <!-- Grupo empresarial (opcional): reúne esta empresa com outras independentes (CNPJs de outra raiz).
                 Não é matriz/filial. Mudar exige a permissão de estrutura empresarial. As opções são lidas quando esta aba abre. -->
            <c:CampoEscolha Rotulo="Grupo empresarial (opcional)" Itens="{Binding Formulario.GruposEmpresariais}"
                            Selecionado="{Binding Formulario.GrupoEmpresarial}" IsEnabled="{Binding PodeAlterarEstruturaEmpresarial}"
                            MaximumWidthRequest="520" HorizontalOptions="Start" />
            <Label Text="Empresas independentes (outro CNPJ) nunca são filiais: cada uma é um cadastro próprio. Para vê-las juntas, use um grupo empresarial (menu &quot;Grupos empresariais&quot;). Matriz e filiais ficam na aba &quot;Fiscal e estabelecimentos&quot;; vínculos com sócios e administradores cadastrados no Lone, na aba &quot;Relacionamentos&quot;."
                   Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            <!-- Sócios da Receita (lidos na consulta do CNPJ; só leitura). -->
            <VerticalStackLayout IsVisible="{Binding Formulario.TemSocios}" Spacing="4">
                <Label Text="Sócios e administradores (Receita Federal)" Style="{StaticResource Rotulo}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Socios}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:SocioDto">
                            <Label LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Nome}" FontAttributes="Bold" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Qualificacao}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Label Text="Papéis" Style="{StaticResource Subtitulo}" Margin="0,8,0,0" />
        <Label Text="O que esta pessoa é para a empresa. Um mesmo cadastro pode ser cliente e fornecedor. Desmarcar encerra o período (fica no histórico)."
               Style="{StaticResource Secundario}" />
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.Papeis}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:PapelOpcao">
                    <VerticalStackLayout FlexLayout.Basis="{OnIdiom Phone='50%', Default='25%'}" Margin="0,0,0,4">
                        <c:CaixaMarcar Texto="{Binding Texto}" Marcado="{Binding Ativo}" />
                        <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" Margin="32,-6,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <!-- Etiquetas do cadastro de etiquetas: marcar/desmarcar; a busca só filtra o que aparece. -->
        <Label Text="Etiquetas" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Text="{Binding Formulario.Etiquetas.Busca}" Placeholder="Buscar etiqueta" />
            <Button Grid.Column="1" Text="Nova etiqueta" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding NovaEtiquetaCommand}" IsVisible="{Binding PodeCriarEtiqueta}" IsEnabled="{Binding Livre}" />
        </Grid>
        <Label Text="{Binding Formulario.Etiquetas.Resumo}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
        <Label Text="Nenhuma etiqueta cadastrada ainda. Quem gerencia etiquetas pode criá-las no menu Etiquetas."
               Style="{StaticResource Secundario}" LineBreakMode="WordWrap" IsVisible="{Binding Formulario.Etiquetas.Vazio}" />
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.Etiquetas.Visiveis}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:EtiquetaMarcavel">
                    <c:CaixaMarcar Texto="{Binding Texto}" Marcado="{Binding Marcada}"
                                   FlexLayout.Basis="{OnIdiom Phone='100%', Default='33%'}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Label Text="Observações" Style="{StaticResource Rotulo}" Margin="0,8,0,0" />
        <Editor Text="{Binding Formulario.Observacoes}" AutoSize="TextChanges" MinimumHeightRequest="80" />
    </VerticalStackLayout>
</ContentView>
