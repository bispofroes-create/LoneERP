<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:dto="clr-namespace:Lone.Contracts.Pessoas;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.Pessoas.SecaoRelacionamentoView"
             x:DataType="pes:PessoasViewModel">
    <VerticalStackLayout Spacing="8">
        <Label Text="Segmentação" Style="{StaticResource Subtitulo}" />
        <FlexLayout Wrap="Wrap">
            <c:CampoEscolha Rotulo="Como conheceu a empresa" Itens="{Binding Formulario.Origens}"
                            Selecionado="{Binding Formulario.OrigemCadastro}" />
            <c:Campo Rotulo="Primeiro contato" Dica="dd/mm/aaaa" Mascara="Data" Texto="{Binding Formulario.PrimeiroContatoEm}" />
        </FlexLayout>

        <!-- Etiquetas do cadastro de etiquetas: marcar/desmarcar; a busca só filtra o que aparece. -->
        <Label Text="Etiquetas" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Text="{Binding Formulario.Etiquetas.Busca}" Placeholder="Buscar etiqueta" />
            <Button Grid.Column="1" Text="Nova etiqueta" Style="{StaticResource BotaoSecundario}"
                    Command="{Binding NovaEtiquetaCommand}" IsVisible="{Binding PodeCriarEtiqueta}" IsEnabled="{Binding Livre}" />
        </Grid>
        <Label Text="{Binding Formulario.Etiquetas.Resumo}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
        <Label Text="Nenhuma etiqueta cadastrada ainda. Quem gerencia etiquetas pode criá-las no menu Etiquetas."
               Style="{StaticResource Secundario}" LineBreakMode="WordWrap" IsVisible="{Binding Formulario.Etiquetas.Vazio}" />
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Formulario.Etiquetas.Visiveis}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:EtiquetaMarcavel">
                    <c:CaixaMarcar Texto="{Binding Texto}" Marcado="{Binding Marcada}"
                                   FlexLayout.Basis="{OnIdiom Phone='100%', Default='33%'}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Label Text="Comunicações (LGPD)" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
        <Label Text="Marque só com a autorização da pessoa. A data de autorização ou de revogação é registrada ao salvar e fica no histórico."
               Style="{StaticResource Secundario}" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Consentimentos}" Spacing="4">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:ConsentimentoFormulario">
                    <Border Style="{StaticResource CartaoItem}" Margin="0,0,0,6">
                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                            <c:CaixaMarcar Texto="{Binding Texto}" Marcado="{Binding Concedido}"
                                           FlexLayout.Basis="{OnIdiom Phone='100%', Default='25%'}" />
                            <Label Text="{Binding Situacao}" Style="{StaticResource Secundario}" VerticalOptions="Center"
                                   FlexLayout.Basis="{OnIdiom Phone='100%', Default='30%'}" Margin="0,0,12,0" />
                            <c:Campo Rotulo="Como foi autorizado" Texto="{Binding Origem}" Dica="Ex.: Balcão, Site, Contrato"
                                     FlexLayout.Basis="{OnIdiom Phone='100%', Default='45%'}" />
                        </FlexLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Relacionamento: interações (só inclusão) e a situação calculada pelos dias sem interação. -->
        <Label Text="Interações" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
        <Label Text="{Binding Formulario.Situacoes.TextoRelacionamento}" FontAttributes="Bold" LineBreakMode="WordWrap" />
        <FlexLayout Wrap="Wrap" AlignItems="End">
            <c:CampoEscolha Rotulo="Tipo" Itens="{Binding Formulario.Situacoes.ListaTipos}" Selecionado="{Binding Formulario.Situacoes.NovoTipo}" />
            <c:Campo Rotulo="O que foi tratado" Texto="{Binding Formulario.Situacoes.NovaDescricao}" FlexLayout.Basis="{OnIdiom Phone='100%', Default='60%'}" />
            <Button Text="Registrar interação" Style="{StaticResource BotaoSecundario}" Command="{Binding Formulario.Situacoes.RegistrarInteracaoCommand}"
                    IsEnabled="{Binding Livre}" Margin="0,0,0,8" />
        </FlexLayout>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Situacoes.Interacoes}" Spacing="6">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:InteracaoItem">
                    <VerticalStackLayout>
                        <Label Text="{Binding Descricao}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
