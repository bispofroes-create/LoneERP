<?xml version="1.0" encoding="utf-8" ?>
<!-- Situação do cadastro: ativo/em análise pelo formulário; desativar e reativar são ações próprias (nunca exclui). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.Pessoas.SecaoSituacaoView"
             x:DataType="pes:PessoasViewModel">
    <VerticalStackLayout Spacing="10">
        <Border Style="{StaticResource Cartao}" Padding="16">
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="●" FontSize="18" VerticalOptions="Center" TextColor="{StaticResource Sucesso}"
                           IsVisible="{Binding Formulario.PodeEscolherSituacao}" />
                    <Label Text="○" FontSize="18" VerticalOptions="Center" IsVisible="{Binding Formulario.EstaInativo}" />
                    <Label Text="{Binding Formulario.SituacaoTexto}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding Formulario.SituacaoDetalhe}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>

        <!-- Ativo ou em análise (cadastro incompleto ou aguardando aprovação: não movimenta). -->
        <c:CampoEscolha Rotulo="Situação de uso" Itens="{Binding Formulario.SituacoesDeUso}" Selecionado="{Binding Formulario.Situacao}"
                        IsVisible="{Binding Formulario.PodeEscolherSituacao}" MaximumWidthRequest="360" HorizontalOptions="Start" />

        <Label Style="{StaticResource Secundario}" LineBreakMode="WordWrap"
               Text="Desativar tira o cadastro das buscas e das operações do dia a dia, sem apagar nada: todo o histórico fica guardado, ele continua no filtro &quot;Inativos&quot; e pode ser reativado a qualquer momento." />

        <HorizontalStackLayout Spacing="12">
            <Button Text="Desativar cadastro" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                    IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
            <Button Text="Reativar cadastro" Command="{Binding ReativarCommand}"
                    IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
        </HorizontalStackLayout>

        <!-- Bloqueios: separados da situação cadastral; bloquear e liberar são ações próprias (com motivo, quem e quando). -->
        <Label Text="Bloqueios" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
        <Label Text="Um cadastro ativo pode estar bloqueado para vender, faturar ou no financeiro. Liberar não apaga: o bloqueio fica no histórico."
               Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
        <FlexLayout Wrap="Wrap" AlignItems="End">
            <c:CampoEscolha Rotulo="Bloquear" Itens="{Binding Formulario.Situacoes.ListaEscopos}" Selecionado="{Binding Formulario.Situacoes.NovoEscopo}" />
            <c:Campo Rotulo="Motivo" Texto="{Binding Formulario.Situacoes.NovoMotivo}" Dica="Ex.: títulos vencidos há 60 dias" />
            <Button Text="Bloquear" Style="{StaticResource BotaoSecundario}" Command="{Binding Formulario.Situacoes.BloquearCommand}"
                    IsEnabled="{Binding Livre}" Margin="0,0,0,8" />
        </FlexLayout>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Situacoes.Bloqueios}" Spacing="6">
            <BindableLayout.EmptyView>
                <Label Text="Nenhum bloqueio." Style="{StaticResource Secundario}" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pes:BloqueioItem">
                    <Border Style="{StaticResource CartaoItem}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Liberar" Style="{StaticResource BotaoLink}" Command="{Binding LiberarCommand}"
                                    IsVisible="{Binding Ativo}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
