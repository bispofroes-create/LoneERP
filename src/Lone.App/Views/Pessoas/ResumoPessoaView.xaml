<?xml version="1.0" encoding="utf-8" ?>
<!-- Resumo da pessoa: blocos (Situação, Documentos, Cadastro...) com itens por gravidade. O marcador (●, ▲, ✓) e o texto
     dizem a gravidade além da cor. Item com destino: tocar leva à aba onde o assunto é resolvido. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             x:Class="Lone.App.Views.Pessoas.ResumoPessoaView"
             x:DataType="pes:ResumoPessoa">
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Blocos}" Spacing="14">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="pes:BlocoResumo">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Titulo}" Style="{StaticResource Rotulo}" Margin="0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Itens}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pes:ItemResumo">
                                <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IrCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Marcador}" FontSize="12" VerticalOptions="Start" Margin="0,2,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding EhAlerta}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Erro}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding EhAtencao}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding EhOk}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="1" Text="{Binding Texto}" FontSize="13" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <!-- Com destino: aparência de link (leva à aba). -->
                                            <DataTrigger TargetType="Label" Binding="{Binding PodeIr}" Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
