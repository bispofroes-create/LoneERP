<?xml version="1.0" encoding="utf-8" ?>
<!-- Consulta avançada de pessoas: critérios à esquerda (ou em cima, no celular), resultado com "Carregar mais".
     Filtros salvos por usuário; exportação CSV com permissão própria (fica na auditoria). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pes="clr-namespace:Lone.Cliente.ViewModels.Pessoas;assembly=Lone.Cliente"
             xmlns:ct="clr-namespace:Lone.Contracts.Pessoas;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.ConsultaPessoasPage"
             x:DataType="pes:ConsultaPessoasViewModel"
             Title="Consulta avançada">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,16', Default='32,24'}" Spacing="10">
            <Label Text="Consulta avançada de pessoas" Style="{StaticResource Titulo}" />
            <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />

            <!-- Filtros salvos -->
            <FlexLayout Wrap="Wrap" AlignItems="End">
                <c:CampoEscolha Rotulo="Filtro salvo" Itens="{Binding Filtros}" Selecionado="{Binding FiltroEscolhido}" Dica="(nenhum)" />
                <c:CaixaMarcar Texto="Compartilhar com todos" Marcado="{Binding Compartilhar}" Margin="8,0" />
                <Button Text="Salvar filtro" Style="{StaticResource BotaoSecundario}" Command="{Binding SalvarFiltroCommand}" IsEnabled="{Binding Livre}" Margin="0,0,8,0" />
                <Button Text="Remover filtro" Style="{StaticResource BotaoLink}" Command="{Binding RemoverFiltroCommand}" IsVisible="{Binding PodeRemoverFiltro}" />
            </FlexLayout>

            <Label Text="Cadastro" Style="{StaticResource Subtitulo}" />
            <FlexLayout Wrap="Wrap">
                <c:Campo Rotulo="Texto" Texto="{Binding Texto}" Dica="Nome, código, CPF/CNPJ, telefone, e-mail" />
                <c:CampoEscolha Rotulo="Natureza" Itens="{Binding ListaNaturezas}" Selecionado="{Binding Natureza}" />
                <c:CampoEscolha Rotulo="Situação" Itens="{Binding ListaSituacoes}" Selecionado="{Binding Situacao}" />
                <c:CampoEscolha Rotulo="Papel" Itens="{Binding Papeis}" Selecionado="{Binding Papel}" />
                <c:CampoEscolha Rotulo="Etiqueta" Itens="{Binding Etiquetas}" Selecionado="{Binding Etiqueta}" />
                <c:Campo Rotulo="Cadastrado de" Texto="{Binding CadastradoDe}" Dica="dd/mm/aaaa" Mascara="Data" />
                <c:Campo Rotulo="Cadastrado até" Texto="{Binding CadastradoAte}" Dica="dd/mm/aaaa" Mascara="Data" />
                <c:CampoEscolha Rotulo="Campo personalizado" Itens="{Binding Campos}" Selecionado="{Binding Campo}" />
                <c:Campo Rotulo="Valor começa com" Texto="{Binding CampoValor}" />
            </FlexLayout>

            <Label Text="Endereço e fiscal" Style="{StaticResource Subtitulo}" />
            <FlexLayout Wrap="Wrap" AlignItems="End">
                <c:Campo Rotulo="UF" Texto="{Binding Uf}" Dica="Ex.: SP" />
                <c:Campo Rotulo="CNAE (ou começo)" Texto="{Binding Cnae}" Dica="Ex.: 4711302 ou 47" />
                <c:CaixaMarcar Texto="Só CNAE principal" Marcado="{Binding SomenteCnaePrincipal}" Margin="8,0" />
                <c:CampoEscolha Rotulo="Regime tributário" Itens="{Binding ListaRegimes}" Selecionado="{Binding Regime}" />
                <c:CampoEscolha Rotulo="Produtor rural" Itens="{Binding ListaSimNao}" Selecionado="{Binding ProdutorRural}" />
            </FlexLayout>

            <Label Text="Comercial e relacionamento" Style="{StaticResource Subtitulo}" />
            <FlexLayout Wrap="Wrap" AlignItems="End">
                <c:CampoEscolha Rotulo="Carteira (hoje)" Itens="{Binding Vendedores}" Selecionado="{Binding Vendedor}" />
                <c:CampoEscolha Rotulo="Relacionamento" Itens="{Binding ListaRelacionamentos}" Selecionado="{Binding Relacionamento}" />
                <c:Campo Rotulo="Sem interação há (dias)" Texto="{Binding SemInteracaoDias}" Mascara="Numero" Dica="Ex.: 90" />
                <c:CampoEscolha Rotulo="Com bloqueio ativo" Itens="{Binding ListaSimNao}" Selecionado="{Binding Bloqueado}" />
            </FlexLayout>

            <Label Text="Documentos" Style="{StaticResource Subtitulo}" />
            <FlexLayout Wrap="Wrap" AlignItems="End">
                <c:CaixaMarcar Texto="Com documento vencido" Marcado="{Binding DocumentosVencidos}" Margin="0,0,8,0" />
                <c:Campo Rotulo="Vencendo em (dias)" Texto="{Binding DocumentosVencendoDias}" Mascara="Numero" Dica="Ex.: 30" />
            </FlexLayout>

            <HorizontalStackLayout Spacing="12" Margin="0,8">
                <Button Text="Pesquisar" Command="{Binding PesquisarCommand}" IsEnabled="{Binding Livre}" />
                <Button Text="Limpar" Style="{StaticResource BotaoSecundario}" Command="{Binding LimparCommand}" IsEnabled="{Binding Livre}" />
                <Button Text="Exportar CSV" Style="{StaticResource BotaoSecundario}" Command="{Binding ExportarCommand}"
                        IsVisible="{Binding PodeExportar}" IsEnabled="{Binding Livre}" />
                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Resultado -->
            <Label Text="{Binding TotalTexto}" Style="{StaticResource Secundario}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resultado}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="ct:PessoaResumo">
                        <Border Style="{StaticResource CartaoItem}">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nome}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Carregar mais" Style="{StaticResource BotaoSecundario}" Command="{Binding CarregarMaisCommand}"
                    IsVisible="{Binding TemMais}" IsEnabled="{Binding Livre}" HorizontalOptions="Start" />

            <!-- Rotina de identificação de endereços duplicados (só aponta; a consolidação é assistida, na ficha). -->
            <Label Text="Endereços duplicados" Style="{StaticResource Subtitulo}" Margin="0,16,0,0" />
            <Label Text="Procura pessoas com o mesmo endereço físico cadastrado mais de uma vez. Nada é alterado: a consolidação é feita na ficha, com confirmação."
                   Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="Procurar endereços duplicados" Style="{StaticResource BotaoSecundario}" Command="{Binding ProcurarDuplicadosCommand}" IsEnabled="{Binding Livre}" />
            </HorizontalStackLayout>
            <Label Text="{Binding DuplicadosTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding EnderecosDuplicados}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Continuar procurando" Style="{StaticResource BotaoLink}" Command="{Binding ContinuarDuplicadosCommand}"
                    IsVisible="{Binding TemMaisDuplicados}" IsEnabled="{Binding Livre}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
