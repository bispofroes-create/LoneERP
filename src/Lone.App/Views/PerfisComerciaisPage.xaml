<?xml version="1.0" encoding="utf-8" ?>
<!-- Perfis comerciais: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.PerfisComerciaisPage"
             x:DataType="cad:PerfisComerciaisViewModel"
             Title="Perfis comerciais">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Perfis comerciais"
                         Subtitulo="Perfis são os padrões de venda de um grupo de clientes. No cliente, uma exceção com vigência vale acima do perfil; o que o perfil não define vem da conta."
                         TextoNovo="+  Novo perfil comercial"
                         DicaBusca="Pesquisar perfis comerciais"
                         TituloVazio="Nenhum perfil comercial cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Perfis comerciais">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                                            <c:Campo Rotulo="Limite de crédito (R$)" Texto="{Binding Formulario.LimiteCredito}" Dica="vazio = o perfil não define" />
                    <c:Campo Rotulo="Desconto máximo (%)" Texto="{Binding Formulario.DescontoMaximo}" Dica="vazio = o perfil não define" />
                    <c:Campo Rotulo="Dias máximos de atraso" Texto="{Binding Formulario.DiasMaximoAtraso}" Mascara="Numero" />
                    <c:CampoEscolha Rotulo="Condição de pagamento" Itens="{Binding Formulario.Condicoes}" Selecionado="{Binding Formulario.Condicao}" />
                    <c:CampoEscolha Rotulo="Aprovação acima do limite" Itens="{Binding Formulario.ListaSimNao}" Selecionado="{Binding Formulario.ExigeAprovacao}" />
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Atacado" />
                </c:BlocoCampos>
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
