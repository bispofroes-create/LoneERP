<?xml version="1.0" encoding="utf-8" ?>
<!-- Grupos empresariais: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Nada é excluído: é desativado.
     As empresas entram no grupo pela ficha de cada pessoa jurídica (aba "Identificação"). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.GruposEmpresariaisPage"
             x:DataType="cad:GruposEmpresariaisViewModel"
             Title="Grupos empresariais">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Grupos empresariais"
                         Subtitulo="Um grupo empresarial reúne empresas independentes (CNPJs diferentes) que você quer ver juntas. Não é matriz/filial: cada empresa continua com os seus estabelecimentos. É opcional."
                         TextoNovo="+  Novo grupo empresarial"
                         DicaBusca="Pesquisar grupos empresariais"
                         TituloVazio="Nenhum grupo empresarial cadastrado" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Grupos empresariais">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome" Texto="{Binding Formulario.Nome}" Dica="Ex.: Grupo João" />
                    <c:Campo Rotulo="Descrição (opcional)" Texto="{Binding Formulario.Descricao}" FlexLayout.Basis="100%" />
                </c:BlocoCampos>
                <Label Text="Maiúsculas e acentos não contam no nome."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Empresas do grupo (somente leitura): cada uma com a sua matriz e as suas filiais. -->
                <Label Text="Empresas do grupo" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                <Label Text="Para incluir ou tirar uma empresa, abra a ficha dela em Pessoas (aba &quot;Identificação&quot;). Só pessoas jurídicas participam; quem é sócio ou administrador aparece nos relacionamentos de cada empresa."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                <Label Text="Nenhuma empresa neste grupo." Style="{StaticResource Secundario}" IsVisible="{Binding Formulario.SemEmpresas}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Empresas}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="cad:EmpresaDoGrupoItem">
                            <Border Style="{StaticResource CartaoItem}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
