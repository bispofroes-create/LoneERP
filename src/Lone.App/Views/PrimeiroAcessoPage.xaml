<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lone.Cliente.ViewModels;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.PrimeiroAcessoPage"
             x:DataType="vm:PrimeiroAcessoViewModel"
             Title="Primeiro acesso">
    <ScrollView>
        <Border Style="{StaticResource CartaoEntrada}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Bem-vindo ao Lone" Style="{StaticResource Titulo}" />
                <Label Text="Este servidor ainda não tem usuários. Crie o administrador: ele terá acesso total e poderá cadastrar os demais."
                       Style="{StaticResource Secundario}" Margin="0,0,0,8" />

                <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />

                <Label Text="Nome" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Nome}" MaxLength="100" SemanticProperties.Description="Nome" />

                <Label Text="Login" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Login}" MaxLength="60" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                       SemanticProperties.Description="Login" />

                <Label Text="Senha" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Senha}" IsPassword="True" SemanticProperties.Description="Senha" />
                <Label Text="Pelo menos 8 caracteres, com letras e números." Style="{StaticResource Secundario}" />

                <Label Text="Confirme a senha" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Confirmacao}" IsPassword="True" ReturnType="Go" ReturnCommand="{Binding CriarCommand}"
                       SemanticProperties.Description="Confirmação da senha" />

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                    <Button Text="Criar e entrar" Command="{Binding CriarCommand}" IsEnabled="{Binding Livre}" />
                    <Button Grid.Column="1" Text="Voltar" Style="{StaticResource BotaoSecundario}" Command="{Binding VoltarCommand}" />
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
