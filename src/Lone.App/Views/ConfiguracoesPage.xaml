<?xml version="1.0" encoding="utf-8" ?>
<!-- Configurações de um módulo (Pessoas, Organização, Metas) ou do sistema: grupos com os cadastros de apoio.
     Cada cartão abre a mesma tela de antes. Um cartão por cadastro, agrupados por título (escolha do usuário). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lone.Cliente.ViewModels;assembly=Lone.Cliente"
             x:Class="Lone.App.Views.ConfiguracoesPage"
             x:DataType="vm:ConfiguracoesViewModel"
             Title="{Binding Titulo}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,16', Default='32,24'}" Spacing="24" MaximumWidthRequest="1200" HorizontalOptions="Fill">
            <!-- Cabeçalho da página -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <Label Text="{Binding Descricao}" Style="{StaticResource SubtituloPagina}" />
            </VerticalStackLayout>

            <Label Text="Você não tem acesso a nenhuma configuração deste módulo." Style="{StaticResource Secundario}" IsVisible="{Binding Vazio}" />

            <!-- Grupos um embaixo do outro; cada cadastro num cartão próprio (aparência de antes do redesenho, a pedido do usuário). -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Grupos}" Spacing="20">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:GrupoConfiguracao">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" />
                            <!-- Cartões lado a lado no computador; um embaixo do outro no celular. -->
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Itens}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ItemConfiguracao">
                                        <Border Style="{StaticResource Cartao}" Margin="0,0,12,12"
                                                FlexLayout.Basis="{OnIdiom Phone='100%', Default='33%'}"
                                                SemanticProperties.Description="{Binding Titulo}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:ConfiguracoesViewModel}}, x:DataType=vm:ConfiguracoesViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="15" />
                                                <Label Text="{Binding Descricao}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
