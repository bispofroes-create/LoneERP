<?xml version="1.0" encoding="utf-8" ?>
<!-- Perfis de acesso: lista à esquerda e ficha com as permissões ao lado (no celular, uma de cada vez). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:seg="clr-namespace:Lone.Cliente.ViewModels.Seguranca;assembly=Lone.Cliente"
             xmlns:dto="clr-namespace:Lone.Contracts.Seguranca;assembly=Lone.Contracts"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.PerfisPage"
             x:DataType="seg:PerfisViewModel"
             Title="Perfis">

    <Grid x:Name="Grade" ColumnDefinitions="340,*">

        <!-- ===== Lista ===== -->
        <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12" IsVisible="{Binding MostrarLista}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Text="{Binding Busca}" Placeholder="Buscar perfil" />
                <Button Grid.Column="1" Text="Novo" Command="{Binding NovoCommand}" IsEnabled="{Binding Livre}" />
            </Grid>

            <!-- A barra controla a própria visibilidade (some sem mensagem); o contêiner a esconde com a ficha aberta. -->
            <ContentView Grid.Row="1" IsVisible="{Binding SemFicha}">
                <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />
            </ContentView>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Itens}" SelectionMode="Single"
                            SelectedItem="{Binding Selecionado}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum perfil encontrado." Style="{StaticResource Secundario}" Margin="8,16" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PerfilResumo">
                        <VerticalStackLayout Padding="12,10" Spacing="2">
                            <Label Text="{Binding Nome}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Detalhe}" Style="{StaticResource Secundario}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator Grid.Row="2" IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                               VerticalOptions="Start" HorizontalOptions="Center" Margin="0,24" />
        </Grid>

        <!-- ===== Nenhuma ficha aberta (só no computador) ===== -->
        <VerticalStackLayout Grid.Column="1" IsVisible="{Binding MostrarVazio}" VerticalOptions="Center"
                             HorizontalOptions="Center" Spacing="6" Padding="24">
            <Label Text="Nenhum perfil aberto" Style="{StaticResource Subtitulo}" HorizontalOptions="Center" />
            <Label Text="Escolha um perfil na lista ou clique em Novo." Style="{StaticResource Secundario}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ===== Ficha ===== -->
        <ScrollView Grid.Column="1" IsVisible="{Binding MostrarFicha}">
            <VerticalStackLayout Padding="{OnIdiom Phone='16,16', Default='32,24'}" Spacing="8" MaximumWidthRequest="760"
                                 HorizontalOptions="Fill">

                <Button Text="‹ Perfis" Style="{StaticResource BotaoLink}" Command="{Binding FecharFichaCommand}"
                        IsVisible="{Binding ModoCompacto}" />
                <Label Text="{Binding Formulario.Titulo}" Style="{StaticResource Titulo}" LineBreakMode="TailTruncation" />

                <c:BarraMensagem Mensagem="{Binding Mensagem}" Tipo="{Binding TipoMensagem}" />

                <Label Text="Nome" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Formulario.Nome}" SemanticProperties.Description="Nome do perfil" />

                <Label Text="Descrição (opcional)" Style="{StaticResource Rotulo}" />
                <Entry Text="{Binding Formulario.Descricao}" SemanticProperties.Description="Descrição do perfil" />

                <c:CaixaMarcar Texto="Ativo" Marcado="{Binding Formulario.Ativo}" Margin="0,8,0,0" />
                <c:CaixaMarcar Texto="Administrador (acesso a tudo, inclusive telas futuras)" Marcado="{Binding Formulario.Administrador}" />

                <!-- Alcance (Motor Comercial, Fase 2a): até onde o perfil enxerga os cadastros. O administrador vê tudo. -->
                <VerticalStackLayout IsVisible="{Binding Formulario.MostrarPermissoes}" Spacing="4" Margin="0,12,0,0">
                    <c:CampoEscolha Rotulo="Alcance em Pessoas e no Comercial" Itens="{Binding Formulario.ListaAlcances}"
                                    Selecionado="{Binding Formulario.Alcance}" />
                    <Label Text="{Binding Formulario.AjudaAlcance}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Permissões por módulo -->
                <VerticalStackLayout IsVisible="{Binding Formulario.MostrarPermissoes}" Spacing="8" Margin="0,12,0,0">
                    <Label Text="Permissões" Style="{StaticResource Subtitulo}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Formulario.Grupos}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="seg:GrupoPermissoes">
                                <Border Style="{StaticResource Cartao}" Padding="16">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Modulo}" FontAttributes="Bold" Margin="0,0,0,4" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Permissoes}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="seg:PermissaoMarcavel">
                                                    <c:CaixaMarcar Texto="{Binding Descricao}" Marcado="{Binding Marcada}" Padding="0" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="Mudanças nas permissões valem para os usuários do perfil em até 30 segundos."
                       Style="{StaticResource Secundario}" Margin="0,8,0,0" />

                <HorizontalStackLayout Spacing="12" Margin="0,20,0,24">
                    <Button Text="Salvar" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeSalvarAgora}" />
                    <Button Text="Descartar" Style="{StaticResource BotaoSecundario}" Command="{Binding DescartarCommand}"
                            IsEnabled="{Binding Livre}" ToolTipProperties.Text="Desfaz as alterações não salvas (não exclui nada)" />
                    <Button Text="Fechar" Style="{StaticResource BotaoLink}" Command="{Binding FecharFichaCommand}" />
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" VerticalOptions="Center" />
                    <!-- Estado da ficha: "Sem alterações" / "Alterações não salvas" (o Salvar só habilita com o que gravar). -->
                    <Label Text="{Binding EstadoFicha}" Style="{StaticResource Secundario}" VerticalOptions="Center" SemanticProperties.Description="{Binding EstadoFicha}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
