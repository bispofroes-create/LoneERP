<?xml version="1.0" encoding="utf-8" ?>
<!-- Cadastro de etiquetas: lista em colunas e ficha em página própria (padrão de tela de cadastro, 03/10/2026). Etiquetas não são excluídas: são desativadas ou mescladas. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cad="clr-namespace:Lone.Cliente.ViewModels.Cadastros;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.EtiquetasPage"
             x:DataType="cad:EtiquetasViewModel"
             Title="Etiquetas">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Etiquetas"
                         Subtitulo="As etiquetas são marcadas na aba &quot;Relacionamento e LGPD&quot; do cadastro de pessoas e servem de filtro na lista."
                         TextoNovo="+  Nova etiqueta"
                         DicaBusca="Pesquisar etiquetas"
                         TituloVazio="Nenhuma etiqueta cadastrada" />

        <c:FichaCadastro MostrarSalvarENovo="True" IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Etiquetas">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Formulario.UsoTexto}" Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <c:BlocoCampos>
                    <c:Campo Rotulo="Nome da etiqueta" Texto="{Binding Formulario.Nome}" Dica="Ex.: Cliente VIP" />
                    <c:Campo Rotulo="Descrição (opcional)" Texto="{Binding Formulario.Descricao}"
                             Dica="Quando usar esta etiqueta" FlexLayout.Basis="100%" />
                </c:BlocoCampos>
                <Label Text="Maiúsculas e acentos não contam: &quot;VIP&quot;, &quot;vip&quot; e &quot;Víp&quot; são a mesma etiqueta."
                       Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                <!-- Situação -->
                <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Button Text="Desativar etiqueta" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                            IsVisible="{Binding PodeDesativar}" IsEnabled="{Binding Livre}" />
                    <Button Text="Reativar etiqueta" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                            IsVisible="{Binding PodeReativar}" IsEnabled="{Binding Livre}" />
                </HorizontalStackLayout>

                <!-- Mesclar -->
                <VerticalStackLayout Spacing="6" Margin="0,16,0,0" IsVisible="{Binding PodeMesclar}">
                    <Label Text="Mesclar com outra etiqueta" Style="{StaticResource Subtitulo}" />
                    <Label Text="Para juntar etiquetas repetidas (ex.: &quot;VIP&quot; e &quot;Cliente VIP&quot;): os cadastros desta passam para a escolhida e esta é desativada. A mudança fica no histórico de cada cadastro."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />
                    <c:BlocoCampos AlignItems="End">
                        <c:CampoEscolha Rotulo="Passar os cadastros para" Itens="{Binding DestinosMesclagem}"
                                        Selecionado="{Binding DestinoMesclagem}" />
                        <Button Text="Mesclar" Style="{StaticResource BotaoSecundario}" Command="{Binding MesclarCommand}"
                                IsEnabled="{Binding Livre}" Margin="0,0,0,4" />
                    </c:BlocoCampos>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
