<?xml version="1.0" encoding="utf-8" ?>
<!-- Ausências e coberturas (Motor Comercial, Fase 1c). A carteira do titular não muda; a cobertura vale pelas datas e acaba
     sozinha. Nada é apagado: cancela (antes de começar) ou encerra.
     Padrão de tela de cadastro (03/10/2026, tela-piloto; docs/UX-ARQUITETURA.md): título da página, lista larga em colunas
     (GradeLista) e a ficha em página própria, com "Voltar" no topo e a barra de ações embaixo. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:com="clr-namespace:Lone.Cliente.ViewModels.Comercial;assembly=Lone.Cliente"
             xmlns:c="clr-namespace:Lone.App.Controles"
             x:Class="Lone.App.Views.CoberturasPage"
             x:DataType="com:CoberturasViewModel"
             Title="Ausências e coberturas">

    <Grid>
        <c:ListaCadastro IsVisible="{Binding SemFicha}"
                         Titulo="Ausências e coberturas"
                         Subtitulo="Quando alguém da carteira sai de férias, folga ou licença, outra pessoa (ou uma equipe) atende os clientes dele no período. A carteira não muda e a cobertura acaba sozinha no fim."
                         TextoNovo="+  Nova cobertura"
                         DicaBusca="Pesquisar por pessoa, tipo ou quem cobre"
                         TituloVazio="Nenhuma ausência vigente ou agendada"
                         TextoVazio="Para ver as antigas, marque &quot;Mostrar encerradas e canceladas&quot;.">
            <c:ListaCadastro.Filtros>
                <c:CaixaMarcar Texto="Mostrar encerradas e canceladas" Marcado="{Binding IncluirEncerradas}" />
            </c:ListaCadastro.Filtros>
        </c:ListaCadastro>

        <c:FichaCadastro IsVisible="{Binding MostrarFicha}" TextoVoltar="Voltar para Ausências e coberturas">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ausência" Style="{StaticResource Subtitulo}" />
                    <c:BlocoCampos>
                        <c:CampoEscolha Rotulo="Quem vai se ausentar" Itens="{Binding Formulario.Pessoas}" Selecionado="{Binding Formulario.Titular}"
                                        IsEnabled="{Binding Formulario.Editavel}" />
                        <c:CampoEscolha Rotulo="Tipo" Itens="{Binding Formulario.Tipos}" Selecionado="{Binding Formulario.Tipo}"
                                        IsEnabled="{Binding Formulario.Editavel}" />
                    </c:BlocoCampos>

                    <!-- Período: Início, Prazo (dias ou prazo pronto; fora do fim de semana) e Fim — 03/10/2026. -->
                    <Label Text="Período" Style="{StaticResource Subtitulo}" Margin="0,8,0,0" />
                    <c:BlocoCampos AlignItems="Start">
                        <c:Campo Rotulo="Início" Texto="{Binding Formulario.InicioEm}" Dica="dd/mm/aaaa" Mascara="Data" SomenteLeitura="{Binding Formulario.Travado}" />
                        <c:CampoPrazo Inicio="{Binding Formulario.InicioEm}" Fim="{Binding Formulario.FimEm}" Registro="{Binding Formulario}"
                                      SomenteLeitura="{Binding Formulario.Cancelada}" />
                        <c:Campo Rotulo="Fim" Texto="{Binding Formulario.FimEm}" Dica="dd/mm/aaaa" Mascara="Data" SomenteLeitura="{Binding Formulario.Cancelada}" />
                    </c:BlocoCampos>
                    <!-- Início travado depois que começa (decisão do usuário, 03/10/2026: mantém a regra, como os ERPs). -->
                    <Label Text="O início não muda depois que a cobertura começa (o que já aconteceu fica no histórico). Para outra data, encerre esta e crie uma nova cobertura."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" IsVisible="{Binding Formulario.Travado}" />

                    <Label Text="Quem cobre" Style="{StaticResource Subtitulo}" Margin="0,8,0,0" />
                    <c:BlocoCampos>
                        <c:CampoEscolha Rotulo="Cobre" Itens="{Binding Formulario.ListaModos}" Selecionado="{Binding Formulario.PorEquipe}"
                                        IsEnabled="{Binding Formulario.Editavel}" />
                        <c:CampoEscolha Rotulo="Pessoa" Itens="{Binding Formulario.Substitutos}" Selecionado="{Binding Formulario.Substituto}"
                                        IsVisible="{Binding Formulario.CobrePessoa}" IsEnabled="{Binding Formulario.Editavel}" />
                        <c:CampoEscolha Rotulo="Equipe" Itens="{Binding Formulario.Equipes}" Selecionado="{Binding Formulario.Equipe}"
                                        IsVisible="{Binding Formulario.PorEquipe.Valor}" IsEnabled="{Binding Formulario.Editavel}" />
                        <c:CampoEscolha Rotulo="Papel comercial" Itens="{Binding Formulario.Papeis}" Selecionado="{Binding Formulario.Papel}"
                                        IsEnabled="{Binding Formulario.Editavel}" />
                        <c:CampoEscolha Rotulo="Empresa" Itens="{Binding Formulario.Empresas}" Selecionado="{Binding Formulario.Empresa}"
                                        IsEnabled="{Binding Formulario.Editavel}" />
                    </c:BlocoCampos>
                    <c:CaixaMarcar Texto="Quem cobre pode ver e atender os clientes do titular no período" Marcado="{Binding Formulario.PermiteAcesso}" />

                    <Label Text="Crédito das vendas no período" Style="{StaticResource Subtitulo}" Margin="0,8,0,0" />
                    <c:BlocoCampos>
                        <c:CampoEscolha Rotulo="Crédito" Itens="{Binding Formulario.Creditos}" Selecionado="{Binding Formulario.Credito}"
                                        IsEnabled="{Binding Formulario.Editavel}" />
                        <c:Campo Rotulo="Percentual de quem cobre (%)" Texto="{Binding Formulario.PercentualSubstituto}" Teclado="Numeric"
                                 IsVisible="{Binding Formulario.Dividido}" SomenteLeitura="{Binding Formulario.Travado}" />
                    </c:BlocoCampos>
                    <c:Campo Rotulo="Observação" Texto="{Binding Formulario.Observacao}" />
                    <Label Text="Depois que a cobertura começa, só o fim, a observação e o acesso mudam (o histórico não é reescrito). Cancelar só antes de começar."
                           Style="{StaticResource Secundario}" LineBreakMode="WordWrap" />

                    <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                        <Button Text="Encerrar hoje" Style="{StaticResource BotaoSecundario}" Command="{Binding EncerrarHojeCommand}"
                                IsVisible="{Binding Formulario.PodeEncerrarHoje}" IsEnabled="{Binding Livre}" />
                        <Button Text="Cancelar cobertura" Style="{StaticResource BotaoSecundario}" Command="{Binding CancelarCoberturaCommand}"
                                IsVisible="{Binding Formulario.PodeCancelar}" IsEnabled="{Binding Livre}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
        </c:FichaCadastro>
    </Grid>
</ContentPage>
