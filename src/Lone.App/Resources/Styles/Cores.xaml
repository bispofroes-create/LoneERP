<?xml version="1.0" encoding="UTF-8" ?>
<!-- Paleta do Lone. Cada cor tem a versão clara e a escura; as telas usam AppThemeBinding
     e seguem o tema do sistema (Windows/Android) automaticamente. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Marca -->
    <Color x:Key="Primaria">#1F4E79</Color>
    <Color x:Key="PrimariaEscuro">#6FA8DC</Color>
    <Color x:Key="SobrePrimaria">#FFFFFF</Color>
    <Color x:Key="SobrePrimariaEscuro">#0B1B2B</Color>

    <!-- Fundos e superfícies -->
    <Color x:Key="Fundo">#F4F6F9</Color>
    <Color x:Key="FundoEscuro">#111418</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="SuperficieEscuro">#1C2026</Color>
    <Color x:Key="Borda">#D5DBE3</Color>
    <Color x:Key="BordaEscuro">#323841</Color>

    <!-- Texto -->
    <Color x:Key="Texto">#1B2129</Color>
    <Color x:Key="TextoEscuro">#E7EAEE</Color>
    <Color x:Key="TextoSecundario">#5B6573</Color>
    <Color x:Key="TextoSecundarioEscuro">#A3ACB8</Color>

    <!-- Mensagens -->
    <Color x:Key="Erro">#B3261E</Color>
    <Color x:Key="ErroFundo">#FBE9E7</Color>
    <Color x:Key="ErroFundoEscuro">#3A1E1C</Color>
    <Color x:Key="Aviso">#8A5300</Color>
    <Color x:Key="AvisoFundo">#FFF3E0</Color>
    <Color x:Key="AvisoFundoEscuro">#3A2C14</Color>
    <Color x:Key="Sucesso">#1E6B34</Color>
    <Color x:Key="SucessoFundo">#E6F4EA</Color>
    <Color x:Key="SucessoFundoEscuro">#16301F</Color>
    <Color x:Key="Informacao">#1F4E79</Color>
    <Color x:Key="InformacaoFundo">#E7F0F8</Color>
    <Color x:Key="InformacaoFundoEscuro">#172A3C</Color>

    <!-- ===== Design system (redesenho de Pessoas) ===== -->
    <!-- Ação principal: variações para hover/pressionado. -->
    <Color x:Key="PrimariaHover">#183F63</Color>
    <Color x:Key="PrimariaHoverEscuro">#8BBBE5</Color>
    <!-- Seleção suave (aba ativa, filtro marcado, linha em foco). -->
    <Color x:Key="Selecao">#E8EFF7</Color>
    <Color x:Key="SelecaoEscuro">#1D2D3F</Color>
    <!-- Linha da tabela sob o mouse e cabeçalho da tabela. -->
    <Color x:Key="SuperficieRealce">#F7F9FB</Color>
    <Color x:Key="SuperficieRealceEscuro">#22272E</Color>
    <!-- Borda muito sutil (separadores de linha, seções). -->
    <Color x:Key="BordaSutil">#E6EAF0</Color>
    <Color x:Key="BordaSutilEscuro">#2A3038</Color>

    <!-- Menu lateral (escuro nos dois temas: identidade azul do Lone). -->
    <Color x:Key="MenuFundo">#0F2233</Color>
    <Color x:Key="MenuTexto">#DCE4ED</Color>
    <Color x:Key="MenuTextoSecundario">#8A9BAE</Color>
    <Color x:Key="MenuItemAtivo">#1D3A57</Color>
    <Color x:Key="MenuDestaque">#6FA8DC</Color>

    <!-- Selos de situação (texto + cor: nunca só a cor). -->
    <Color x:Key="SeloNeutroFundo">#EEF1F5</Color>
    <Color x:Key="SeloNeutroFundoEscuro">#2A3038</Color>
</ResourceDictionary>
