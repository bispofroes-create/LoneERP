<?xml version="1.0" encoding="UTF-8" ?>
<!-- Estilos globais. Estilos sem x:Key valem para todos os controles do tipo;
     os com x:Key são usados de propósito (ex.: Style="{StaticResource Cartao}"). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:c="clr-namespace:Lone.App.Controles">

    <!-- ===== Páginas ===== -->
    <!-- Modelo de toda página: o conteúdo dela e, por cima, a camada global de mensagens (toasts), fora de qualquer rolagem.
         O conteúdo continua sendo o da página (ContentPresenter): largura, altura, rolagem e grades não mudam. -->
    <ControlTemplate x:Key="PaginaComMensagens">
        <Grid>
            <ContentPresenter />
            <c:CamadaMensagens />
        </Grid>
    </ControlTemplate>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Fundo}, Dark={StaticResource FundoEscuro}}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ControlTemplate" Value="{StaticResource PaginaComMensagens}" />
        <!-- Computador: sem a barra do Shell (cada página tem o próprio cabeçalho). Celular: a barra fica (botão ☰). -->
        <Setter Property="Shell.NavBarIsVisible" Value="{OnIdiom Phone=True, Default=False}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource SobrePrimaria}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource SobrePrimaria}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{StaticResource MenuFundo}" />
    </Style>

    <!-- ===== Texto ===== -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="Secundario" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="Rotulo" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
    </Style>

    <Style x:Key="NumeroDestaque" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
    </Style>

    <!-- ===== Campos ===== -->
    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <!-- Lista de escolha com a mesma altura e letra da caixa de texto (03/10/2026): lado a lado, os campos ficam iguais. -->
    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ===== Botões (mínimo de 44 px de altura: fácil de tocar no celular) ===== -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SobrePrimaria}, Dark={StaticResource SobrePrimariaEscuro}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Botão padrão (ação principal) -->
    <Style TargetType="Button" BasedOn="{StaticResource BotaoBase}" />

    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
    </Style>

    <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <!-- Sem borda: no Windows o botão desenha um contorno mesmo com fundo transparente. -->
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscuro}}" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <!-- ===== Cartões ===== -->
    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
    </Style>

    <!-- ===== Fichas ===== -->
    <!-- Largura máxima do conteúdo (grade do Lone, 03/10/2026): três medidas em vez de valores soltos.
         Uso: MaximumWidthRequest="{StaticResource LarguraFichaSimples}". -->
    <x:Double x:Key="LarguraFichaCompleta">1600</x:Double>
    <x:Double x:Key="LarguraFichaSimples">1000</x:Double>
    <x:Double x:Key="LarguraPainel">360</x:Double>
    <!-- Todo FlexLayout de campos: três por linha quando há largura de sobra (ColunasAdaptaveis). -->
    <Style TargetType="FlexLayout">
        <Setter Property="c:ColunasAdaptaveis.Ativo" Value="True" />
    </Style>
    <!-- Campos dentro de um FlexLayout: dois por linha no computador, um por linha no celular. -->
    <Style TargetType="c:Campo">
        <Setter Property="FlexLayout.Basis" Value="{OnIdiom Phone='100%', Default='50%'}" />
        <Setter Property="Padding" Value="0,0,12,8" />
    </Style>
    <Style TargetType="c:CampoEscolha">
        <Setter Property="FlexLayout.Basis" Value="{OnIdiom Phone='100%', Default='50%'}" />
        <Setter Property="Padding" Value="0,0,12,8" />
    </Style>
    <!-- Pesquisa com botão (CampoPesquisa) na grade de campos: mesmo espaço dos outros campos (03/10/2026). -->
    <Style TargetType="c:CampoPesquisa">
        <Setter Property="FlexLayout.Basis" Value="{OnIdiom Phone='100%', Default='50%'}" />
        <Setter Property="Padding" Value="0,0,12,8" />
    </Style>
    <Style TargetType="c:CampoPrazo">
        <Setter Property="FlexLayout.Basis" Value="{OnIdiom Phone='100%', Default='50%'}" />
        <Setter Property="Padding" Value="0,0,12,8" />
    </Style>
    <Style TargetType="c:CampoNumero">
        <Setter Property="FlexLayout.Basis" Value="{OnIdiom Phone='100%', Default='50%'}" />
        <Setter Property="Padding" Value="0,0,12,8" />
    </Style>
    <Style TargetType="c:CaixaMarcar">
        <Setter Property="FlexLayout.Basis" Value="{OnIdiom Phone='100%', Default='50%'}" />
        <Setter Property="Padding" Value="0,0,12,4" />
    </Style>

    <!-- Cartão de um item de lista na ficha (endereço, contato, estabelecimento...). -->
    <Style x:Key="CartaoItem" TargetType="Border" BasedOn="{StaticResource Cartao}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Cartão das telas de entrada: centralizado, largura limitada no computador, tela cheia no celular. -->
    <Style x:Key="CartaoEntrada" TargetType="Border" BasedOn="{StaticResource Cartao}">
        <Setter Property="Padding" Value="28" />
        <Setter Property="Margin" Value="16,24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="{OnIdiom Phone=Fill, Default=Center}" />
        <Setter Property="WidthRequest" Value="{OnIdiom Phone=-1, Default=440}" />
    </Style>

    <!-- =====================================================================================================
         DESIGN SYSTEM DO LONE (redesenho de Pessoas). Regras:
         - Espaçamento só na escala 4 · 8 · 12 · 16 · 24 · 32 (margens, paddings, distâncias entre seções).
         - Raios: 6 (controles e selos) e 8 (superfícies). Bordas de 1 px na cor BordaSutil; sem sombras.
         - Tipografia: TituloPagina 24 · SubtituloPagina 14 · SecaoTitulo 16 · Texto 14 · CabecalhoTabela 12 · Selo 12.
         - Azul só para ação principal e estado ativo. Estados nunca só por cor (sempre com texto).
         ===================================================================================================== -->

    <x:Double x:Key="Espaco4">4</x:Double>
    <x:Double x:Key="Espaco8">8</x:Double>
    <x:Double x:Key="Espaco12">12</x:Double>
    <x:Double x:Key="Espaco16">16</x:Double>
    <x:Double x:Key="Espaco24">24</x:Double>
    <x:Double x:Key="Espaco32">32</x:Double>

    <!-- Tipografia -->
    <Style x:Key="TituloPagina" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SubtituloPagina" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
    </Style>
    <Style x:Key="SecaoTitulo" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="CabecalhoTabela" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
    </Style>
    <Style x:Key="TextoTabela" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style x:Key="TextoTabelaSecundario" TargetType="Label" BasedOn="{StaticResource TextoTabela}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
    </Style>

    <!-- Campo da linha de filtro das colunas (embaixo dos títulos da tabela): compacto, com contorno sutil. -->
    <Style x:Key="CampoFiltroColuna" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinimumHeightRequest" Value="34" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
    </Style>

    <!-- Superfície de conteúdo (uma por área; grupos dentro dela separados por título e espaço, não por mais cartões). -->
    <Style x:Key="PainelConteudo" TargetType="Border">
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaSutil}, Dark={StaticResource BordaSutilEscuro}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
    </Style>

    <!-- Cartão compacto de um papel na ficha (borda suave, sem sombra), dentro da superfície da aba. -->
    <Style x:Key="CartaoPapel" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaSutil}, Dark={StaticResource BordaSutilEscuro}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
    </Style>

    <!-- Separador fino entre grupos de uma superfície. -->
    <Style x:Key="Separador" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Margin" Value="0,16" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource BordaSutil}, Dark={StaticResource BordaSutilEscuro}}" />
    </Style>

    <!-- Botões: principal (padrão), secundário, terciário (texto) e perigo. Altura 40 no computador. -->
    <Style x:Key="BotaoTerciario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Selecao}, Dark={StaticResource SelecaoEscuro}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Erro}" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <!-- Botão só com ícone de texto (⋯, ⚙, ‹ ›): quadrado 36, sem borda. Sempre com SemanticProperties.Description. -->
    <Style x:Key="BotaoIcone" TargetType="Button" BasedOn="{StaticResource BotaoTerciario}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
    </Style>

    <!-- Botões do toast (camada global de mensagens): sobre fundo escuro nos dois temas. -->
    <Style x:Key="BotaoToast" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource ToastAcao}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ToastRealce}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ToastRealce}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BotaoToastFechar" TargetType="Button" BasedOn="{StaticResource BotaoToast}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource ToastSecundario}" />
    </Style>

    <!-- Selos (situação, papel, tipo): texto pequeno em fundo suave; raio 6. -->
    <Style x:Key="Selo" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SeloNeutroFundo}, Dark={StaticResource SeloNeutroFundoEscuro}}" />
    </Style>
    <Style x:Key="SeloTexto" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioEscuro}}" />
    </Style>

    <!-- Filtro rápido (chip): contorno sutil; marcado = fundo de seleção e texto azul. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
    </Style>
</ResourceDictionary>
