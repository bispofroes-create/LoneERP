<?xml version="1.0" encoding="utf-8" ?>
<!-- Escolha de um item de uma lista com autocompletar (profissão, ocupação CBO...). O BindingContext é um SeletorDeLista. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comum="clr-namespace:Lone.Cliente.ViewModels.Comum;assembly=Lone.Cliente"
             x:Class="Lone.App.Controles.CampoLista"
             x:DataType="comum:SeletorDeLista">
    <VerticalStackLayout Spacing="2">
        <Label x:Name="RotuloCampo" Style="{StaticResource Rotulo}" />
        <Grid ColumnDefinitions="*,Auto">
            <Entry Text="{Binding Texto}" Placeholder="{Binding Dica}" ClearButtonVisibility="WhileEditing" />
            <Label Grid.Column="1" Text="✓" TextColor="{StaticResource Sucesso}" FontAttributes="Bold"
                   VerticalOptions="Center" Margin="6,0" IsVisible="{Binding Escolhido}" />
        </Grid>

        <Label Text="{Binding Aviso}" IsVisible="{Binding TemAviso}" Style="{StaticResource Secundario}" TextColor="{StaticResource Aviso}" />

        <!-- Sugestões: tocar escolhe (só vale item da lista). Nome longo termina em reticências (o completo fica na dica
             do mouse e no Narrador); à direita, o detalhe (ex.: código CBO). O botão transparente por cima dá o foco, o
             Enter/Espaço e o nome para o Narrador (botão do WinUI não corta com reticências). -->
        <Border IsVisible="{Binding MostrarSugestoes}" Padding="0,4" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                HorizontalOptions="Fill"
                Stroke="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sugestoes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="comum:ItemSeletor">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,0" HeightRequest="36"
                              ToolTipProperties.Text="{Binding Descricao}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource SuperficieRealce}, Dark={StaticResource SuperficieRealceEscuro}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Texto}" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Detalhe}" IsVisible="{Binding TemDetalhe}" Style="{StaticResource Secundario}"
                                   VerticalOptions="Center" />
                            <Button Grid.ColumnSpan="2" Margin="-12,0" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                    CornerRadius="0" MinimumHeightRequest="0" MinimumWidthRequest="0"
                                    SemanticProperties.Description="{Binding Descricao}" Clicked="Sugestao_Clicked" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
