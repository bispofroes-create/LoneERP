<?xml version="1.0" encoding="utf-8" ?>
<!-- Faixa de mensagem reutilizável (erro, aviso, sucesso, informação). Some quando o texto está vazio. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lone.App.Controles.BarraMensagem"
             x:Name="Raiz"
             IsVisible="False">
    <Border x:Name="Moldura" Padding="14,10" StrokeThickness="0" StrokeShape="RoundRectangle 8">
        <Label x:Name="Texto" FontSize="14" LineBreakMode="WordWrap" />
    </Border>
</ContentView>
