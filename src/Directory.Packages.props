<Project>
  <!-- Versões dos pacotes NuGet num lugar só: todos os projetos usam a mesma versão. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- As versões abaixo valem também para dependências indiretas (pacotes que outros pacotes puxam).
         É assim que se troca uma dependência indireta vulnerável pela versão corrigida. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Banco -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0" />

    <!-- Infraestrutura comum -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- Resiliência das consultas externas (DM2 do motor de endereçamento): timeout, nova tentativa e disjuntor
         no IHttpClientFactory. 10.0.0 = mesma linha dos Microsoft.Extensions.* acima. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />

    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />

    <!-- Correções de segurança em dependências indiretas (NU1903). Revisar a cada atualização de pacotes. -->
    <!-- GHSA-v5pm-xwqc-g5wc: a 2.0.0, puxada por Microsoft.AspNetCore.OpenApi, é vulnerável; corrigida na 2.7.5. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- GHSA-23rf-6693-g89p: a 9.0.0, puxada pelas ferramentas do EF Core, é vulnerável; corrigida na 10.0.10. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />

    <!-- Aplicativo (ViewModels) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Tokens -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />

    <!-- Testes -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.3" />
  </ItemGroup>
</Project>
