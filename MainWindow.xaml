<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lone ERP">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Raiz" Loaded="Raiz_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título personalizada -->
        <Grid x:Name="BarraTitulo" Height="40" Padding="16,0,0,0">
            <TextBlock Text="Lone ERP" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Primeiro acesso, login ou o sistema (ShellPage) -->
        <Frame x:Name="Principal" Grid.Row="1" />

        <!-- Aviso enquanto o banco é preparado -->
        <StackPanel x:Name="Carregando" Grid.Row="1" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="48" Height="48" />
            <TextBlock Text="Preparando banco de dados..." HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
