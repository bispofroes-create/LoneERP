<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lone.Views.PessoasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lone.ViewModels"
    xmlns:pv="using:Lone.ViewModels.Pessoas"
    xmlns:modelos="using:Lone.Aplicacao.Pessoas">

    <Page.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="TituloSecao" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="TextoSecundario" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== LISTA ===================== -->
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Pessoas" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.NovoCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Nova pessoa" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox Grid.Row="1"
                     PlaceholderText="Nome, código, CPF/CNPJ, telefone ou e-mail"
                     AutomationProperties.Name="Pesquisar pessoas"
                     Text="{x:Bind ViewModel.Busca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="2">
                <SelectorBar x:Name="FiltroPapel" SelectionChanged="FiltroPapel_SelectionChanged">
                    <SelectorBarItem Text="Todos" IsSelected="True" />
                    <SelectorBarItem Text="Clientes" />
                    <SelectorBarItem Text="Fornecedores" />
                    <SelectorBarItem Text="Empresas" />
                </SelectorBar>
            </Grid>

            <Grid Grid.Row="3" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox Content="Mostrar inativos e arquivados"
                          IsChecked="{x:Bind vm:Conversores.ParaMarcado(ViewModel.MostrarInativos), BindBack=vm:Conversores.DeMarcado, Mode=TwoWay}" />

                <ListView x:Name="Lista" Grid.Row="1"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.Itens}"
                          SelectedItem="{x:Bind ViewModel.Selecionado, Mode=OneWay}"
                          SelectionChanged="Lista_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="modelos:PessoaResumo">
                            <StackPanel Padding="0,8">
                                <TextBlock Text="{x:Bind Nome}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Detalhe}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" Text="Nenhuma pessoa encontrada."
                           HorizontalAlignment="Center" Margin="0,24,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.ListaVazia, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- ===================== CADASTRO ===================== -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Formulario.Titulo, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Formulario.CodigoTexto, Mode=OneWay}"
                           Style="{StaticResource TextoSecundario}" />
                <InfoBar Margin="0,8,0,0"
                         IsOpen="{x:Bind ViewModel.MensagemAberta, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.MensagemSeveridade, Mode=OneWay}"
                         Message="{x:Bind ViewModel.Mensagem, Mode=OneWay}" />
            </StackPanel>

            <SelectorBar x:Name="Secoes" Grid.Row="1" SelectionChanged="Secoes_SelectionChanged">
                <SelectorBarItem x:Name="ItemGeral" Text="Geral" Tag="geral" IsSelected="True" />
                <SelectorBarItem Text="Estabelecimentos" Tag="estabelecimentos"
                                 Visibility="{x:Bind ViewModel.Formulario.EhJuridica, Mode=OneWay}" />
                <SelectorBarItem Text="Fiscal" Tag="estabelecimentos"
                                 Visibility="{x:Bind vm:Conversores.VisivelSeFalso(ViewModel.Formulario.EhJuridica), Mode=OneWay}" />
                <SelectorBarItem Text="Endereços" Tag="enderecos" />
                <SelectorBarItem Text="Contatos" Tag="contatos" />
                <SelectorBarItem Text="Documentos" Tag="documentos" />
                <SelectorBarItem Text="Cliente" Tag="cliente"
                                 Visibility="{x:Bind ViewModel.Formulario.PapelCliente.Ativo, Mode=OneWay}" />
                <SelectorBarItem Text="Fornecedor" Tag="fornecedor"
                                 Visibility="{x:Bind ViewModel.Formulario.PapelFornecedor.Ativo, Mode=OneWay}" />
                <SelectorBarItem Text="Histórico" Tag="historico" />
            </SelectorBar>

            <ScrollViewer Grid.Row="2">
                <Grid MaxWidth="920" HorizontalAlignment="Stretch" Padding="0,0,16,16">

                    <!-- ===== Geral ===== -->
                    <StackPanel x:Name="SecaoGeral" Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Natureza" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind vm:Opcoes.Naturezas}"
                                      SelectedIndex="{x:Bind ViewModel.Formulario.NaturezaIndice, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" Header="Situação" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind vm:Opcoes.Situacoes}"
                                      SelectedIndex="{x:Bind ViewModel.Formulario.SituacaoIndice, Mode=TwoWay}" />
                        </Grid>

                        <TextBox Header="{x:Bind ViewModel.Formulario.RotuloNome, Mode=OneWay}" MaxLength="150"
                                 Text="{x:Bind ViewModel.Formulario.Nome, Mode=TwoWay}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Nome de exibição (usado nas telas)" MaxLength="80"
                                     Text="{x:Bind ViewModel.Formulario.NomeExibicao, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="Nome social" MaxLength="150"
                                     Visibility="{x:Bind ViewModel.Formulario.EhFisica, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.Formulario.NomeSocial, Mode=TwoWay}" />
                        </Grid>

                        <!-- Documento principal -->
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.Formulario.EhJuridica, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="CNPJ (estabelecimento principal)" MaxLength="18" CharacterCasing="Upper"
                                     Text="{x:Bind ViewModel.Formulario.Principal.Cnpj, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.ConsultarCnpjPrincipalCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Find" />
                                    <TextBlock Text="Consultar CNPJ" />
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Column="2" Header="Nome fantasia" MaxLength="150"
                                     Text="{x:Bind ViewModel.Formulario.Principal.NomeFantasia, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind vm:Conversores.VisivelSeFalso(ViewModel.Formulario.EhJuridica), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{x:Bind ViewModel.Formulario.RotuloDocumento, Mode=OneWay}" MaxLength="20"
                                     CharacterCasing="Upper"
                                     Text="{x:Bind ViewModel.Formulario.Documento, Mode=TwoWay}" />
                            <CalendarDatePicker Grid.Column="1" Header="Data de nascimento" HorizontalAlignment="Stretch"
                                                Visibility="{x:Bind ViewModel.Formulario.EhFisica, Mode=OneWay}"
                                                Date="{x:Bind ViewModel.Formulario.DataNascimento, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Header="Apelido" MaxLength="60"
                                     Visibility="{x:Bind ViewModel.Formulario.EhFisica, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.Formulario.Apelido, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.Formulario.Principal.TextoReceita, Mode=OneWay}"
                                   Style="{StaticResource TextoSecundario}" />

                        <TextBlock Text="Papéis" Style="{StaticResource TituloSecao}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Papeis, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="200" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:PapelOpcao">
                                    <ToggleSwitch Header="{x:Bind Texto}" OnContent="Sim" OffContent="Não"
                                                  IsOn="{x:Bind Ativo, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Header="Observações" MaxLength="2000" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80"
                                 Text="{x:Bind ViewModel.Formulario.Observacoes, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- ===== Estabelecimentos (PJ) / Fiscal (PF e estrangeiro) ===== -->
                    <StackPanel x:Name="SecaoEstabelecimentos" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource TextoSecundario}"
                                   Visibility="{x:Bind ViewModel.Formulario.EhJuridica, Mode=OneWay}"
                                   Text="Cada CNPJ da empresa (matriz e filiais) é um estabelecimento, com seus dados fiscais. Todos precisam ter a mesma raiz de CNPJ." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Estabelecimentos, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:EstabelecimentoFormulario">
                                    <Border Style="{StaticResource Cartao}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="8" Visibility="{x:Bind EhJuridica, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Titulo, Mode=OneWay}" VerticalAlignment="Center"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <Button Grid.Column="1" Content="Tornar principal" Click="TornarPrincipal_Click"
                                                        Visibility="{x:Bind PodeRemover, Mode=OneWay}" />
                                                <Button Grid.Column="2" Content="Remover" Click="RemoverEstabelecimento_Click"
                                                        Visibility="{x:Bind PodeRemover, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="12" Visibility="{x:Bind EhJuridica, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="CNPJ *" MaxLength="18" CharacterCasing="Upper"
                                                         Text="{x:Bind Cnpj, Mode=TwoWay}" />
                                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ConsultarCnpj_Click"
                                                        ToolTipService.ToolTip="Consultar este CNPJ"
                                                        AutomationProperties.Name="Consultar este CNPJ">
                                                    <SymbolIcon Symbol="Find" />
                                                </Button>
                                                <TextBox Grid.Column="2" Header="Nome fantasia" MaxLength="150"
                                                         Text="{x:Bind NomeFantasia, Mode=TwoWay}" />
                                                <ToggleSwitch Grid.Column="3" Header="Situação" OnContent="Ativo" OffContent="Inativo"
                                                              IsOn="{x:Bind Ativo, Mode=TwoWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Header="Contribuinte do ICMS" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Bind vm:Opcoes.IndicadoresIE}"
                                                          SelectedIndex="{x:Bind IndicadorIndice, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Header="Inscrição estadual" MaxLength="14" CharacterCasing="Upper"
                                                         Text="{x:Bind InscricaoEstadual, Mode=TwoWay}" />
                                                <TextBox Grid.Column="2" Header="Inscrição municipal" MaxLength="20"
                                                         Text="{x:Bind InscricaoMunicipal, Mode=TwoWay}" />
                                                <TextBox Grid.Column="3" Header="SUFRAMA" MaxLength="9"
                                                         Text="{x:Bind InscricaoSuframa, Mode=TwoWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Header="Regime tributário" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Bind vm:Opcoes.Regimes}"
                                                          SelectedIndex="{x:Bind RegimeIndice, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Header="CNAE principal" MaxLength="9"
                                                         Text="{x:Bind CnaePrincipal, Mode=TwoWay}" />
                                                <TextBox Grid.Column="2" Header="Natureza jurídica" MaxLength="10"
                                                         Text="{x:Bind NaturezaJuridica, Mode=TwoWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Header="Endereço fiscal" HorizontalAlignment="Stretch"
                                                          PlaceholderText="Padrão (endereço fiscal ou principal da pessoa)"
                                                          ItemsSource="{x:Bind EnderecosDisponiveis}"
                                                          SelectedItem="{x:Bind EnderecoFiscal, Mode=OneWay}"
                                                          SelectionChanged="EnderecoFiscal_SelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="pv:EnderecoFormulario">
                                                            <TextBlock Text="{x:Bind Resumo, Mode=OneWay}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1" Content="Usar padrão" VerticalAlignment="Bottom"
                                                        Click="UsarEnderecoPadrao_Click" />
                                            </Grid>

                                            <TextBlock Text="{x:Bind TextoReceita, Mode=OneWay}" Style="{StaticResource TextoSecundario}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Adicionar estabelecimento (filial)"
                                Visibility="{x:Bind ViewModel.Formulario.EhJuridica, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AdicionarEstabelecimentoCommand}" />
                        <TextBlock Style="{StaticResource TextoSecundario}"
                                   Text="Estrangeiros são sempre gravados como não contribuintes, sem inscrição estadual (regra da NF-e)." />
                    </StackPanel>

                    <!-- ===== Endereços ===== -->
                    <StackPanel x:Name="SecaoEnderecos" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource TextoSecundario}"
                                   Text="Um endereço pode servir para vários usos: marque as finalidades em vez de cadastrá-lo de novo." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Enderecos, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:EnderecoFormulario">
                                    <Border Style="{StaticResource Cartao}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Descrição (ex.: Loja centro)" MaxLength="60"
                                                         Text="{x:Bind Descricao, Mode=TwoWay}" />
                                                <Button Grid.Column="1" Content="Remover" VerticalAlignment="Bottom"
                                                        Click="RemoverEndereco_Click" />
                                            </Grid>
                                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="150">
                                                <CheckBox Content="Principal" IsChecked="{x:Bind Principal, Mode=TwoWay}" />
                                                <CheckBox Content="Fiscal" IsChecked="{x:Bind Fiscal, Mode=TwoWay}" />
                                                <CheckBox Content="Cobrança" IsChecked="{x:Bind Cobranca, Mode=TwoWay}" />
                                                <CheckBox Content="Entrega" IsChecked="{x:Bind Entrega, Mode=TwoWay}" />
                                                <CheckBox Content="Correspondência" IsChecked="{x:Bind Correspondencia, Mode=TwoWay}" />
                                                <CheckBox Content="Residencial" IsChecked="{x:Bind Residencial, Mode=TwoWay}" />
                                                <CheckBox Content="Comercial" IsChecked="{x:Bind Comercial, Mode=TwoWay}" />
                                            </VariableSizedWrapGrid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="CEP" MaxLength="9" Text="{x:Bind Cep, Mode=TwoWay}" />
                                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BuscarCep_Click"
                                                        ToolTipService.ToolTip="Buscar endereço pelo CEP"
                                                        AutomationProperties.Name="Buscar endereço pelo CEP">
                                                    <SymbolIcon Symbol="Find" />
                                                </Button>
                                                <TextBox Grid.Column="2" Header="Logradouro *" MaxLength="150"
                                                         Text="{x:Bind Logradouro, Mode=TwoWay}" />
                                                <TextBox Grid.Column="3" Header="Número" MaxLength="10"
                                                         Text="{x:Bind Numero, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Complemento" MaxLength="60" Text="{x:Bind Complemento, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Header="Bairro" MaxLength="80" Text="{x:Bind Bairro, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Cidade *" MaxLength="80" Text="{x:Bind Cidade, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Header="UF" MaxLength="2" CharacterCasing="Upper"
                                                         Text="{x:Bind Uf, Mode=TwoWay}" />
                                                <TextBox Grid.Column="2" Header="Cód. IBGE" MaxLength="7"
                                                         Text="{x:Bind CodigoMunicipioIbge, Mode=TwoWay}" />
                                                <TextBox Grid.Column="3" Header="Cód. país" MaxLength="4"
                                                         Text="{x:Bind CodigoPais, Mode=TwoWay}" />
                                                <TextBox Grid.Column="4" Header="País" MaxLength="60" Text="{x:Bind Pais, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Adicionar endereço" Command="{x:Bind ViewModel.AdicionarEnderecoCommand}" />
                    </StackPanel>

                    <!-- ===== Contatos ===== -->
                    <StackPanel x:Name="SecaoContatos" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Telefones e e-mails" Style="{StaticResource TituloSecao}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.MeiosContato, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:MeioContatoFormulario">
                                    <Border Style="{StaticResource Cartao}" Padding="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Header="Tipo" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Bind vm:Opcoes.TiposContato}"
                                                      SelectedIndex="{x:Bind TipoIndice, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Header="Número ou e-mail *" MaxLength="150"
                                                     Text="{x:Bind Valor, Mode=TwoWay}" />
                                            <TextBox Grid.Column="2" Header="Descrição (ex.: Financeiro, NF-e)" MaxLength="80"
                                                     Text="{x:Bind Descricao, Mode=TwoWay}" />
                                            <ToggleSwitch Grid.Column="3" Header="Principal" OnContent="Sim" OffContent="Não"
                                                          MinWidth="0" IsOn="{x:Bind Principal, Mode=TwoWay}" />
                                            <CheckBox Grid.Column="4" Content="Aceita comunicação" VerticalAlignment="Bottom"
                                                      IsChecked="{x:Bind PermiteComunicacao, Mode=TwoWay}" />
                                            <Button Grid.Column="5" VerticalAlignment="Bottom" Click="RemoverMeio_Click"
                                                    ToolTipService.ToolTip="Remover" AutomationProperties.Name="Remover telefone ou e-mail">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Adicionar telefone ou e-mail" Command="{x:Bind ViewModel.AdicionarMeioCommand}" />

                        <TextBlock Text="Pessoas de contato" Style="{StaticResource TituloSecao}" Margin="0,16,0,0" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Contatos, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:ContatoPessoaFormulario">
                                    <Border Style="{StaticResource Cartao}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Nome *" MaxLength="100" Text="{x:Bind Nome, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Header="Cargo" MaxLength="60" Text="{x:Bind Cargo, Mode=TwoWay}" />
                                                <TextBox Grid.Column="2" Header="Departamento" MaxLength="60" Text="{x:Bind Departamento, Mode=TwoWay}" />
                                                <Button Grid.Column="3" Content="Remover" VerticalAlignment="Bottom"
                                                        Click="RemoverContatoPessoa_Click" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Telefone" MaxLength="20" Text="{x:Bind Telefone, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Header="Celular" MaxLength="20" Text="{x:Bind Celular, Mode=TwoWay}" />
                                                <CheckBox Grid.Column="2" Content="WhatsApp" VerticalAlignment="Bottom"
                                                          IsChecked="{x:Bind CelularWhatsApp, Mode=TwoWay}" />
                                                <TextBox Grid.Column="3" Header="E-mail" MaxLength="150" Text="{x:Bind Email, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Observações" MaxLength="500" Text="{x:Bind Observacoes, Mode=TwoWay}" />
                                                <CheckBox Grid.Column="1" Content="Contato principal" VerticalAlignment="Bottom"
                                                          IsChecked="{x:Bind Principal, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Adicionar pessoa de contato" Command="{x:Bind ViewModel.AdicionarContatoPessoaCommand}" />
                    </StackPanel>

                    <!-- ===== Documentos ===== -->
                    <StackPanel x:Name="SecaoDocumentos" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource TextoSecundario}"
                                   Text="CPF, CNPJ e inscrições ficam na aba Geral e nos estabelecimentos. Aqui vão os demais documentos." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Documentos, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:DocumentoFormulario">
                                    <Border Style="{StaticResource Cartao}" Padding="12">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ComboBox Header="Tipo" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Bind vm:Opcoes.TiposDocumento}"
                                                      SelectedIndex="{x:Bind TipoIndice, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Header="Número *" MaxLength="30" Text="{x:Bind Numero, Mode=TwoWay}" />
                                            <TextBox Grid.Column="2" Header="Órgão emissor" MaxLength="20" Text="{x:Bind OrgaoEmissor, Mode=TwoWay}" />
                                            <TextBox Grid.Column="3" Header="UF" MaxLength="2" CharacterCasing="Upper" Text="{x:Bind Uf, Mode=TwoWay}" />
                                            <Button Grid.Column="4" VerticalAlignment="Bottom" Click="RemoverDocumento_Click"
                                                    ToolTipService.ToolTip="Remover" AutomationProperties.Name="Remover documento">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                            <CalendarDatePicker Grid.Row="1" Header="Emissão" HorizontalAlignment="Stretch"
                                                                Date="{x:Bind EmitidoEm, Mode=TwoWay}" />
                                            <CalendarDatePicker Grid.Row="1" Grid.Column="1" Header="Validade" HorizontalAlignment="Left"
                                                                Date="{x:Bind ValidoAte, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Adicionar documento" Command="{x:Bind ViewModel.AdicionarDocumentoCommand}" />
                    </StackPanel>

                    <!-- ===== Cliente ===== -->
                    <StackPanel x:Name="SecaoCliente" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource TextoSecundario}"
                                   Text="Conta padrão: vale para todas as empresas do grupo. Contas por empresa e bloqueios chegam na etapa 7." />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Header="Limite de crédito (R$)" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind ViewModel.Formulario.ContaCliente.LimiteCredito, Mode=TwoWay}" />
                            <NumberBox Grid.Column="1" Header="Dias máx. de atraso" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind ViewModel.Formulario.ContaCliente.DiasMaximoAtraso, Mode=TwoWay}" />
                            <NumberBox Grid.Column="2" Header="Desconto máximo (%)" Minimum="0" Maximum="100" SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind ViewModel.Formulario.ContaCliente.DescontoMaximo, Mode=TwoWay}" />
                            <TextBox Grid.Column="3" Header="Condição de pagamento" MaxLength="60"
                                     Text="{x:Bind ViewModel.Formulario.ContaCliente.CondicaoPagamento, Mode=TwoWay}" />
                        </Grid>
                        <ToggleSwitch Header="Venda acima do limite exige aprovação" OnContent="Sim" OffContent="Não"
                                      IsOn="{x:Bind ViewModel.Formulario.ContaCliente.ExigeAprovacaoAcimaLimite, Mode=TwoWay}" />
                        <TextBox Header="Observações comerciais" MaxLength="1000" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80"
                                 Text="{x:Bind ViewModel.Formulario.ContaCliente.Observacoes, Mode=TwoWay}" />
                        <TextBlock Text="Bloqueios ativos" Style="{StaticResource TituloSecao}" />
                        <TextBlock Text="{x:Bind vm:Conversores.OuTraco(ViewModel.Formulario.TextoBloqueios), Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- ===== Fornecedor ===== -->
                    <StackPanel x:Name="SecaoFornecedor" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Condição de pagamento" MaxLength="60"
                                     Text="{x:Bind ViewModel.Formulario.ContaFornecedor.CondicaoPagamento, Mode=TwoWay}" />
                            <NumberBox Grid.Column="1" Header="Prazo médio (dias)" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind ViewModel.Formulario.ContaFornecedor.PrazoMedioDias, Mode=TwoWay}" />
                            <NumberBox Grid.Column="2" Header="Lead time (dias)" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind ViewModel.Formulario.ContaFornecedor.LeadTimeDias, Mode=TwoWay}" />
                            <NumberBox Grid.Column="3" Header="Avaliação (1 a 5)" Minimum="1" Maximum="5" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.Formulario.ContaFornecedor.Avaliacao, Mode=TwoWay}" />
                        </Grid>
                        <TextBox Header="Observações de compras" MaxLength="1000" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80"
                                 Text="{x:Bind ViewModel.Formulario.ContaFornecedor.Observacoes, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- ===== Histórico ===== -->
                    <StackPanel x:Name="SecaoHistorico" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Salve o cadastro para começar o histórico."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind vm:Conversores.VisivelSeZero(ViewModel.Formulario.Id), Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Historico}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pv:HistoricoItem">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Quando}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Descricao}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Salvar" Style="{StaticResource AccentButtonStyle}" MinWidth="110"
                        Command="{x:Bind ViewModel.SalvarCommand}" />
                <Button Content="Descartar alterações" Command="{x:Bind ViewModel.DescartarCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
