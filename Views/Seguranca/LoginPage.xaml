<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lone.Views.Seguranca.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Lone ERP" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Entre com o seu usuário."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.MensagemAberta, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.MensagemSeveridade, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Mensagem, Mode=OneWay}" />

            <TextBox x:Name="CampoLogin" Header="Login" MaxLength="60" IsSpellCheckEnabled="False"
                     Text="{x:Bind ViewModel.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox Header="Senha" KeyDown="Senha_KeyDown"
                         Password="{x:Bind ViewModel.Senha, Mode=TwoWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Entrar" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.EntrarCommand}" />
                <ProgressRing Grid.Column="1" Width="20" Height="20"
                              IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
