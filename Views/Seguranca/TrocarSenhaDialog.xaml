<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Lone.Views.Seguranca.TrocarSenhaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Trocar senha"
    PrimaryButtonText="Trocar senha"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Trocar_Click">

    <StackPanel Spacing="12" MinWidth="360">
        <TextBlock x:Name="AvisoObrigatorio" Visibility="Collapsed" TextWrapping="Wrap"
                   Text="Sua senha foi definida pelo administrador. Por segurança, escolha uma nova senha antes de continuar." />
        <InfoBar IsOpen="{x:Bind ViewModel.MensagemAberta, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MensagemSeveridade, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Mensagem, Mode=OneWay}" />
        <PasswordBox Header="Senha atual" Password="{x:Bind ViewModel.SenhaAtual, Mode=TwoWay}" />
        <PasswordBox Header="Nova senha" Password="{x:Bind ViewModel.NovaSenha, Mode=TwoWay}" />
        <PasswordBox Header="Confirme a nova senha" Password="{x:Bind ViewModel.Confirmacao, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind ViewModel.RegraSenha}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</ContentDialog>
