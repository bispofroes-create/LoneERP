<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lone.Views.Seguranca.PerfisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lone.ViewModels"
    xmlns:vms="using:Lone.ViewModels.Seguranca"
    xmlns:seg="using:Lone.Aplicacao.Seguranca">

    <Grid Padding="24,16,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Perfis" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.NovoCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Novo perfil" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListView x:Name="Lista" Grid.Row="1" SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.Itens}"
                      SelectedItem="{x:Bind ViewModel.Selecionado, Mode=OneWay}"
                      SelectionChanged="Lista_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="seg:PerfilResumo">
                        <StackPanel Padding="0,8">
                            <TextBlock Text="{x:Bind Nome}" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Detalhe}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Formulário -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Formulario.Titulo, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <InfoBar IsOpen="{x:Bind ViewModel.MensagemAberta, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.MensagemSeveridade, Mode=OneWay}"
                         Message="{x:Bind ViewModel.Mensagem, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left" Padding="0,0,16,16">
                    <TextBox Header="Nome *" MaxLength="60"
                             Text="{x:Bind ViewModel.Formulario.Nome, Mode=TwoWay}" />
                    <TextBox Header="Descrição" MaxLength="250"
                             Text="{x:Bind ViewModel.Formulario.Descricao, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="32">
                        <ToggleSwitch Header="Administrador (acesso total)" OnContent="Sim" OffContent="Não"
                                      IsOn="{x:Bind ViewModel.Formulario.Administrador, Mode=TwoWay}" />
                        <ToggleSwitch Header="Situação" OnContent="Ativo" OffContent="Inativo"
                                      IsOn="{x:Bind ViewModel.Formulario.Ativo, Mode=TwoWay}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Grupos, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.Formulario.PermissoesVisiveis, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vms:GrupoPermissoes">
                                <StackPanel Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Bind Modulo}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind Itens}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OpcaoMarcavel">
                                                <CheckBox Content="{x:Bind Texto}" IsChecked="{x:Bind Marcado, Mode=TwoWay}"
                                                          ToolTipService.ToolTip="{x:Bind Detalhe}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Salvar" Style="{StaticResource AccentButtonStyle}" MinWidth="110"
                        Command="{x:Bind ViewModel.SalvarCommand}" />
                <Button Content="Descartar alterações" Command="{x:Bind ViewModel.DescartarCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
