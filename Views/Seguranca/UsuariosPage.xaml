<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lone.Views.Seguranca.UsuariosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lone.ViewModels"
    xmlns:seg="using:Lone.Aplicacao.Seguranca"
    xmlns:segvm="using:Lone.ViewModels.Seguranca">

    <Grid Padding="24,16,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Usuários" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.NovoCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Novo usuário" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListView x:Name="Lista" Grid.Row="1" SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.Itens}"
                      SelectedItem="{x:Bind ViewModel.Selecionado, Mode=OneWay}"
                      SelectionChanged="Lista_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="seg:UsuarioResumo">
                        <StackPanel Padding="0,8">
                            <TextBlock Text="{x:Bind Nome}" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Detalhe}" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Formulário -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Formulario.Titulo, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <InfoBar IsOpen="{x:Bind ViewModel.MensagemAberta, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.MensagemSeveridade, Mode=OneWay}"
                         Message="{x:Bind ViewModel.Mensagem, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left" Padding="0,0,16,16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="Nome *" MaxLength="100"
                                 Text="{x:Bind ViewModel.Formulario.Nome, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="Login *" MaxLength="60" IsSpellCheckEnabled="False"
                                 Text="{x:Bind ViewModel.Formulario.Login, Mode=TwoWay}" />
                    </Grid>
                    <TextBox Header="E-mail" MaxLength="150"
                             Text="{x:Bind ViewModel.Formulario.Email, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="32">
                        <ToggleSwitch Header="Situação" OnContent="Ativo" OffContent="Inativo"
                                      IsOn="{x:Bind ViewModel.Formulario.Ativo, Mode=TwoWay}" />
                        <ToggleSwitch Header="Exigir troca de senha no próximo acesso" OnContent="Sim" OffContent="Não"
                                      IsOn="{x:Bind ViewModel.Formulario.DeveTrocarSenha, Mode=TwoWay}" />
                    </StackPanel>

                    <PasswordBox Header="{x:Bind ViewModel.Formulario.RotuloSenha, Mode=OneWay}" MaxWidth="360"
                                 HorizontalAlignment="Left" Width="360"
                                 Password="{x:Bind ViewModel.Formulario.NovaSenha, Mode=TwoWay}" />

                    <Grid ColumnSpacing="12" Visibility="{x:Bind vm:Conversores.VisivelSeFalso(ViewModel.Formulario.EhNovo), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Formulario.TextoAcesso, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1" Content="Desbloquear acesso"
                                Visibility="{x:Bind ViewModel.Formulario.Bloqueado, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DesbloquearCommand}" />
                    </Grid>

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Perfis *" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Cada perfil vale em todas as empresas ou só na empresa escolhida. O usuário vê as empresas em que tem algum perfil." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Formulario.Perfis, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="segvm:AtribuicaoPerfil">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Escolha o perfil"
                                              AutomationProperties.Name="Perfil"
                                              ItemsSource="{x:Bind Perfis}"
                                              SelectedIndex="{x:Bind PerfilIndice, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Empresa em que o perfil vale"
                                              ItemsSource="{x:Bind Empresas}"
                                              SelectedIndex="{x:Bind EmpresaIndice, Mode=TwoWay}" />
                                    <Button Grid.Column="2" Click="RemoverPerfil_Click"
                                            AutomationProperties.Name="Remover perfil" ToolTipService.ToolTip="Remover">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{x:Bind ViewModel.AdicionarPerfilCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Adicionar perfil" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Salvar" Style="{StaticResource AccentButtonStyle}" MinWidth="110"
                        Command="{x:Bind ViewModel.SalvarCommand}" />
                <Button Content="Descartar alterações" Command="{x:Bind ViewModel.DescartarCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
